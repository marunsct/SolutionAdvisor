{
  "name": "SolutionAdvisor",
  "version": "1.0.0",
  "description": "Solution Advisor",
  "dependencies": {
    "@cap-js/change-tracking": "^1.1.1",
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/http-client": "^4.1.2",
    "@sap-cloud-sdk/util": "^4.1.2",
    "@sap/cds": "^9",
    "@sap/low-code-event-handler": "^1.2.5",
    "@sap/xsenv": "^6.0.0",
    "@sap/xssec": "^4.10.0",
    "express": "^4",
    "hdb": "^2.26.1",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "node-cache": "^5.1.2",
    "nodemailer": "^7.0.10",
    "passport": "^0.7.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^0.4.0",
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "@sap/dev-cap-tools": "^1.47.10",
    "@types/jest": "^29.5.8",
    "cds-plugin-ui5": "^0.13.6",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  },
  "scripts": {
    "start": "cds-serve",
    "ui": "cd app && npm run start",
    "start-local": "npm run generate-entry-point && npm run cds-watch",
    "generate-entry-point": "dev-cap-tools gen-entrypoint",
    "watch": "cds watch --profile hybrid",
    "build": "mbt build",
    "deploy": "cf push mta_archives/SolutionAdvisor.mtar",
    "watch-solutionadvisor": "cds watch --open sd.solutionadvisor/index.html?sap-ui-xx-viewCache=false --livereload false",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=test/unit",
    "test:integration": "jest --testPathPattern=test/integration",
    "test:e2e": "node test/e2e/run-tests.js",
    "test:e2e:all": "node test/e2e/run-tests.js --suite all",
    "test:e2e:critical": "node test/e2e/run-tests.js --suite critical",
    "test:e2e:smoke": "node test/e2e/run-tests.js --suite smoke",
    "test:e2e:regression": "node test/e2e/run-tests.js --suite regression",
    "test:e2e:ci": "node test/e2e/run-tests.js --env ci --suite all",
    "test:e2e:local": "node test/e2e/run-tests.js --env local --headless false",
    "test:performance": "npm run test:db-benchmark && npm run test:load && npm run test:stress",
    "test:db-benchmark": "node test/performance/db-benchmark.js",
    "test:load": "k6 run test/performance/load-test.js",
    "test:stress": "k6 run test/performance/stress-test.js"
  },
  "private": true,
  "cds": {
    "requires": {
      "[production]": {
        "db": "hana",
        "auth": "xsuaa",
        "mail": {
          "kind": "smtp",
          "host": "${env:SMTP_HOST}",
          "port": "${env:SMTP_PORT}",
          "secure": false,
          "user": "${env:SMTP_USER}",
          "pass": "${env:SMTP_PASS}",
          "from": "${env:SMTP_FROM}"
        }
      },
      "[development]": {
        "mail": {
          "kind": "smtp",
          "host": "${env:SMTP_HOST}",
          "port": "${env:SMTP_PORT}",
          "secure": false,
          "user": "${env:SMTP_USER}",
          "pass": "${env:SMTP_PASS}",
          "from": "SAP Clean Core Advisor <noreply@cleancore.local>"
        }
      },
      "auth": {
        "[development]": {
          "kind": "dummy"
        },
        "[production]": {
          "kind": "xsuaa"
        }
      }
    }
  },
  "lcap": true,
  "workspaces": [
    "app/*"
  ]
}
