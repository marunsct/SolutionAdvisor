# SAP Clean Core Solution Advisor - Environment Variables
# Copy this file to .env and replace with actual values

# ============================================================================
# SMTP Email Configuration (for Email Notifications)
# ============================================================================

# SMTP Server Configuration
# Examples:
# - Gmail: smtp.gmail.com (port 587 with TLS)
# - SendGrid: smtp.sendgrid.net (port 587 with TLS)
# - Office365: smtp.office365.com (port 587 with TLS)
# - Corporate SMTP: mail.yourcompany.com (port 25, 465, or 587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# SMTP Authentication
# For Gmail: Use app-specific password (not your regular password)
# For SendGrid: Use 'apikey' as username and your API key as password
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-specific-password

# Sender Information
SMTP_FROM="SAP Solution Advisor <no-reply@example.com>"

# ============================================================================
# Encryption Configuration (for Field-Level Encryption)
# ============================================================================

# Enable/Disable Field-Level Encryption (true/false)
ENABLE_ENCRYPTION=false

# Master Encryption Key (AES-256)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this key SECRET and rotate every 90 days
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Key Version (for key rotation tracking)
ENCRYPTION_KEY_VERSION=v1

# ============================================================================
# BTP Credential Store Configuration
# ============================================================================

# Enable/Disable BTP Credential Store (true/false)
# When disabled, uses environment variables for all credentials
ENABLE_CREDENTIAL_STORE=false

# ============================================================================
# Security Configuration
# ============================================================================

# Rate Limiting
RATE_LIMIT_MAX=100

# Request Size Limit (in MB)
MAX_REQUEST_SIZE=10

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:4004,http://localhost:5000

# Block Suspicious Requests
BLOCK_SUSPICIOUS_REQUESTS=false

# ============================================================================
# SAP HANA Cloud Configuration (for Production Deployment)
# ============================================================================

# Database Connection (auto-configured in BTP Cloud Foundry)
# Only needed for local testing with HANA Cloud
# HANA_HOST=<your-hana-instance>.hana.prod-us10.hanacloud.ondemand.com
# HANA_PORT=443
# HANA_USER=DBADMIN
# HANA_PASSWORD=<your-password>

# ============================================================================
# XSUAA Configuration (for Authentication)
# ============================================================================

# UAA Service (auto-configured in BTP Cloud Foundry)
# Only needed for local testing
# XSUAA_URL=https://yoursubaccount.authentication.us10.hana.ondemand.com
# XSUAA_CLIENTID=<your-client-id>
# XSUAA_CLIENTSECRET=<your-client-secret>

# ============================================================================
# Application Configuration
# ============================================================================

# Node Environment
NODE_ENV=development

# Server Port (for local development)
PORT=4004

# Session Secret (for local session management)
SESSION_SECRET=change-this-to-a-random-string-in-production

# ============================================================================
# Feature Flags
# ============================================================================

# Enable/disable email notifications
ENABLE_EMAIL_NOTIFICATIONS=true

# Enable/disable push notifications (requires SAP Mobile Services)
ENABLE_PUSH_NOTIFICATIONS=false

# ============================================================================
# External Integrations (Future)
# ============================================================================

# SAP API Business Hub (for API metadata retrieval)
# API_HUB_URL=https://api.sap.com
# API_HUB_KEY=<your-api-key>

# SAP Cloud ALM (for technical debt tracking)
# CLOUD_ALM_URL=https://yoursubaccount.alm.cloud.sap
# CLOUD_ALM_TOKEN=<your-token>

# ============================================================================
# Logging Configuration
# ============================================================================

# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# Application Logging Service (auto-configured in BTP)
# SAP_CF_LOGGING=true
