{
  "_version": "1.76.0",
  "sap.app": {
    "id": "sd.solutionadvisor",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.19.1",
      "toolsId": "0988b1f9-f455-49c1-977b-443c7dce473a"
    },
    "dataSources": {
      "mainService": {
        "uri": "/service/SolutionAdvisorSvcs/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      },
      "adminService": {
        "uri": "/service/AdminSvcs/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "SolutionAdvisor-wizard": {
          "semanticObject": "SolutionAdvisor",
          "action": "wizard",
          "title": "Start New Analysis",
          "subTitle": "Create Clean Core Analysis",
          "icon": "sap-icon://action",
          "signature": {
            "parameters": {
              "projectId": {
                "required": false,
                "filter": {
                  "value": "{projectId}",
                  "format": "plain"
                }
              },
              "sessionId": {
                "required": false,
                "filter": {
                  "value": "{sessionId}",
                  "format": "plain"
                }
              },
              "analysisId": {
                "required": false,
                "filter": {
                  "value": "{analysisId}",
                  "format": "plain"
                }
              }
            },
            "additionalParameters": "allowed"
          }
        },
        "SolutionAdvisor-projects": {
          "semanticObject": "SolutionAdvisor",
          "action": "projects",
          "title": "My Projects",
          "subTitle": "S/4HANA Implementation Projects",
          "icon": "sap-icon://folder",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        },
        "SolutionAdvisor-analytics": {
          "semanticObject": "SolutionAdvisor",
          "action": "analytics",
          "title": "Analytics Dashboard",
          "subTitle": "Clean Core Metrics & Trends",
          "icon": "sap-icon://bar-chart",
          "signature": {
            "parameters": {
              "projectId": {
                "required": false,
                "filter": {
                  "value": "{projectId}",
                  "format": "plain"
                }
              },
              "dateFrom": {
                "required": false
              },
              "dateTo": {
                "required": false
              }
            },
            "additionalParameters": "allowed"
          }
        },
        "SolutionAdvisor-analyses": {
          "semanticObject": "SolutionAdvisor",
          "action": "analyses",
          "title": "All Analyses",
          "subTitle": "RICEFW Object Analyses",
          "icon": "sap-icon://list",
          "signature": {
            "parameters": {
              "projectId": {
                "required": false,
                "filter": {
                  "value": "{projectId}",
                  "format": "plain"
                }
              },
              "status": {
                "required": false,
                "filter": {
                  "value": "{status}",
                  "format": "plain"
                }
              },
              "level": {
                "required": false,
                "filter": {
                  "value": "{level}",
                  "format": "plain"
                }
              }
            },
            "additionalParameters": "allowed"
          }
        },
        "SolutionAdvisor-admin": {
          "semanticObject": "SolutionAdvisor",
          "action": "admin",
          "title": "Administration",
          "subTitle": "Master Data & Configuration",
          "icon": "sap-icon://settings",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.141.2",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.table": {},
        "sap.ui.layout": {},
        "sap.f": {},
        "sap.ushell": {},
        "sap.viz": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "sd.solutionadvisor.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true,
          "groupId": "$auto",
          "updateGroupId": "$auto",
          "synchronizationMode": "None"
        }
      },
      "admin": {
        "dataSource": "adminService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": false,
          "earlyRequests": false,
          "groupId": "$auto",
          "updateGroupId": "$direct",
          "synchronizationMode": "None"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "sd.solutionadvisor.view",
        "async": true,
        "viewPath": "sd.solutionadvisor.view"
      },
      "routes": [
        {
          "name": "ProjectsList",
          "pattern": "",
          "target": [
            "ProjectsList"
          ]
        },
        {
          "name": "ProjectDetails",
          "pattern": "Projects({key}):?query:",
          "target": [
            "ProjectDetails"
          ]
        },
        {
          "name": "AnalysesList",
          "pattern": "Analyses/:projectId:/:projectName:",
          "target": [
            "AnalysesList"
          ]
        },
        {
          "name": "AnalysisDetails",
          "pattern": "Analyses({key})",
          "target": [
            "AnalysisDetails"
          ]
        },
        {
          "name": "Wizard",
          "pattern": "Wizard/:projectId:/:sessionId:/:analysisId:",
          "target": [
            "Wizard"
          ]
        },
        {
          "name": "AnalyticsDashboard",
          "pattern": "analytics",
          "target": [
            "AnalyticsDashboard"
          ]
        },
        {
          "name": "Admin",
          "pattern": "admin",
          "target": [
            "Admin"
          ]
        },
        {
          "name": "AdminQuestionFlow",
          "pattern": "admin/questionflow",
          "target": [
            "AdminQuestionFlow"
          ]
        },
        {
          "name": "AdminPerformanceThreshold",
          "pattern": "admin/thresholds",
          "target": [
            "AdminPerformanceThreshold"
          ]
        },
        {
          "name": "AdminRealWorldExample",
          "pattern": "admin/examples",
          "target": [
            "AdminRealWorldExample"
          ]
        },
        {
          "name": "AdminCleanCoreLevels",
          "pattern": "admin/levels",
          "target": [
            "AdminCleanCoreLevels"
          ]
        },
        {
          "name": "AdminObjectTypes",
          "pattern": "admin/objecttypes",
          "target": [
            "AdminObjectTypes"
          ]
        }
      ],
      "targets": {
        "ProjectsList": {
          "id": "ProjectsList",
          "name": "ProjectsList",
          "title": "Projects"
        },
        "ProjectDetails": {
          "id": "ProjectDetails",
          "name": "ProjectDetails",
          "title": "Project Details"
        },
        "AnalysesList": {
          "id": "AnalysesList",
          "name": "AnalysesList",
          "title": "Clean Core Analyses"
        },
        "AnalysisDetails": {
          "id": "AnalysisDetails",
          "name": "AnalysisDetails",
          "title": "Analysis Details"
        },
        "Wizard": {
          "id": "Wizard",
          "name": "Wizard",
          "title": "New Analysis Wizard"
        },
        "AnalyticsDashboard": {
          "id": "AnalyticsDashboard",
          "name": "AnalyticsDashboard",
          "title": "Analytics Dashboard"
        },
        "Admin": {
          "id": "Admin",
          "name": "Admin",
          "title": "Administration Panel"
        },
        "AdminQuestionFlow": {
          "id": "AdminQuestionFlow",
          "name": "AdminQuestionFlow",
          "title": "Question Flow Maintenance"
        },
        "AdminPerformanceThreshold": {
          "id": "AdminPerformanceThreshold",
          "name": "AdminPerformanceThreshold",
          "title": "Performance Threshold Maintenance"
        },
        "AdminRealWorldExample": {
          "id": "AdminRealWorldExample",
          "name": "AdminRealWorldExample",
          "title": "Real-World Example Maintenance"
        },
        "AdminCleanCoreLevels": {
          "id": "AdminCleanCoreLevels",
          "name": "AdminCleanCoreLevels",
          "title": "Clean Core Levels Maintenance"
        },
        "AdminObjectTypes": {
          "id": "AdminObjectTypes",
          "name": "AdminObjectTypes",
          "title": "Object Types Maintenance"
        }
      }
    },
    "rootView": {
      "viewName": "sd.solutionadvisor.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "SolutionAdvisor"
  }
}
