{
  "_version": "1.76.0",
  "sap.app": {
    "id": "sd.solutionadvisor",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.19.1",
      "toolsId": "0988b1f9-f455-49c1-977b-443c7dce473a"
    },
    "dataSources": {
      "mainService": {
        "uri": "/service/SolutionAdvisorSvcs/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "undefined-undefined": {
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        },
        "solitionadvisor-display": {
          "semanticObject": "solitionadvisor",
          "action": "display",
          "title": "{{solitionadvisor-display.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.141.2",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.table": {},
        "sap.ui.layout": {},
        "sap.f": {},
        "sap.ushell": {},
        "sap.viz": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "sd.solutionadvisor.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "sd.solutionadvisor.view",
        "async": true,
        "viewPath": "sd.solutionadvisor.view"
      },
      "routes": [
        {
          "name": "ProjectsList",
          "pattern": "",
          "target": [
            "ProjectsList"
          ]
        },
        {
          "name": "ProjectDetails",
          "pattern": "Projects({key})",
          "target": [
            "ProjectDetails"
          ]
        },
        {
          "name": "AnalysesList",
          "pattern": "Analyses/:projectId:/:projectName:",
          "target": [
            "AnalysesList"
          ]
        },
        {
          "name": "AnalysisDetails",
          "pattern": "Analyses({key})",
          "target": [
            "AnalysisDetails"
          ]
        },
        {
          "name": "Wizard",
          "pattern": "Wizard/:projectId:/:sessionId:",
          "target": [
            "Wizard"
          ]
        },
        {
          "name": "AnalyticsDashboard",
          "pattern": "analytics",
          "target": [
            "AnalyticsDashboard"
          ]
        },
        {
          "name": "Admin",
          "pattern": "admin",
          "target": [
            "Admin"
          ]
        },
        {
          "name": "AdminQuestionFlow",
          "pattern": "admin/questionflow",
          "target": [
            "AdminQuestionFlow"
          ]
        },
        {
          "name": "AdminPerformanceThreshold",
          "pattern": "admin/thresholds",
          "target": [
            "AdminPerformanceThreshold"
          ]
        },
        {
          "name": "AdminRealWorldExample",
          "pattern": "admin/examples",
          "target": [
            "AdminRealWorldExample"
          ]
        },
        {
          "name": "AdminCleanCoreLevels",
          "pattern": "admin/levels",
          "target": [
            "AdminCleanCoreLevels"
          ]
        },
        {
          "name": "AdminObjectTypes",
          "pattern": "admin/objecttypes",
          "target": [
            "AdminObjectTypes"
          ]
        }
      ],
      "targets": {
        "ProjectsList": {
          "id": "ProjectsList",
          "name": "ProjectsList",
          "title": "Projects"
        },
        "ProjectDetails": {
          "id": "ProjectDetails",
          "name": "ProjectDetails",
          "title": "Project Details"
        },
        "AnalysesList": {
          "id": "AnalysesList",
          "name": "AnalysesList",
          "title": "Clean Core Analyses"
        },
        "AnalysisDetails": {
          "id": "AnalysisDetails",
          "name": "AnalysisDetails",
          "title": "Analysis Details"
        },
        "Wizard": {
          "id": "Wizard",
          "name": "Wizard",
          "title": "New Analysis Wizard"
        },
        "AnalyticsDashboard": {
          "id": "AnalyticsDashboard",
          "name": "AnalyticsDashboard",
          "title": "Analytics Dashboard"
        },
        "Admin": {
          "id": "Admin",
          "name": "Admin",
          "title": "Administration Panel"
        },
        "AdminQuestionFlow": {
          "id": "AdminQuestionFlow",
          "name": "AdminQuestionFlow",
          "title": "Question Flow Maintenance"
        },
        "AdminPerformanceThreshold": {
          "id": "AdminPerformanceThreshold",
          "name": "AdminPerformanceThreshold",
          "title": "Performance Threshold Maintenance"
        },
        "AdminRealWorldExample": {
          "id": "AdminRealWorldExample",
          "name": "AdminRealWorldExample",
          "title": "Real-World Example Maintenance"
        },
        "AdminCleanCoreLevels": {
          "id": "AdminCleanCoreLevels",
          "name": "AdminCleanCoreLevels",
          "title": "Clean Core Levels Maintenance"
        },
        "AdminObjectTypes": {
          "id": "AdminObjectTypes",
          "name": "AdminObjectTypes",
          "title": "Object Types Maintenance"
        }
      }
    },
    "rootView": {
      "viewName": "sd.solutionadvisor.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
