<mvc:View
    controllerName="sd.solutionadvisor.controller.AdminPerformanceThreshold"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:unified="sap.ui.unified"
    displayBlock="true">
    
    <Page
        id="adminPerformanceThresholdPage"
        title="Performance Threshold Maintenance"
        showNavButton="true"
        navButtonPress="onNavBack"
        class="sapUiResponsiveContentPadding">
        
        <headerContent>
            <Button
                id="createThresholdButton"
                text="Create"
                icon="sap-icon://create"
                type="Emphasized"
                press="onCreate"
                tooltip="Create new threshold"/>
            <Button
                id="exportThresholdButton"
                text="Export"
                icon="sap-icon://excel-attachment"
                press="onExport"
                tooltip="Export all thresholds to Excel"/>
            <unified:FileUploader
                id="thresholdFileUploader"
                name="massUpload"
                buttonText="Mass Upload"
                icon="sap-icon://upload"
                uploadOnChange="false"
                change="onMassUpload"
                fileType="xlsx"
                mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                tooltip="Upload Excel file with thresholds"/>
            <SearchField
                id="searchThresholdField"
                width="300px"
                search="onSearch"
                placeholder="Search thresholds..."/>
        </headerContent>
        
        <content>
            <VBox id="adminThresholdContentVBox" class="sapUiSmallMargin">
                
                <!-- Filter Bar -->
                <Panel id="thresholdFilterPanel" headerText="Filters" expandable="true" expanded="false" class="sapUiSmallMarginBottom">
                    <content>
                        <FlexBox id="thresholdFilterFlexBox" wrap="Wrap" class="sapUiSmallMargin">
                            <ComboBox
                                id="objectTypeFilterThreshold"
                                placeholder="Filter by Object Type"
                                width="200px"
                                selectionChange="onFilterChange"
                                class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                <items>
                                    <core:Item id="thresholdAllTypesItem" key="" text="All Types"/>
                                    <core:Item id="thresholdReportsItem" key="R" text="Reports"/>
                                    <core:Item id="thresholdInterfacesItem" key="I" text="Interfaces"/>
                                    <core:Item id="thresholdConversionsItem" key="C" text="Conversions"/>
                                    <core:Item id="thresholdEnhancementsItem" key="E" text="Enhancements"/>
                                    <core:Item id="thresholdFormsItem" key="F" text="Forms"/>
                                    <core:Item id="thresholdWorkflowsItem" key="W" text="Workflows"/>
                                </items>
                            </ComboBox>
                            <ComboBox
                                id="categoryFilterThreshold"
                                placeholder="Filter by Category"
                                width="200px"
                                selectionChange="onFilterChange"
                                class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                <items>
                                    <core:Item id="thresholdAllCategoriesItem" key="" text="All Categories"/>
                                    <core:Item id="thresholdPerformanceItem" key="Performance" text="Performance"/>
                                    <core:Item id="thresholdSecurityItem" key="Security" text="Security"/>
                                    <core:Item id="thresholdComplianceItem" key="Compliance" text="Compliance"/>
                                    <core:Item id="thresholdCloudItem" key="Cloud" text="Cloud"/>
                                    <core:Item id="thresholdIntegrationItem" key="Integration" text="Integration"/>
                                </items>
                            </ComboBox>
                            <Switch
                                id="activeOnlySwitch"
                                state="true"
                                customTextOn="Active Only"
                                customTextOff="Show All"
                                change="onFilterChange"
                                class="sapUiTinyMarginEnd"/>
                            <Button
                                id="clearThresholdFiltersButton"
                                text="Clear Filters"
                                press="onClearFilters"/>
                        </FlexBox>
                    </content>
                </Panel>
                
                <!-- Record Count -->
                <FlexBox id="thresholdHeaderFlexBox" justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom">
                    <Title id="thresholdTitle" text="Performance Thresholds" level="H3"/>
                    <Text id="thresholdRecordCount" text="{viewModel>/recordCount} records"/>
                </FlexBox>
                
                <!-- Threshold Table -->
                <Table
                    id="thresholdTable"
                    items="{
                        path: 'admin>/PerformanceThreshold',
                        parameters: {
                            $count: true
                        }
                    }"
                    mode="MultiSelect"
                    growing="true"
                    growingThreshold="20"
                    busy="{viewModel>/busy}"
                    noDataText="No thresholds found. Click Create to add new thresholds.">
                    
                    <columns>
                        <Column id="thresholdCategoryColumn" width="12%">
                            <Text id="thresholdCategoryHeader" text="Category"/>
                        </Column>
                        <Column id="thresholdMethodColumn" width="12%">
                            <Text id="thresholdMethodHeader" text="Method"/>
                        </Column>
                        <Column id="thresholdVolumeLimitColumn" width="12%">
                            <Text id="thresholdVolumeLimitHeader" text="Volume Limit"/>
                        </Column>
                        <Column id="thresholdRespTimeColumn" width="12%">
                            <Text id="thresholdRespTimeHeader" text="Response Time"/>
                        </Column>
                        <Column id="thresholdConcurrencyColumn" width="12%">
                            <Text id="thresholdConcurrencyHeader" text="Concurrency"/>
                        </Column>
                        <Column id="thresholdCleanCoreLevelColumn" width="10%">
                            <Text id="thresholdCleanCoreLevelHeader" text="Level"/>
                        </Column>
                        <Column id="thresholdObjectTypesColumn" width="18%">
                            <Text id="thresholdObjectTypesHeader" text="Object Types"/>
                        </Column>
                        <Column id="thresholdActiveColumn" width="6%">
                            <Text id="thresholdActiveHeader" text="Active"/>
                        </Column>
                        <Column id="thresholdModifiedColumn" width="10%">
                            <Text id="thresholdModifiedHeader" text="Modified"/>
                        </Column>
                        <Column id="thresholdActionsColumn" width="6%" hAlign="End">
                            <Text id="thresholdActionsHeader" text="Actions"/>
                        </Column>
                    </columns>
                    
                    <items>
                        <ColumnListItem id="thresholdItem" type="Active" press="onItemPress">
                            <cells>
                                <Text id="thresholdCategoryText" text="{admin>category}"/>
                                <Text id="thresholdMethodText" text="{admin>method}"/>
                                <Text id="thresholdVolumeLimitText" text="{admin>volumeLimit}"/>
                                <Text id="thresholdRespTimeText" text="{admin>responseTimeTarget}"/>
                                <Text id="thresholdConcurrencyText" text="{admin>concurrencyLimit}"/>
                                <ObjectStatus id="thresholdLevelStatus" text="{admin>cleanCoreLevel}"
                                    state="{= ${admin>cleanCoreLevel} === 'A' ? 'Success' : ${admin>cleanCoreLevel} === 'B' ? 'Information' : ${admin>cleanCoreLevel} === 'C' ? 'Warning' : 'Error' }"/>
                                <Text id="thresholdObjectTypesText" text="{admin>applicableObjectTypes}"/>
                                <Switch
                                    id="thresholdActiveSwitch"
                                    state="{admin>isActive}"
                                    enabled="false"/>
                                <Text id="thresholdModifiedAtText" text="{path: 'admin>modifiedAt', formatter: '.formatTimestamp'}"/>
                                <HBox id="thresholdActionsHBox">
                                    <Button
                                        id="editThresholdButton"
                                        icon="sap-icon://edit"
                                        type="Transparent"
                                        press="onEdit"
                                        tooltip="Edit"/>
                                    <Button
                                        id="deleteThresholdButton"
                                        icon="sap-icon://delete"
                                        type="Transparent"
                                        press="onDelete"
                                        tooltip="Delete"/>
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
                
            </VBox>
        </content>
    </Page>
</mvc:View>
