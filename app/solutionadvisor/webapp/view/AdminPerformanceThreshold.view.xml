<mvc:View
    controllerName="sd.solutionadvisor.controller.AdminPerformanceThreshold"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">
    
    <Page
        id="adminPerformanceThresholdPage"
        title="Performance Threshold Maintenance"
        showNavButton="true"
        navButtonPress="onNavBack"
        class="sapUiResponsiveContentPadding">
        
        <headerContent>
            <Button
                id="createThresholdButton"
                text="Create"
                icon="sap-icon://create"
                type="Emphasized"
                press="onCreate"
                tooltip="Create new threshold"/>
            <Button
                id="exportThresholdButton"
                text="Export"
                icon="sap-icon://excel-attachment"
                press="onExport"
                tooltip="Export all thresholds to Excel"/>
            <FileUploader
                id="thresholdFileUploader"
                name="massUpload"
                buttonText="Mass Upload"
                icon="sap-icon://upload"
                uploadOnChange="false"
                change="onMassUpload"
                fileType="xlsx"
                mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                tooltip="Upload Excel file with thresholds"/>
            <SearchField
                id="searchThresholdField"
                width="300px"
                search="onSearch"
                placeholder="Search thresholds..."/>
        </headerContent>
        
        <content>
            <VBox class="sapUiSmallMargin">
                
                <!-- Filter Bar -->
                <Panel headerText="Filters" expandable="true" expanded="false" class="sapUiSmallMarginBottom">
                    <content>
                        <FlexBox wrap="Wrap" class="sapUiSmallMargin">
                            <ComboBox
                                id="objectTypeFilterThreshold"
                                placeholder="Filter by Object Type"
                                width="200px"
                                selectionChange="onFilterChange"
                                class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                <items>
                                    <core:Item key="" text="All Types"/>
                                    <core:Item key="R" text="Reports"/>
                                    <core:Item key="I" text="Interfaces"/>
                                    <core:Item key="C" text="Conversions"/>
                                    <core:Item key="E" text="Enhancements"/>
                                    <core:Item key="F" text="Forms"/>
                                    <core:Item key="W" text="Workflows"/>
                                </items>
                            </ComboBox>
                            <ComboBox
                                id="categoryFilterThreshold"
                                placeholder="Filter by Category"
                                width="200px"
                                selectionChange="onFilterChange"
                                class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                <items>
                                    <core:Item key="" text="All Categories"/>
                                    <core:Item key="Performance" text="Performance"/>
                                    <core:Item key="Security" text="Security"/>
                                    <core:Item key="Compliance" text="Compliance"/>
                                    <core:Item key="Cloud" text="Cloud"/>
                                    <core:Item key="Integration" text="Integration"/>
                                </items>
                            </ComboBox>
                            <Switch
                                id="activeOnlySwitch"
                                state="true"
                                customTextOn="Active Only"
                                customTextOff="Show All"
                                change="onFilterChange"
                                class="sapUiTinyMarginEnd"/>
                            <Button
                                text="Clear Filters"
                                press="onClearFilters"/>
                        </FlexBox>
                    </content>
                </Panel>
                
                <!-- Record Count -->
                <FlexBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom">
                    <Title text="Performance Thresholds" level="H3"/>
                    <Text text="{viewModel>/recordCount} records"/>
                </FlexBox>
                
                <!-- Threshold Table -->
                <Table
                    id="thresholdTable"
                    items="{/PerformanceThreshold}"
                    mode="MultiSelect"
                    growing="true"
                    growingThreshold="20"
                    busy="{viewModel>/busy}"
                    noDataText="No thresholds found. Click Create to add new thresholds.">
                    
                    <columns>
                        <Column width="20%">
                            <Text text="Threshold Name"/>
                        </Column>
                        <Column width="15%">
                            <Text text="Category"/>
                        </Column>
                        <Column width="10%">
                            <Text text="Value"/>
                        </Column>
                        <Column width="8%">
                            <Text text="Unit"/>
                        </Column>
                        <Column width="15%">
                            <Text text="Object Types"/>
                        </Column>
                        <Column width="8%">
                            <Text text="Severity"/>
                        </Column>
                        <Column width="8%">
                            <Text text="Active"/>
                        </Column>
                        <Column width="10%">
                            <Text text="Modified"/>
                        </Column>
                        <Column width="6%" hAlign="End">
                            <Text text="Actions"/>
                        </Column>
                    </columns>
                    
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{name}"/>
                                <Text text="{category}"/>
                                <Text text="{value}"/>
                                <Text text="{unit}"/>
                                <Text text="{applicableObjectTypes}"/>
                                <ObjectStatus
                                    text="{severity}"
                                    state="{= ${severity} === 'Critical' ? 'Error' : ${severity} === 'Warning' ? 'Warning' : 'Success' }"/>
                                <Switch
                                    state="{isActive}"
                                    enabled="false"/>
                                <Text text="{path: 'modifiedAt', type: 'sap.ui.model.type.DateTime', formatOptions: {pattern: 'yyyy-MM-dd'}}"/>
                                <HBox>
                                    <Button
                                        icon="sap-icon://edit"
                                        type="Transparent"
                                        press="onEdit"
                                        tooltip="Edit"/>
                                    <Button
                                        icon="sap-icon://delete"
                                        type="Transparent"
                                        press="onDelete"
                                        tooltip="Delete"/>
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
                
            </VBox>
        </content>
    </Page>
</mvc:View>
