<mvc:View
    controllerName="sd.solutionadvisor.controller.ProjectsList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f">
    <Page
        id="projectsListPage"
        title="{i18n>projectsListTitle}"
        showHeader="true">
        <headerContent>
            <Button
                id="projectsAnalyticsButton"
                text="{i18n>viewAnalytics}"
                icon="sap-icon://sales-quote"
                press="onNavigateToAnalytics"
                tooltip="Open the analytics dashboard"
                type="Emphasized"/>
            <Button
                id="adminButton"
                text="{i18n>adminPanel}"
                icon="sap-icon://settings"
                press="onNavigateToAdmin"
                tooltip="Master Data Maintenance"
                visible="{viewModel>/isAdmin}"/>
        </headerContent>
        <content>
            <VBox id="projectsListVBox" class="sapUiSmallMargin">
                <MessageStrip
                    id="projectsListHelpMessage"
                    text="{i18n>projectsListHelpMsg}"
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"/>
                <HeaderContainer
                    id="projectsHeaderContainer"
                    orientation="Horizontal"
                    backgroundDesign="Transparent">
                    <GenericTile
                        id="totalProjectsTile"
                        class="sapUiTinyMarginBegin sapUiTinyMarginTop"
                        header="{i18n>projectsTotal}"
                        subheader="{i18n>projectsAllSubheader}"
                        press="onTilePress">
                        <TileContent id="totalProjectsTileContent">
                            <NumericContent
                                id="totalProjectsNumeric"
                                value="{viewModel>/projectsCount}"
                                icon="sap-icon://product"
                                withMargin="false"/>
                        </TileContent>
                    </GenericTile>
                    <GenericTile
                        id="activeProjectsTile"
                        class="sapUiTinyMarginBegin sapUiTinyMarginTop"
                        header="{i18n>projectsActive}"
                        subheader="{i18n>projectsInProgressSubheader}"
                        press="onTilePress">
                        <TileContent id="activeProjectsTileContent">
                            <NumericContent
                                id="activeProjectsNumeric"
                                value="{viewModel>/activeProjectsCount}"
                                icon="sap-icon://activity-individual"
                                valueColor="Good"
                                withMargin="false"/>
                        </TileContent>
                    </GenericTile>
                </HeaderContainer>
                
                <Table
                    id="projectsTable"
                    items="{
                        path: '/Projects',
                        sorter: {
                            path: 'modifiedAt',
                            descending: true
                        }
                    }"
                    mode="SingleSelectLeft"
                    selectionChange="onSelectionChange"
                    growing="true"
                    growingThreshold="20"
                    growingScrollToLoad="true"
                    sticky="ColumnHeaders,HeaderToolbar"
                    ariaLabelledBy="projectsTableTitle"
                    noDataText="{i18n>projectsNoData}">
                    <headerToolbar>
                        <OverflowToolbar id="projectsTableToolbar">
                            <Title id="projectsTableTitle" text="{i18n>projectsListTitle}" level="H2"/>
                            <ToolbarSpacer id="projectsTableToolbarSpacer"/>
                            <SearchField
                                id="projectsSearchField"
                                width="200px"
                                search="onSearch"
                                tooltip="Search by client name or project name"
                                placeholder="{i18n>projectsSearchPlaceholder}"/>
                            <Button
                                id="viewProjectAnalysesButton"
                                text="{i18n>btnViewAnalyses}"
                                icon="sap-icon://activities"
                                press="onViewProjectAnalyses"
                                enabled="{viewModel>/hasSelection}"
                                tooltip="Open analyses for the selected project"
                                type="Transparent"/>
                            <Button
                                id="editProjectButton"
                                text="{i18n>btnOpenProject}"
                                icon="sap-icon://navigation-right-arrow"
                                press="onEditProject"
                                enabled="{viewModel>/hasSelection}"
                                tooltip="Open the selected project details"
                                visible="{viewModel>/isAdmin}"/>
                            <Button
                                id="deleteProjectButton"
                                text="{i18n>btnDeleteProject}"
                                icon="sap-icon://delete"
                                press="onDeleteProject"
                                enabled="{viewModel>/hasSelection}"
                                tooltip="Delete the selected project"
                                visible="{viewModel>/isAdmin}"
                                type="Reject"/>
                            <Button
                                id="newProjectButton"
                                text="{i18n>btnNewProject}"
                                icon="sap-icon://create"
                                type="Emphasized"
                                tooltip="Create a new project"
                                press="onCreateProject"/>
                            <Button
                                id="viewAllAnalysesButton"
                                text="{i18n>btnViewAllAnalyses}"
                                icon="sap-icon://activities"
                                tooltip="Open the full analyses list across all projects"
                                press="onViewAllAnalyses"/>
                        </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                        <Column id="clientNameColumn">
                            <Text id="clientNameHeader" text="{i18n>clientName}"/>
                        </Column>
                        <Column id="projectNameColumn">
                            <Text id="projectNameHeader" text="{i18n>projectName}"/>
                        </Column>
                        <Column id="projectTypeColumn" demandPopin="true" minScreenWidth="Tablet">
                            <Text id="projectTypeHeader" text="{i18n>projectType}"/>
                        </Column>
                        <Column id="s4FlavorColumn" demandPopin="true" minScreenWidth="Desktop">
                            <Text id="s4FlavorHeader" text="{i18n>colS4Flavor}"/>
                        </Column>
                        <Column id="statusColumn">
                            <Text id="statusHeader" text="{i18n>colStatus}"/>
                        </Column>
                        <Column id="timelineColumn" demandPopin="true" minScreenWidth="Desktop">
                            <Text id="timelineHeader" text="{i18n>colTimeline}"/>
                        </Column>
                        <Column id="businessCriticalityColumn" demandPopin="true" minScreenWidth="Desktop">
                            <Text id="businessCriticalityHeader" text="{i18n>colBusinessCriticality}"/>
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem id="projectsTableItem" type="Navigation" press="onProjectSelect">
                            <cells>
                                <ObjectIdentifier id="clientNameCell" title="{clientName}"/>
                                <Text id="projectNameCell" text="{projectName}"/>
                                <Text id="projectTypeCell" text="{projectType}"/>
                                <Text id="s4FlavorCell" text="{s4HanaFlavor}"/>
                                <ObjectStatus
                                    id="statusCell"
                                    text="{status}"
                                    state="{= ${status} === 'Active' ? 'Success' : ${status} === 'Completed' ? 'Information' : 'None' }"/>
                                <Text id="timelineCell" text="{path: 'timeline', type: 'sd.solutionadvisor.types.FlexibleDateTime', formatOptions: {pattern: 'yyyy-MM-dd'}}"/>
                                <Text id="businessCriticalityCell" text="{businessCriticality}"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
    </Page>
</mvc:View>