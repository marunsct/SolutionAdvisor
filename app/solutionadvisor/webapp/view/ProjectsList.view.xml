<mvc:View
    controllerName="sd.solutionadvisor.controller.ProjectsList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f">
    <Page
        id="projectsListPage"
        title="Projects"
        showHeader="true">
        <headerContent>
            <Button
                id="projectsAnalyticsButton"
                text="Analytics Dashboard"
                icon="sap-icon://sales-quote"
                press="onNavigateToAnalytics"
                type="Emphasized"/>
        </headerContent>
        <content>
            <VBox id="projectsListVBox" class="sapUiSmallMargin">
                <HeaderContainer
                    id="projectsHeaderContainer"
                    orientation="Horizontal"
                    backgroundDesign="Transparent">
                    <GenericTile
                        id="totalProjectsTile"
                        class="sapUiTinyMarginBegin sapUiTinyMarginTop"
                        header="Total Projects"
                        subheader="All Projects"
                        press="onTilePress">
                        <TileContent id="totalProjectsTileContent">
                            <NumericContent
                                id="totalProjectsNumeric"
                                value="{viewModel>/projectsCount}"
                                icon="sap-icon://product"
                                withMargin="false"/>
                        </TileContent>
                    </GenericTile>
                    <GenericTile
                        id="activeProjectsTile"
                        class="sapUiTinyMarginBegin sapUiTinyMarginTop"
                        header="Active Projects"
                        subheader="In Progress"
                        press="onTilePress">
                        <TileContent id="activeProjectsTileContent">
                            <NumericContent
                                id="activeProjectsNumeric"
                                value="{viewModel>/activeProjectsCount}"
                                icon="sap-icon://activity-individual"
                                valueColor="Good"
                                withMargin="false"/>
                        </TileContent>
                    </GenericTile>
                </HeaderContainer>
                
                <Table
                    id="projectsTable"
                    items="{
                        path: '/Projects',
                        sorter: {
                            path: 'modifiedAt',
                            descending: true
                        }
                    }"
                    mode="SingleSelectLeft"
                    selectionChange="onSelectionChange"
                    growing="true"
                    growingThreshold="20">
                    <headerToolbar>
                        <OverflowToolbar id="projectsTableToolbar">
                            <Title id="projectsTableTitle" text="Projects" level="H2"/>
                            <ToolbarSpacer id="projectsTableToolbarSpacer"/>
                            <SearchField
                                id="projectsSearchField"
                                width="200px"
                                search="onSearch"
                                placeholder="Search projects..."/>
                            <Button
                                id="viewProjectAnalysesButton"
                                text="View Analyses"
                                icon="sap-icon://activities"
                                press="onViewProjectAnalyses"
                                enabled="{viewModel>/hasSelection}"
                                type="Transparent"/>
                            <Button
                                id="editProjectButton"
                                text="Edit Project"
                                icon="sap-icon://edit"
                                press="onEditProject"
                                enabled="{viewModel>/hasSelection}"
                                visible="{= ${user>/isAdmin} !== false }"/>
                            <Button
                                id="deleteProjectButton"
                                text="Delete Project"
                                icon="sap-icon://delete"
                                press="onDeleteProject"
                                enabled="{viewModel>/hasSelection}"
                                visible="{user>/isAdmin}"
                                type="Reject"/>
                            <Button
                                id="newProjectButton"
                                text="New Project"
                                icon="sap-icon://create"
                                type="Emphasized"
                                press="onCreateProject"/>
                            <Button
                                id="viewAllAnalysesButton"
                                text="View All Analyses"
                                icon="sap-icon://activities"
                                press="onViewAllAnalyses"/>
                        </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                        <Column id="clientNameColumn">
                            <Text id="clientNameHeader" text="Client Name"/>
                        </Column>
                        <Column id="projectNameColumn">
                            <Text id="projectNameHeader" text="Project Name"/>
                        </Column>
                        <Column id="projectTypeColumn">
                            <Text id="projectTypeHeader" text="Project Type"/>
                        </Column>
                        <Column id="s4FlavorColumn">
                            <Text id="s4FlavorHeader" text="S/4HANA Flavor"/>
                        </Column>
                        <Column id="statusColumn">
                            <Text id="statusHeader" text="Status"/>
                        </Column>
                        <Column id="timelineColumn">
                            <Text id="timelineHeader" text="Timeline"/>
                        </Column>
                        <Column id="businessCriticalityColumn">
                            <Text id="businessCriticalityHeader" text="Business Criticality"/>
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem id="projectsTableItem" type="Navigation" press="onProjectSelect">
                            <cells>
                                <ObjectIdentifier id="clientNameCell" title="{clientName}"/>
                                <Text id="projectNameCell" text="{projectName}"/>
                                <Text id="projectTypeCell" text="{projectType}"/>
                                <Text id="s4FlavorCell" text="{s4HanaFlavor}"/>
                                <ObjectStatus
                                    id="statusCell"
                                    text="{status}"
                                    state="{= ${status} === 'Active' ? 'Success' : ${status} === 'Completed' ? 'Information' : 'None' }"/>
                                <Text id="timelineCell" text="{path: 'timeline', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'yyyy-MM-dd'}}"/>
                                <Text id="businessCriticalityCell" text="{businessCriticality}"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
    </Page>
</mvc:View>