<mvc:View
    controllerName="sd.solutionadvisor.controller.AnalysisDetails"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:viz="sap.viz.ui5.controls"
>
    <Page
        id="analysisDetails_Page"
        title="Analysis Details"
        showHeader="true"
        showNavButton="true"
        navButtonPress="onNavBack"
    >
        <content>
            <ObjectHeader
                id="analysisDetails_Header"
                title="{objectName}"
                number="{ricefwId}"
                numberState="Information"
                responsive="true"
                fullScreenOptimized="true"
            >
                <statuses>
                    <ObjectStatus
                        id="analysisDetails_RecommendationStatus"
                        text="{finalRecommendation}"
                        state="{= ${finalRecommendation}.indexOf('Level A') &gt; -1 ? 'Success' : ${finalRecommendation}.indexOf('Level B') &gt; -1 ? 'Information' : ${finalRecommendation}.indexOf('Level C') &gt; -1 ? 'Warning' : 'Error' }"
                    />
                    <ObjectStatus
                        id="analysisDetails_AnalysisStatus"
                        text="{status}"
                        state="{= ${status} === 'Completed' ? 'Success' : ${status} === 'In Progress' ? 'Warning' : 'None' }"
                    />
                </statuses>
                <attributes>
                    <ObjectAttribute
                        id="analysisDetails_ObjectTypeAttr"
                        title="Object Type"
                        text="{objectType}"
                    />
                    <ObjectAttribute
                        id="analysisDetails_RiskAssessmentAttr"
                        title="Risk Assessment"
                        text="{riskAssessment}"
                    />
                    <ObjectAttribute
                        id="analysisDetails_AnalysisDateAttr"
                        title="Analysis Date"
                        text="{path: 'analysisDate', type: 'sd.solutionadvisor.types.FlexibleDateTime', formatOptions: {pattern: 'yyyy-MM-dd HH:mm'}}"
                    />
                </attributes>
            </ObjectHeader>

            <!-- Scoring Dashboard - Responsive -->
            <Panel
                id="analysisDetails_ScoringPanel"
                headerText="Scoring Metrics Dashboard"
            >
                <headerToolbar>
                    <Toolbar id="analysisDetails_ScoringToolbar">
                        <Title
                            id="analysisDetails_ScoringToolbarTitle"
                            text="Scoring Metrics Dashboard"
                        />
                        <ToolbarSpacer
                            id="analysisDetails_ScoringToolbarSpacer"
                        />
                        <Button
                            id="analysisDetails_ScoringDrillDownBtn"
                            text="View Breakdown"
                            icon="sap-icon://drill-down"
                            press="onScoringDrillDown"
                            type="Transparent"
                        />
                    </Toolbar>
                </headerToolbar>
                <VBox
                    id="analysisDetails_ScoringContentBox"
                    class="sapUiSmallMargin"
                >
                    <!-- Unified Responsive Tile Layout (1x4, 2x2, or 4x1) -->
                    <FlexBox
                        id="analysisDetails_ScoringTilesContainer"
                        wrap="Wrap"
                        justifyContent="SpaceAround"
                        alignItems="Center"
                        class="scoringTilesContainer"
                    >
                        <GenericTile
                            id="analysisDetails_TechDebtTile"
                            class="scoringTile"
                            header="Technical Debt"
                            subheader="Lower is better"
                            press="onScoringDrillDown"
                        >
                            <tileContent>
                                <TileContent
                                    id="analysisDetails_TechDebtContent"
                                >
                                    <content>
                                        <NumericContent
                                            id="analysisDetails_TechDebtNumeric"
                                            value="{technicalDebtScore}"
                                            scale=""
                                            indicator="{= ${technicalDebtScore} &lt; 30 ? 'Up' : ${technicalDebtScore} &lt; 60 ? 'None' : 'Down' }"
                                            valueColor="{= ${technicalDebtScore} &lt; 30 ? 'Good' : ${technicalDebtScore} &lt; 60 ? 'Critical' : 'Error' }"
                                        />
                                    </content>
                                </TileContent>
                            </tileContent>
                        </GenericTile>

                        <GenericTile
                            id="analysisDetails_CloudReadyTile"
                            class="scoringTile"
                            header="Cloud Readiness"
                            subheader="Higher is better"
                            press="onScoringDrillDown"
                        >
                            <tileContent>
                                <TileContent
                                    id="analysisDetails_CloudReadyContent"
                                >
                                    <content>
                                        <NumericContent
                                            id="analysisDetails_CloudReadyNumeric"
                                            value="{cloudReadinessScore}"
                                            scale=""
                                            indicator="{= ${cloudReadinessScore} &gt; 70 ? 'Up' : ${cloudReadinessScore} &gt; 40 ? 'None' : 'Down' }"
                                            valueColor="{= ${cloudReadinessScore} &gt; 70 ? 'Good' : ${cloudReadinessScore} &gt; 40 ? 'Critical' : 'Error' }"
                                        />
                                    </content>
                                </TileContent>
                            </tileContent>
                        </GenericTile>

                        <GenericTile
                            id="analysisDetails_UpgradeImpTile"
                            class="scoringTile"
                            header="Upgrade Impact"
                            subheader="Lower is better"
                            press="onScoringDrillDown"
                        >
                            <tileContent>
                                <TileContent
                                    id="analysisDetails_UpgradeImpContent"
                                >
                                    <content>
                                        <NumericContent
                                            id="analysisDetails_UpgradeImpNumeric"
                                            value="{upgradeImpactScore}"
                                            scale=""
                                            indicator="{= ${upgradeImpactScore} &lt; 30 ? 'Up' : ${upgradeImpactScore} &lt; 60 ? 'None' : 'Down' }"
                                            valueColor="{= ${upgradeImpactScore} &lt; 30 ? 'Good' : ${upgradeImpactScore} &lt; 60 ? 'Critical' : 'Error' }"
                                        />
                                    </content>
                                </TileContent>
                            </tileContent>
                        </GenericTile>

                        <GenericTile
                            id="analysisDetails_CompositeHealthTile"
                            class="scoringTile"
                            header="Composite Health"
                            subheader="Overall health"
                            press="onScoringDrillDown"
                        >
                            <tileContent>
                                <TileContent
                                    id="analysisDetails_CompositeHealthContent"
                                >
                                    <content>
                                        <NumericContent
                                            id="analysisDetails_CompositeHealthNumeric"
                                            value="{compositeHealthScore}"
                                            scale=""
                                            indicator="{= ${compositeHealthScore} &gt; 70 ? 'Up' : ${compositeHealthScore} &gt; 40 ? 'None' : 'Down' }"
                                            valueColor="{= ${compositeHealthScore} &gt; 70 ? 'Good' : ${compositeHealthScore} &gt; 40 ? 'Critical' : 'Error' }"
                                        />
                                    </content>
                                </TileContent>
                            </tileContent>
                        </GenericTile>
                    </FlexBox>

                    <!-- Radar Chart Section - dynamically loaded by controller -->
                    <VBox
                        id="analysisDetails_RadarChartContainer"
                        class="sapUiSmallMarginTop"
                    />
                </VBox>
            </Panel>

            <IconTabBar
                id="analysisDetails_IconTabBar"
                class="sapUiResponsiveContentPadding"
            >
                <items>
                    <IconTabFilter
                        id="analysisDetails_ResultsTab"
                        text="Decision Results"
                        key="results"
                        icon="sap-icon://decision"
                    >
                        <form:SimpleForm
                            id="analysisDetails_ResultsForm"
                            editable="false"
                            layout="ResponsiveGridLayout"
                        >
                            <form:content>
                                <Label
                                    id="analysisDetails_RecommendedLevelLabel"
                                    text="Recommended Clean Core Level"
                                />
                                <ObjectStatus
                                    id="analysisDetails_RecommendedLevelValue"
                                    text="{finalRecommendation}"
                                    state="{= ${finalRecommendation}.indexOf('Level A') &gt; -1 ? 'Success' : ${finalRecommendation}.indexOf('Level B') &gt; -1 ? 'Information' : ${finalRecommendation}.indexOf('Level C') &gt; -1 ? 'Warning' : 'Error' }"
                                />

                                <Label
                                    id="analysisDetails_ReasoningLabel"
                                    text="Reasoning"
                                />
                                <Text
                                    id="analysisDetails_ReasoningText"
                                    text="{finalReasoning}"
                                />

                                <Label
                                    id="analysisDetails_EffortLabel"
                                    text="Estimated Effort"
                                />
                                <Text
                                    id="analysisDetails_EffortText"
                                    text="{estimatedEffort} person-days"
                                />

                                <Label
                                    id="analysisDetails_ComplexityLabel"
                                    text="Technical Complexity"
                                />
                                <Text
                                    id="analysisDetails_ComplexityText"
                                    text="{technicalComplexity}"
                                />

                                <Label
                                    id="analysisDetails_BusinessImpactLabel"
                                    text="Business Impact"
                                />
                                <Text
                                    id="analysisDetails_BusinessImpactText"
                                    text="{businessImpact}"
                                />
                            </form:content>
                        </form:SimpleForm>
                    </IconTabFilter>

                    <IconTabFilter
                        id="analysisDetails_ObjectTab"
                        text="Object Details"
                        key="object"
                        icon="sap-icon://detail-view"
                    >
                        <form:SimpleForm
                            id="analysisDetails_ObjectForm"
                            editable="false"
                            layout="ResponsiveGridLayout"
                        >
                            <form:content>
                                <Label
                                    id="analysisDetails_ObjRicefwIdLabel"
                                    text="RICEFW ID"
                                />
                                <Text
                                    id="analysisDetails_ObjRicefwIdText"
                                    text="{ricefwId}"
                                />

                                <Label
                                    id="analysisDetails_ObjTypeLabel"
                                    text="Object Type"
                                />
                                <Text
                                    id="analysisDetails_ObjTypeText"
                                    text="{objectType}"
                                />

                                <Label
                                    id="analysisDetails_ObjNameLabel"
                                    text="Object Name"
                                />
                                <Text
                                    id="analysisDetails_ObjNameText"
                                    text="{objectName}"
                                />

                                <Label
                                    id="analysisDetails_ObjDescLabel"
                                    text="Description"
                                />
                                <Text
                                    id="analysisDetails_ObjDescText"
                                    text="{objectDescription}"
                                />

                                <Label
                                    id="analysisDetails_ObjAnalysisDateLabel"
                                    text="Analysis Date"
                                />
                                <Text
                                    id="analysisDetails_ObjAnalysisDateText"
                                    text="{path: 'analysisDate', type: 'sd.solutionadvisor.types.FlexibleDateTime', formatOptions: {pattern: 'yyyy-MM-dd HH:mm'}}"
                                />

                                <Label
                                    id="analysisDetails_ObjStatusLabel"
                                    text="Status"
                                />
                                <ObjectStatus
                                    id="analysisDetails_ObjStatusValue"
                                    text="{status}"
                                    state="{= ${status} === 'Completed' ? 'Success' : ${status} === 'In Progress' ? 'Warning' : 'None' }"
                                />
                            </form:content>
                        </form:SimpleForm>
                    </IconTabFilter>

                    <IconTabFilter
                        id="analysisDetails_RiskTab"
                        text="Risk &amp; Compliance"
                        key="risk"
                        icon="sap-icon://warning"
                    >
                        <form:SimpleForm
                            id="analysisDetails_RiskForm"
                            editable="false"
                            layout="ResponsiveGridLayout"
                        >
                            <form:content>
                                <Label
                                    id="analysisDetails_RiskAssessLabel"
                                    text="Risk Assessment"
                                />
                                <ObjectStatus
                                    id="analysisDetails_RiskAssessValue"
                                    text="{riskAssessment}"
                                    state="{= ${riskAssessment} === 'Low' ? 'Success' : ${riskAssessment} === 'Medium' ? 'Warning' : 'Error' }"
                                />

                                <Label
                                    id="analysisDetails_RiskBusinessImpactLabel"
                                    text="Business Impact"
                                />
                                <Text
                                    id="analysisDetails_RiskBusinessImpactText"
                                    text="{businessImpact}"
                                />

                                <Label
                                    id="analysisDetails_ComplianceLabel"
                                    text="Compliance Status"
                                />
                                <ObjectStatus
                                    id="analysisDetails_ComplianceValue"
                                    text="{complianceStatus}"
                                    state="{= ${complianceStatus} === 'Compliant' ? 'Success' : ${complianceStatus} === 'Requires Review' ? 'Warning' : 'Error' }"
                                />
                            </form:content>
                        </form:SimpleForm>
                    </IconTabFilter>

                    <IconTabFilter
                        id="analysisDetails_FlowchartTab"
                        text="Decision Flowchart"
                        key="flowchart"
                        icon="sap-icon://org-chart"
                    >
                        <VBox
                            id="analysisDetails_FlowchartBox"
                            class="sapUiSmallMargin"
                            height="600px"
                        >
                            <MessageStrip
                                id="analysisDetails_FlowchartInfoStrip"
                                text="Visual representation of the decision path taken during analysis"
                                type="Information"
                                showIcon="true"
                                class="sapUiSmallMarginBottom"
                            />
                            <core:HTML
                                id="analysisDetails_FlowchartContainer"
                                content="&lt;div id='flowchartSvgContainer' style='width: 100%; height: 100%; background-color: #fafafa;'&gt;&lt;/div&gt;"
                            />
                        </VBox>
                    </IconTabFilter>
                    
                    <IconTabFilter
                        id="analysisDetails_ConstraintsTab"
                        text="Constraints"
                        key="constraints"
                        icon="sap-icon://warning2"
                    >
                        <VBox id="analysisDetails_ConstraintsBox" class="sapUiSmallMargin">
                            <core:Fragment fragmentName="sd.solutionadvisor.view.fragments.ConstraintsPanel" type="XML" />
                        </VBox>
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </content>
        <footer>
            <OverflowToolbar id="analysisDetails_Footer">
                <ToolbarSpacer id="analysisDetails_FooterSpacer" />
                <Button
                    id="analysisDetails_ViewFlowchartBtn"
                    text="View Flowchart"
                    icon="sap-icon://org-chart"
                    press="onViewFlowchart"
                />
                <Button
                    id="analysisDetails_RestartBtn"
                    text="Restart Analysis"
                    type="Emphasized"
                    icon="sap-icon://refresh"
                    press="onRestartAnalysis"
                />
                <Button
                    id="analysisDetails_RecalculateScoresBtn"
                    text="Recalculate Scores"
                    icon="sap-icon://customer-financial-fact-sheet"
                    press="onRecalculateScores"
                    tooltip="Recalculate scoring metrics without re-running the wizard"
                />
                <Button
                    id="analysisDetails_ExportFlowchartPNGBtn"
                    text="Export PNG"
                    icon="sap-icon://camera"
                    press="onExportFlowchartPNG"
                />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
