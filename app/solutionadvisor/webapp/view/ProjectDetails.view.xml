<mvc:View
    controllerName="sd.solutionadvisor.controller.ProjectDetails"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">
    <Page
        id="projectDetailsPage"
        title="Project Details"
        showHeader="true"
        showNavButton="true"
        navButtonPress="onNavBack">
        <content>
            <ObjectHeader
                id="projectHeader"
                title="{projectName}"
                number="{clientName}"
                numberState="Information">
                <statuses>
                    <ObjectStatus
                        id="projectStatus"
                        text="{status}"
                        state="{= ${status} === 'Active' ? 'Success' : ${status} === 'Completed' ? 'Information' : 'None' }"/>
                </statuses>
                <attributes>
                    <ObjectAttribute id="flavorAttr" title="S/4HANA Flavor" text="{s4HanaFlavor}"/>
                    <ObjectAttribute id="criticalityAttr" title="Business Criticality" text="{businessCriticality}"/>
                    <ObjectAttribute id="timelineAttr" title="Timeline" text="{path: 'timeline', type: 'sd.solutionadvisor.types.FlexibleDateTime', formatOptions: {pattern: 'yyyy-MM-dd'}}"/>
                </attributes>
                
            </ObjectHeader>
            <OverflowToolbar id="projectHeaderActionsToolbar">
                <ToolbarSpacer id="projectHeaderActionsSpacer"/>
                <Button
                    id="editButton"
                    text="Edit"
                    icon="sap-icon://edit"
                    press="onEdit"
                    visible="{= !${viewModel>/editMode}}"
                    type="Transparent"/>
                <Button
                    id="saveButton"
                    text="Save"
                    icon="sap-icon://save"
                    press="onSave"
                    visible="{viewModel>/editMode}"
                    type="Emphasized"/>
                <Button
                    id="cancelButton"
                    text="Cancel"
                    icon="sap-icon://decline"
                    press="onCancelEdit"
                    visible="{viewModel>/editMode}"
                    type="Transparent"/>
                <Button
                    id="viewAnalysesButton"
                    text="View Analyses"
                    icon="sap-icon://activities"
                    press="onViewAnalyses"
                    type="Transparent"/>
                <Button
                    id="manageUsersButton"
                    text="Manage Users"
                    icon="sap-icon://permission"
                    press="onManageUsers"
                    type="Emphasized"/>
            </OverflowToolbar>
            
            <IconTabBar
                id="projectIconTabBar"
                class="sapUiResponsiveContentPadding">
                <items>
                    <IconTabFilter
                        id="generalInfoTab"
                        text="General Information"
                        key="general"
                        icon="sap-icon://hint">
                        <form:SimpleForm
                            id="generalInfoForm"
                            editable="true"
                            layout="ResponsiveGridLayout"
                            labelSpanXL="4"
                            labelSpanL="3"
                            labelSpanM="4"
                            labelSpanS="12"
                            adjustLabelSpan="false"
                            emptySpanXL="0"
                            emptySpanL="0"
                            emptySpanM="0"
                            emptySpanS="0"
                            columnsXL="2"
                            columnsL="2"
                            columnsM="1"
                            singleContainerFullSize="false">
                            <form:content>
                                <Label id="clientNameLabel" text="Client Name"/>
                                <Input 
                                    id="clientNameInput" 
                                    value="{clientName}"
                                    editable="{viewModel>/editMode}"/>
                                
                                <Label id="projectNameLabel" text="Project Name"/>
                                <Input 
                                    id="projectNameInput" 
                                    value="{projectName}"
                                    editable="{viewModel>/editMode}"/>
                                
                                <Label id="projectTypeLabel" text="Project Type"/>
                                <Select
                                    id="projectTypeSelect"
                                    selectedKey="{projectType}"
                                    enabled="{viewModel>/editMode}">
                                    <items>
                                        <core:Item id="pdGreenfieldItem" key="Greenfield" text="Greenfield"/>
                                        <core:Item id="pdBrownfieldItem" key="Brownfield" text="Brownfield"/>
                                        <core:Item id="pdSysConvItem" key="System Conversion" text="System Conversion"/>
                                        <core:Item id="pdSelDataItem" key="Selective Data Transition" text="Selective Data Transition"/>
                                    </items>
                                </Select>
                                
                                <Label id="expectedDurationLabel" text="Expected Duration (months)"/>
                                <Input 
                                    id="expectedDurationInput" 
                                    value="{expectedDuration}"
                                    type="Number"
                                    editable="{viewModel>/editMode}"/>
                                
                                <Label id="timelineLabel" text="Timeline"/>
                                <DatePicker
                                    id="timelineDatePicker"
                                    value="{
                                        path: 'timeline',
                                        type: 'sap.ui.model.type.Date',
                                        formatOptions: { pattern: 'yyyy-MM-dd', UTC: true }
                                    }"
                                    displayFormat="yyyy-MM-dd"
                                    valueFormat="yyyy-MM-dd"
                                    enabled="{viewModel>/editMode}"/>
                                
                                <Label id="statusLabel" text="Status"/>
                                <Select
                                    id="statusSelect"
                                    selectedKey="{status}"
                                    enabled="{viewModel>/editMode}">
                                    <items>
                                        <core:Item id="pdPlanningItem" key="Planning" text="Planning"/>
                                        <core:Item id="pdActiveItem" key="Active" text="Active"/>
                                        <core:Item id="pdOnHoldItem" key="On Hold" text="On Hold"/>
                                        <core:Item id="pdCompletedItem" key="Completed" text="Completed"/>
                                    </items>
                                </Select>
                            </form:content>
                        </form:SimpleForm>
                    </IconTabFilter>
                    
                    <IconTabFilter
                        id="technicalConfigTab"
                        text="Technical Configuration"
                        key="technical"
                        icon="sap-icon://settings">
                        <form:SimpleForm
                            id="technicalConfigForm"
                            editable="true"
                            layout="ResponsiveGridLayout">
                            <form:content>
                                <Label id="techFlavorLabel" text="S/4HANA Flavor"/>
                                <Select
                                    id="s4HanaFlavorSelect"
                                    selectedKey="{s4HanaFlavor}"
                                    enabled="{viewModel>/editMode}">
                                    <items>
                                        <core:Item id="pdCloudPublicItem" key="Cloud Public" text="Cloud Public"/>
                                        <core:Item id="pdCloudPrivateItem" key="Cloud Private" text="Cloud Private"/>
                                        <core:Item id="pdOnPremiseItem" key="On-Premise" text="On-Premise"/>
                                    </items>
                                </Select>
                                
                                <Label id="availableBtpServicesLabel" text="Available BTP Services"/>
                                <Input 
                                    id="availableBtpServicesInput" 
                                    value="{availableBTPServices}"
                                    editable="{viewModel>/editMode}"/>
                                
                                <Label id="thirdPartyServicesLabel" text="Third Party Services"/>
                                <Input 
                                    id="thirdPartyServicesInput" 
                                    value="{thirdPartyServices}"
                                    editable="{viewModel>/editMode}"/>
                                
                                <Label id="technicalTeamSizeLabel" text="Technical Team Size"/>
                                <Input 
                                    id="technicalTeamSizeInput" 
                                    value="{technicalTeamSize}"
                                    type="Number"
                                    editable="{viewModel>/editMode}"/>
                            </form:content>
                        </form:SimpleForm>
                    </IconTabFilter>
                    
                    <IconTabFilter
                        id="governanceTab"
                        text="Governance"
                        key="governance"
                        icon="sap-icon://create-form">
                        <form:SimpleForm
                            id="governanceForm"
                            editable="true"
                            layout="ResponsiveGridLayout">
                            <form:content>
                                <Label id="governanceModelLabel" text="Governance Model"/>
                                <Select
                                    id="governanceModelSelect"
                                    selectedKey="{governanceModel}"
                                    enabled="{viewModel>/editMode}">
                                    <items>
                                        <core:Item id="pdCentralizedItem" key="Centralized" text="Centralized"/>
                                        <core:Item id="pdFederatedItem" key="Federated" text="Federated"/>
                                        <core:Item id="pdHybridItem" key="Hybrid" text="Hybrid"/>
                                    </items>
                                </Select>
                                
                                <Label id="complianceRequirementsLabel" text="Compliance Requirements"/>
                                <Input 
                                    id="complianceRequirementsInput" 
                                    value="{complianceRequirements}"
                                    editable="{viewModel>/editMode}"/>
                                
                                <Label id="governanceBusinessCriticalityLabel" text="Business Criticality"/>
                                <Select
                                    id="businessCriticalitySelect"
                                    selectedKey="{businessCriticality}"
                                    enabled="{viewModel>/editMode}">
                                    <items>
                                        <core:Item id="pdLowCritItem" key="Low" text="Low"/>
                                        <core:Item id="pdMediumCritItem" key="Medium" text="Medium"/>
                                        <core:Item id="pdHighCritItem" key="High" text="High"/>
                                        <core:Item id="pdCriticalCritItem" key="Critical" text="Critical"/>
                                    </items>
                                </Select>
                                
                                <Label id="budgetRangeLabel" text="Budget Range"/>
                                <Input 
                                    id="budgetRangeInput" 
                                    value="{budgetRange}"
                                    editable="{viewModel>/editMode}"/>
                            </form:content>
                        </form:SimpleForm>
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </content>
        <footer>
            <OverflowToolbar id="projectFooterToolbar">
                <ToolbarSpacer id="projectFooterSpacer"/>
                <Button
                    id="projectNewAnalysisButton"
                    text="New Analysis"
                    icon="sap-icon://add"
                    type="Emphasized"
                    press="onNewAnalysis"/>
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
