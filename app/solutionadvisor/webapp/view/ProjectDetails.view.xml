<mvc:View
    controllerName="sd.solutionadvisor.controller.ProjectDetails"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">
    <Page
        id="projectDetailsPage"
        title="Project Details"
        showHeader="true"
        showNavButton="true"
        navButtonPress="onNavBack">
        <content>
            <ObjectHeader
                id="projectHeader"
                title="{projectName}"
                number="{clientName}"
                numberState="Information">
                <statuses>
                    <ObjectStatus
                        id="projectStatus"
                        text="{status}"
                        state="{= ${status} === 'Active' ? 'Success' : ${status} === 'Completed' ? 'Information' : 'None' }"/>
                </statuses>
                <attributes>
                    <ObjectAttribute id="flavorAttr" title="S/4HANA Flavor" text="{s4HanaFlavor}"/>
                    <ObjectAttribute id="criticalityAttr" title="Business Criticality" text="{businessCriticality}"/>
                    <ObjectAttribute id="timelineAttr" title="Timeline" text="{path: 'timeline', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'yyyy-MM-dd'}}"/>
                </attributes>
                
            </ObjectHeader>
            <OverflowToolbar id="projectHeaderActionsToolbar">
                <ToolbarSpacer id="projectHeaderActionsSpacer"/>
                <Button
                    id="viewAnalysesButton"
                    text="View Analyses"
                    icon="sap-icon://activities"
                    press="onViewAnalyses"
                    type="Transparent"/>
                <Button
                    id="manageUsersButton"
                    text="Manage Users"
                    icon="sap-icon://permission"
                    press="onManageUsers"
                    type="Emphasized"/>
            </OverflowToolbar>
            
            <IconTabBar
                id="projectIconTabBar"
                class="sapUiResponsiveContentPadding">
                <items>
                    <IconTabFilter
                        id="generalInfoTab"
                        text="General Information"
                        key="general"
                        icon="sap-icon://hint">
                        <form:SimpleForm
                            id="generalInfoForm"
                            editable="false"
                            layout="ResponsiveGridLayout"
                            labelSpanXL="4"
                            labelSpanL="3"
                            labelSpanM="4"
                            labelSpanS="12"
                            adjustLabelSpan="false"
                            emptySpanXL="0"
                            emptySpanL="0"
                            emptySpanM="0"
                            emptySpanS="0"
                            columnsXL="2"
                            columnsL="2"
                            columnsM="1"
                            singleContainerFullSize="false">
                            <form:content>
                                <Label id="clientNameLabel" text="Client Name"/>
                                <Text id="clientNameText" text="{clientName}"/>
                                
                                <Label id="projectNameLabel" text="Project Name"/>
                                <Text id="projectNameText" text="{projectName}"/>
                                
                                <Label id="projectTypeLabel" text="Project Type"/>
                                <Text id="projectTypeText" text="{projectType}"/>
                                
                                <Label id="expectedDurationLabel" text="Expected Duration"/>
                                <Text id="expectedDurationText" text="{expectedDuration} months"/>
                                
                                <Label id="statusLabel" text="Status"/>
                                <ObjectStatus
                                    id="statusValue"
                                    text="{status}"
                                    state="{= ${status} === 'Active' ? 'Success' : ${status} === 'Completed' ? 'Information' : 'None' }"/>
                            </form:content>
                        </form:SimpleForm>
                    </IconTabFilter>
                    
                    <IconTabFilter
                        id="technicalConfigTab"
                        text="Technical Configuration"
                        key="technical"
                        icon="sap-icon://settings">
                        <form:SimpleForm
                            id="technicalConfigForm"
                            editable="false"
                            layout="ResponsiveGridLayout">
                            <form:content>
                                <Label id="techFlavorLabel" text="S/4HANA Flavor"/>
                                <Text id="techFlavorText" text="{s4HanaFlavor}"/>
                                
                                <Label id="availableBtpServicesLabel" text="Available BTP Services"/>
                                <Text id="availableBtpServicesText" text="{availableBTPServices}"/>
                                
                                <Label id="thirdPartyServicesLabel" text="Third Party Services"/>
                                <Text id="thirdPartyServicesText" text="{thirdPartyServices}"/>
                                
                                <Label id="technicalTeamSizeLabel" text="Technical Team Size"/>
                                <Text id="technicalTeamSizeText" text="{technicalTeamSize}"/>
                            </form:content>
                        </form:SimpleForm>
                    </IconTabFilter>
                    
                    <IconTabFilter
                        id="governanceTab"
                        text="Governance"
                        key="governance"
                        icon="sap-icon://create-form">
                        <form:SimpleForm
                            id="governanceForm"
                            editable="false"
                            layout="ResponsiveGridLayout">
                            <form:content>
                                <Label id="governanceModelLabel" text="Governance Model"/>
                                <Text id="governanceModelText" text="{governanceModel}"/>
                                
                                <Label id="complianceRequirementsLabel" text="Compliance Requirements"/>
                                <Text id="complianceRequirementsText" text="{complianceRequirements}"/>
                                
                                <Label id="governanceBusinessCriticalityLabel" text="Business Criticality"/>
                                <Text id="governanceBusinessCriticalityText" text="{businessCriticality}"/>
                                
                                <Label id="budgetRangeLabel" text="Budget Range"/>
                                <Text id="budgetRangeText" text="{budgetRange}"/>
                            </form:content>
                        </form:SimpleForm>
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </content>
        <footer>
            <OverflowToolbar id="projectFooterToolbar">
                <ToolbarSpacer id="projectFooterSpacer"/>
                <Button
                    id="projectNewAnalysisButton"
                    text="New Analysis"
                    icon="sap-icon://add"
                    type="Emphasized"
                    press="onNewAnalysis"/>
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
