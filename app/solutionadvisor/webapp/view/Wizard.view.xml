<mvc:View
    controllerName="sd.solutionadvisor.controller.Wizard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
>
    <Page
        id="wizardPage"
        title="New Clean Core Analysis"
        showHeader="true"
        showNavButton="true"
        navButtonPress="onNavBack"
        enableScrolling="true"
        backgroundDesign="List"
    >
        <content>
            <Wizard
                id="cleanCoreWizard"
                complete="onWizardComplete"
                class="sapUiResponsiveMargin"
                enableBranching="false"
                backgroundDesign="Transparent"
            >
                <!-- Step 1: Project Selection -->
                <WizardStep
                    id="projectStep"
                    title="Select Project"
                    validated="false"
                    activate="onProjectStepActivate"
                >
                    <VBox
                        id="projectStepVBox"
                        class="sapUiSmallMargin"
                    >
                        <MessageStrip
                            id="projectAutoSelectedInfo"
                            visible="{wizardModel>/autoSelectedProject}"
                            text="Project automatically selected from previous screen"
                            type="Success"
                            showIcon="true"
                            class="sapUiSmallMarginBottom"
                        />
                        <Label
                            id="projectLabel"
                            text="Select Project"
                            required="true"
                        />
                        <ComboBox
                            id="projectComboBox"
                            width="100%"
                            placeholder="Choose a project..."
                            selectionChange="onProjectSelect"
                            enabled="{= !${wizardModel>/autoSelectedProject} }"
                            selectedKey="{wizardModel>/projectID}"
                            items="{
                                path: '/Projects',
                                sorter: { path: 'projectName' }
                            }"
                        >
                            <core:Item
                                id="projectItem"
                                key="{ID}"
                                text="{projectName} - {clientName}"
                            />
                        </ComboBox>
                        <Text
                            id="projectInfo"
                            class="sapUiTinyMarginTop"
                            text=""
                        />
                    </VBox>
                </WizardStep>

                <!-- Step 2: Object Information -->
                <WizardStep
                    id="objectStep"
                    title="Object Information"
                    validated="false"
                    activate="onObjectStepActivate"
                >
                    <VBox
                        id="objectStepVBox"
                        class="sapUiSmallMargin"
                    >
                        <HBox
                            id="ricefwIdHintHBox"
                            alignItems="Center"
                            justifyContent="SpaceBetween"
                        >
                            <Label
                                id="ricefwIdLabel"
                                text="RICEFW ID"
                                required="true"
                            />
                            <Button
                                id="hintButtonObject"
                                icon="sap-icon://hint"
                                tooltip="Show detailed hint"
                                press="onShowDetailedHint"
                                type="Transparent"
                            />
                        </HBox>
                        <Input
                            id="ricefwIdInput"
                            width="100%"
                            placeholder="e.g., I-0042-IMP"
                            liveChange="onRicefwIdChange"
                            description="Format: [RICEFYW]-[0-9]&#123;4&#125;-[A-Z]&#123;3&#125;"
                            class="sapUiResponsiveContentPadding"
                        />

                        <Label
                            id="objectTypeLabel"
                            text="Object Type"
                            required="true"
                            class="sapUiTinyMarginTop"
                        />
                        <ComboBox
                            id="objectTypeComboBox"
                            width="100%"
                            placeholder="Select object type..."
                            selectionChange="onObjectTypeSelect"
                            items="{
                                path: '/ObjectTypes',
                                sorter: { path: 'displayName' }
                            }"
                        >
                            <core:Item
                                id="objectTypeItem"
                                key="{objectType}"
                                text="{displayName} ({objectCode})"
                            />
                        </ComboBox>

                        <Label
                            id="objectNameLabel"
                            text="Object Name"
                            required="true"
                            class="sapUiTinyMarginTop"
                        />
                        <Input
                            id="objectNameInput"
                            width="100%"
                            placeholder="Enter object name..."
                            liveChange="onObjectNameChange"
                        />

                        <Label
                            id="objectDescriptionLabel"
                            text="Object Description"
                            class="sapUiTinyMarginTop"
                        />
                        <TextArea
                            id="objectDescriptionInput"
                            width="100%"
                            rows="3"
                            placeholder="Optional: Describe the object..."
                        />

                        <!-- Business Area Selection -->
                        <Label
                            id="businessAreaLabel"
                            text="Business Area"
                            class="sapUiTinyMarginTop"
                        />
                        <ComboBox
                            id="businessAreaComboBox"
                            width="100%"
                            placeholder="Select business area..."
                            selectedKey="{wizardModel>/businessArea_ID}"
                            items="{
                                path: '/BusinessAreas',
                                sorter: [
                                    { path: 'category' },
                                    { path: 'displayOrder' }
                                ]
                            }"
                            selectionChange="onBusinessAreaSelect"
                        >
                            <core:Item
                                id="businessAreaItem"
                                key="{ID}"
                                text="[{category}] {code} - {displayName}"
                            />
                        </ComboBox>

                        <!-- Complexity Selection -->
                        <Label
                            id="complexityLabel"
                            text="Complexity"
                            class="sapUiTinyMarginTop"
                        />
                        <ComboBox
                            id="complexityComboBox"
                            width="100%"
                            placeholder="Select complexity level..."
                            selectedKey="{wizardModel>/complexity}"
                            items="{wizardModel>/complexityOptions}"
                            selectionChange="onComplexitySelect"
                        >
                            <core:Item
                                id="complexityItem"
                                key="{wizardModel>key}"
                                text="{wizardModel>text}"
                            />
                        </ComboBox>
                    </VBox>
                </WizardStep>

                <!-- Step 3: Clean Core Guidance -->
                <WizardStep
                    id="guidanceStep"
                    title="Step 3: Clean Core Guidance"
                    validated="true"
                    activate="onGuidanceStepActivate"
                >
                    <VBox
                        id="guidanceStepVBox"
                        class="sapUiSmallMargin"
                        alignItems="Center"
                        justifyContent="Center"
                        height="300px"
                    >
                        <VBox
                            id="guidanceButtonContainer"
                            alignItems="Center"
                            class="sapUiMediumMarginTop"
                        >
                            <Title
                                id="guidanceStepTitle"
                                text="Learn Clean Core Levels"
                                level="H2"
                                class="sapUiMediumMarginBottom"
                            />
                            <Text
                                id="guidanceStepDescription"
                                text="Click the button below to explore Clean Core levels (A, B, C, D) for your selected object type and understand the design approaches, tools, and best practices."
                                class="sapUiMediumMarginBottom"
                                textAlign="Center"
                            />
                            <Button
                                id="learnCleanCoreLevelsButton"
                                text="Learn Clean Core Levels for {wizardModel>/objectType}"
                                press="onLearnCleanCoreLevels"
                                type="Emphasized"
                                icon="sap-icon://sys-find-next"
                                class="sapUiMediumMarginTop"
                                width="300px"
                            />
                        </VBox>
                    </VBox>
                </WizardStep>

                <!-- Step 4: Ready to Start -->
                <WizardStep
                    id="readyStep"
                    title="Step 4: Ready to Start"
                    validated="true"
                >
                    <VBox
                        id="readyStepVBox"
                        class="sapUiSmallMargin"
                    >
                        <MessageStrip
                            id="readyMessageStrip"
                            text="You will now be guided through a series of questions to determine the optimal Clean Core level for your object. Click 'Start Analysis' to begin."
                            type="Information"
                            showIcon="true"
                        />

                        <VBox
                            id="summaryContainerVBox"
                            class="sapUiMediumMarginTop"
                        >
                            <Title
                                id="summaryTitle"
                                text="Summary"
                                level="H3"
                            />
                            <VBox
                                id="summaryFieldsVBox"
                                class="sapUiTinyMarginTop"
                            >
                                <Label
                                    id="summaryProjectLabel"
                                    text="Project:"
                                />
                                <Text
                                    id="summaryProject"
                                    text="{wizardModel>/projectName}"
                                />

                                <Label
                                    id="summaryRicefwIdLabel"
                                    text="RICEFW ID:"
                                    class="sapUiTinyMarginTop"
                                />
                                <Text
                                    id="summaryRicefwId"
                                    text="{wizardModel>/ricefwId}"
                                />

                                <Label
                                    id="summaryObjectTypeLabel"
                                    text="Object Type:"
                                    class="sapUiTinyMarginTop"
                                />
                                <Text
                                    id="summaryObjectType"
                                    text="{wizardModel>/objectType}"
                                />

                                <Label
                                    id="summaryObjectNameLabel"
                                    text="Object Name:"
                                    class="sapUiTinyMarginTop"
                                />
                                <Text
                                    id="summaryObjectName"
                                    text="{wizardModel>/objectName}"
                                />

                                <Label
                                    id="summaryBusinessAreaLabel"
                                    text="Business Area:"
                                    class="sapUiTinyMarginTop"
                                />
                                <Text
                                    id="summaryBusinessArea"
                                    text="{wizardModel>/businessAreaName}"
                                />

                                <Label
                                    id="summaryComplexityLabel"
                                    text="Complexity:"
                                    class="sapUiTinyMarginTop"
                                />
                                <Text
                                    id="summaryComplexity"
                                    text="{wizardModel>/complexity}"
                                />
                            </VBox>
                        </VBox>
                    </VBox>
                </WizardStep>

                <!-- Step 5: Dynamic Questions -->
                <WizardStep
                    id="questionStep"
                    title="Analysis Questions"
                    validated="false"
                    visible="{= !!${wizardModel>/currentQuestion}}"
                >
                    <!-- Question Panel -->
                    <Panel
                        id="questionPanel"
                        visible="{= !!${wizardModel>/currentQuestion} &amp;&amp; !${wizardModel>/finalRecommendation}}"
                    >
                        <VBox
                            id="questionVBox"
                            class="sapUiMediumMargin"
                        >
                            <!-- Progress Indicator -->
                            <HBox
                                id="progressHBox"
                                alignItems="Center"
                                justifyContent="SpaceBetween"
                                class="sapUiSmallMarginBottom"
                            >
                                <Title
                                    id="stepTitle"
                                    text="Step {wizardModel>/currentStep} of {wizardModel>/totalSteps}"
                                    level="H4"
                                />
                                <ProgressIndicator
                                    id="wizardProgressIndicator"
                                    width="200px"
                                    percentValue="{= ${wizardModel>/totalSteps} > 0 ? Math.round((${wizardModel>/currentStep} / ${wizardModel>/totalSteps}) * 100) : 0}"
                                    displayValue="{= ${wizardModel>/totalSteps} > 0 ? Math.round((${wizardModel>/currentStep} / ${wizardModel>/totalSteps}) * 100) + '%' : '0%'}"
                                    state="{= ${wizardModel>/currentStep} === ${wizardModel>/totalSteps} ? 'Success' : 'None'}"
                                />
                            </HBox>

                            <!-- Question Title -->
                            <Title
                                id="questionTitle"
                                text="{wizardModel>/currentQuestion/questionText}"
                                level="H2"
                                class="sapUiMediumMarginBottom"
                            />

                            <!-- Question Hint -->
                            <Text
                                id="questionHint"
                                text="{wizardModel>/currentQuestion/hint}"
                                class="sapUiSmallMarginBottom"
                            />

                            <!-- Answer Options -->
                            <VBox
                                id="answerOptionsBox"
                                class="sapUiMediumMarginTop sapUiMediumMarginBottom"
                            >
                                <RadioButtonGroup
                                    id="answerOptionsGroup"
                                    selectedIndex="{wizardModel>/selectedAnswerIndex}"
                                    columns="1"
                                    select="onAnswerSelect"
                                    enabled="{= !${wizardModel>/questionCompleted}}"
                                    buttons="{wizardModel>/currentQuestion/answerOptions}"
                                >
                                    <RadioButton
                                        id="answerOptionTemplate"
                                        text="{wizardModel>label}"
                                        tooltip="{wizardModel>description}"
                                        class="sapUiSmallMarginBottom"
                                    />
                                </RadioButtonGroup>
                            </VBox>

                            <!-- Action Buttons - Touch-friendly -->
                            <HBox
                                id="actionButtonsHBox"
                                alignItems="Center"
                                class="sapUiSmallMarginTop"
                                wrap="Wrap"
                            >
                                <Button
                                    id="detailedHintButton"
                                    text="Show Detailed Hint"
                                    icon="sap-icon://hint"
                                    press="onShowDetailedHint"
                                    class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                                    width="auto"
                                    visible="{= !!${wizardModel>/currentQuestion/detailedHint}}"
                                />
                                <Button
                                    id="nextQuestionButton"
                                    text="Next Question"
                                    type="Emphasized"
                                    enabled="{= ${wizardModel>/selectedAnswerIndex} >= 0 &amp;&amp; !${wizardModel>/questionCompleted}}"
                                    press="onSubmitAnswer"
                                    class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                                    width="auto"
                                />
                            </HBox>
                        </VBox>
                    </Panel>

                    <!-- Final Recommendation Panel -->
                    <Panel
                        id="recommendationPanel"
                        visible="{= !!${wizardModel>/finalRecommendation}}"
                    >
                        <VBox
                            id="recommendationVBox"
                            class="sapUiMediumMargin"
                        >
                            <MessageStrip
                                id="completionMessage"
                                text="Analysis Complete!"
                                type="Success"
                                showIcon="true"
                                class="sapUiMediumMarginBottom"
                            />

                            <Title
                                id="recommendationLevelTitle"
                                text="Recommended Clean Core Level"
                                level="H2"
                                class="sapUiSmallMarginBottom"
                            />
                            <Title
                                id="recommendationLevel"
                                text="{wizardModel>/finalRecommendation}"
                                level="H3"
                                class="sapUiSmallMarginBottom sapUiSuccessText"
                            />
                            <Text
                                id="recommendationReasoning"
                                text="{wizardModel>/finalReasoning}"
                                class="sapUiMediumMarginBottom"
                            />

                            <!-- Scoring Dashboard - Responsive Layout -->
                            <Title
                                id="scoringTitle"
                                text="Scoring Metrics"
                                level="H4"
                                class="sapUiSmallMarginBottom"
                            />

                            <!-- Desktop/Tablet Layout -->
                            <HBox
                                id="scoresHBoxDesktop"
                                class="sapUiMediumMarginBottom sapUiHideOnPhone"
                                wrap="Wrap"
                            >
                                <VBox
                                    id="technicalDebtBox"
                                    class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                                    width="250px"
                                >
                                    <Label
                                        id="technicalDebtLabel"
                                        text="Technical Debt Score"
                                        class="sapUiTinyMarginBottom"
                                    />
                                    <ProgressIndicator
                                        id="technicalDebtIndicator"
                                        percentValue="{wizardModel>/scores/technicalDebt}"
                                        displayValue="{wizardModel>/scores/technicalDebt}%"
                                        state="{= ${wizardModel>/scores/technicalDebt} &lt; 30 ? 'Success' : 
                                ${wizardModel>/scores/technicalDebt} &lt; 70 ? 'Warning' : 'Error' }"
                                    />
                                    <Text
                                        id="technicalDebtHelp"
                                        text="Lower is better"
                                        class="sapUiTinyText"
                                    />
                                </VBox>

                                <VBox
                                    id="cloudReadinessBox"
                                    class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                                    width="250px"
                                >
                                    <Label
                                        id="cloudReadinessLabel"
                                        text="Cloud Readiness Score"
                                        class="sapUiTinyMarginBottom"
                                    />
                                    <ProgressIndicator
                                        id="cloudReadinessIndicator"
                                        percentValue="{wizardModel>/scores/cloudReadiness}"
                                        displayValue="{wizardModel>/scores/cloudReadiness}%"
                                        state="{= ${wizardModel>/scores/cloudReadiness} > 70 ? 'Success' : 
                                ${wizardModel>/scores/cloudReadiness} > 40 ? 'Warning' : 'Error' }"
                                    />
                                    <Text
                                        id="cloudReadinessHelp"
                                        text="Higher is better"
                                        class="sapUiTinyText"
                                    />
                                </VBox>

                                <VBox
                                    id="upgradeImpactBox"
                                    class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                                    width="250px"
                                >
                                    <Label
                                        id="upgradeImpactLabel"
                                        text="Upgrade Impact Score"
                                        class="sapUiTinyMarginBottom"
                                    />
                                    <ProgressIndicator
                                        id="upgradeImpactIndicator"
                                        percentValue="{wizardModel>/scores/upgradeImpact}"
                                        displayValue="{wizardModel>/scores/upgradeImpact}%"
                                        state="{= ${wizardModel>/scores/upgradeImpact} &lt; 30 ? 'Success' : 
                                ${wizardModel>/scores/upgradeImpact} &lt; 70 ? 'Warning' : 'Error' }"
                                    />
                                    <Text
                                        id="upgradeImpactHelp"
                                        text="Lower is better"
                                        class="sapUiTinyText"
                                    />
                                </VBox>

                                <VBox
                                    id="compositeHealthBox"
                                    class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                                    width="250px"
                                >
                                    <Label
                                        id="compositeHealthLabel"
                                        text="Composite Health Score"
                                        class="sapUiTinyMarginBottom"
                                    />
                                    <ProgressIndicator
                                        id="compositeHealthIndicator"
                                        percentValue="{wizardModel>/scores/compositeHealth}"
                                        displayValue="{wizardModel>/scores/compositeHealth}%"
                                        state="{= ${wizardModel>/scores/compositeHealth} > 70 ? 'Success' : 
                                ${wizardModel>/scores/compositeHealth} > 40 ? 'Warning' : 'Error' }"
                                    />
                                    <Text
                                        id="compositeHealthHelp"
                                        text="Higher is better"
                                        class="sapUiTinyText"
                                    />
                                </VBox>
                            </HBox>

                            <!-- Mobile Accordion Layout -->
                            <Panel
                                id="mobileScoresPanel"
                                class="sapUiShowOnPhone sapUiMediumMarginBottom"
                                expandable="true"
                                expanded="true"
                                headerText="Scoring Summary"
                            >
                                <VBox id="mobileScoresVBox" class="sapUiSmallMargin">
                                    <List
                                        id="mobileScoresList"
                                        noDataText="No scoring data available"
                                    >
                                        <CustomListItem id="mobileTechDebtItem">
                                            <HBox
                                                id="mobileTechDebtHBox"
                                                alignItems="Center"
                                                justifyContent="SpaceBetween"
                                                width="100%"
                                            >
                                                <VBox id="mobileTechDebtLabelVBox" width="60%">
                                                    <Text
                                                        id="mobileTechDebtText"
                                                        text="Technical Debt"
                                                        class="sapUiMediumText"
                                                    />
                                                    <Text
                                                        id="mobileTechDebtHelpText"
                                                        text="Lower is better"
                                                        class="sapUiTinyText"
                                                    />
                                                </VBox>
                                                <VBox
                                                    id="mobileTechDebtValueVBox"
                                                    width="35%"
                                                    alignItems="End"
                                                >
                                                    <ObjectNumber
                                                        id="mobileTechDebtNumber"
                                                        number="{wizardModel>/scores/technicalDebt}"
                                                        unit="%"
                                                        state="{= ${wizardModel>/scores/technicalDebt} &lt; 30 ? 'Success' : ${wizardModel>/scores/technicalDebt} &lt; 70 ? 'Warning' : 'Error' }"
                                                        emphasized="true"
                                                    />
                                                </VBox>
                                            </HBox>
                                        </CustomListItem>
                                        <CustomListItem id="mobileCloudReadinessItem">
                                            <HBox
                                                id="mobileCloudReadinessHBox"
                                                alignItems="Center"
                                                justifyContent="SpaceBetween"
                                                width="100%"
                                            >
                                                <VBox id="mobileCloudReadinessLabelVBox" width="60%">
                                                    <Text
                                                        id="mobileCloudReadinessText"
                                                        text="Cloud Readiness"
                                                        class="sapUiMediumText"
                                                    />
                                                    <Text
                                                        id="mobileCloudReadinessHelpText"
                                                        text="Higher is better"
                                                        class="sapUiTinyText"
                                                    />
                                                </VBox>
                                                <VBox
                                                    id="mobileCloudReadinessValueVBox"
                                                    width="35%"
                                                    alignItems="End"
                                                >
                                                    <ObjectNumber
                                                        id="mobileCloudReadinessNumber"
                                                        number="{wizardModel>/scores/cloudReadiness}"
                                                        unit="%"
                                                        state="{= ${wizardModel>/scores/cloudReadiness} > 70 ? 'Success' : ${wizardModel>/scores/cloudReadiness} > 40 ? 'Warning' : 'Error' }"
                                                        emphasized="true"
                                                    />
                                                </VBox>
                                            </HBox>
                                        </CustomListItem>
                                        <CustomListItem id="mobileUpgradeImpactItem">
                                            <HBox
                                                id="mobileUpgradeImpactHBox"
                                                alignItems="Center"
                                                justifyContent="SpaceBetween"
                                                width="100%"
                                            >
                                                <VBox id="mobileUpgradeImpactLabelVBox" width="60%">
                                                    <Text
                                                        id="mobileUpgradeImpactText"
                                                        text="Upgrade Impact"
                                                        class="sapUiMediumText"
                                                    />
                                                    <Text
                                                        id="mobileUpgradeImpactHelpText"
                                                        text="Lower is better"
                                                        class="sapUiTinyText"
                                                    />
                                                </VBox>
                                                <VBox
                                                    id="mobileUpgradeImpactValueVBox"
                                                    width="35%"
                                                    alignItems="End"
                                                >
                                                    <ObjectNumber
                                                        id="mobileUpgradeImpactNumber"
                                                        number="{wizardModel>/scores/upgradeImpact}"
                                                        unit="%"
                                                        state="{= ${wizardModel>/scores/upgradeImpact} &lt; 30 ? 'Success' : ${wizardModel>/scores/upgradeImpact} &lt; 70 ? 'Warning' : 'Error' }"
                                                        emphasized="true"
                                                    />
                                                </VBox>
                                            </HBox>
                                        </CustomListItem>
                                        <CustomListItem id="mobileCompositeHealthItem">
                                            <HBox
                                                id="mobileCompositeHealthHBox"
                                                alignItems="Center"
                                                justifyContent="SpaceBetween"
                                                width="100%"
                                            >
                                                <VBox id="mobileCompositeHealthLabelVBox" width="60%">
                                                    <Text
                                                        id="mobileCompositeHealthText"
                                                        text="Composite Health"
                                                        class="sapUiMediumText"
                                                    />
                                                    <Text
                                                        id="mobileCompositeHealthHelpText"
                                                        text="Overall health"
                                                        class="sapUiTinyText"
                                                    />
                                                </VBox>
                                                <VBox
                                                    id="mobileCompositeHealthValueVBox"
                                                    width="35%"
                                                    alignItems="End"
                                                >
                                                    <ObjectNumber
                                                        id="mobileCompositeHealthNumber"
                                                        number="{wizardModel>/scores/compositeHealth}"
                                                        unit="%"
                                                        state="{= ${wizardModel>/scores/compositeHealth} > 70 ? 'Success' : ${wizardModel>/scores/compositeHealth} > 40 ? 'Warning' : 'Error' }"
                                                        emphasized="true"
                                                    />
                                                </VBox>
                                            </HBox>
                                        </CustomListItem>
                                    </List>
                                </VBox>
                            </Panel>
                            <Button
                                id="viewDetailsButton"
                                text="View Analysis Details"
                                type="Emphasized"
                                press="onViewAnalysisDetails"
                                class="sapUiMediumMarginTop"
                            />
                            <Button
                                id="closeWizardButton"
                                text="Close"
                                press="onCloseWizard"
                                class="sapUiMediumMarginTop sapUiSmallMarginBegin"
                            />
                        </VBox>
                    </Panel>
                </WizardStep>
            </Wizard>
        </content>
        <footer>
            <OverflowToolbar id="wizardFooter">
                <Button
                    id="ricefwHistoryButton"
                    text="View History"
                    icon="sap-icon://history"
                    press="onShowRicefwHistory"
                    visible="{= ${wizardModel>/ricefwId} !== '' }"
                />
                <Button
                    id="saveDraftButton"
                    text="Save Draft"
                    icon="sap-icon://save"
                    press="onSaveDraft"
                    visible="{= ${wizardModel>/projectID} !== '' }"
                />
                <ToolbarSpacer id="wizardFooterSpacer" />
                <Button
                    id="wizardCancelButton"
                    text="Cancel"
                    press="onCancel"
                    visible="{= !${wizardModel>/finalRecommendation} }"
                />
                <Button
                    id="wizardCloseFooterButton"
                    text="Close"
                    press="onCloseWizard"
                    visible="{= !!${wizardModel>/finalRecommendation} }"
                />
                <Button
                    id="wizardNextButton"
                    text="Next"
                    type="Emphasized"
                    press="onNextStep"
                    visible="{= !${wizardModel>/finalRecommendation} }"
                />
                <Button
                    id="wizardStartButton"
                    text="Start Analysis"
                    type="Emphasized"
                    visible="false"
                    press="onStartAnalysis"
                />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
