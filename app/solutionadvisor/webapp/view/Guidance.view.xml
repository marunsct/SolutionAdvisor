                                            <m:Label id="levelBCloudLabel" text="Cloud Readiness" class="sapUiTinyMarginBottom" />
                                            <m:Text id="levelBCloudText" text="{guidance>/levelB/cloudReadiness}" />
                                        </m:VBox>
                                        <m:VBox id="levelBRiskBox" alignItems="Start" class="sapUiTinyMargin">
                                            <m:Label id="levelBRiskLabel" text="Technical Risk" class="sapUiTinyMarginBottom" />
                                            <m:Text id="levelBRiskText" text="{guidance>/levelB/technicalRisk}" />
                                        </m:VBox>
                                    </m:HBox>
                                </m:VBox>
                            </m:VBox>
                        </blocks>
                    </ObjectPageSubSection>
                    
                    <!-- Level C -->
                    <ObjectPageSubSection id="levelCSubSection" title="{= ${guidance>/levelC/title} || '🟨 Level C - Risky Legacy' }">
                        <blocks>
                            <m:VBox id="levelCVBox" class="sapUiNoMargin">
                                <m:VBox id="levelCContentBox" class="sapUiSmallMarginBottom">
                                    <m:Label id="levelCWhatLabel" text="What it means:" design="Bold" class="sapUiTinyMarginBottom" />
                                    <m:FormattedText id="levelCWhatText" htmlText="{guidance>/levelC/whatItMeans}" class="sapUiSmallMarginBottom" />
                                </m:VBox>
                                
