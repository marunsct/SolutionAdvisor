                                    <m:Label id="levelDExampleLabel" text="Example:" design="Bold" class="sapUiTinyMarginBottom" />
                                    <m:FormattedText id="levelDExampleText" htmlText="{guidance>/levelD/exampleReport}" class="sapUiSmallMarginBottom" />
                                </m:VBox>
                                
                                <m:VBox id="levelDWhyBox" class="sapUiSmallMarginBottom">
                                    <m:Label id="levelDWhyLabel" text="Why it's bad:" design="Bold" class="sapUiTinyMarginBottom" />
                                    <m:FormattedText id="levelDWhyText" htmlText="{guidance>/levelD/whyReasoning}" class="sapUiSmallMarginBottom" />
                                </m:VBox>
                                
                                <m:VBox id="levelDDescBox" class="sapUiSmallMarginBottom">
                                    <m:Label id="levelDDescLabel" text="Description:" design="Bold" class="sapUiTinyMarginBottom" />
                                    <m:FormattedText id="levelDDescText" htmlText="{guidance>/levelD/description}" class="sapUiSmallMarginBottom" />
