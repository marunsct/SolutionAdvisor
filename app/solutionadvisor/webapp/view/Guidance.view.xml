            <!-- Section 2: Decision Tree -->
            <!--ObjectPageSection
                id="decisionTreeSection"
                title="Decision Tree"
                visible="{= ${guidance>/guidance/decisionTree} &amp;&amp; ${guidance>/guidance/decisionTree}.length > 0}"
