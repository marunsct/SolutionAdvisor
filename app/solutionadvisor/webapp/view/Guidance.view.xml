                                        </m:VBox>
                                        <m:VBox id="levelDRiskBox" alignItems="Start" class="sapUiTinyMargin">
                                            <m:Label id="levelDRiskLabel" text="Technical Risk" class="sapUiTinyMarginBottom" />
                                            <m:Text id="levelDRiskText" text="{guidance>/levelD/technicalRisk}" />
                                        </m:VBox>
                                    </m:HBox>
                                </m:VBox>
                            </m:VBox>
                        </blocks>
                    </ObjectPageSubSection>
                    
                    <!-- Summary Table for all levels -->
                    <ObjectPageSubSection id="levelsSummarySubSection" title="Summary Table">
                        <blocks>
                            <m:Table
                                id="levelsSummaryTable"
                                items="{guidance>/levels}"
                                width="auto"
                                growing="false"
                            >
                                <m:columns>
                                    <m:Column id="levelColumn" width="5em"><m:Text id="levelColumnHeader" text="Level" /></m:Column>
                                    <m:Column id="descriptionColumn"><m:Text id="descriptionColumnHeader" text="Description" /></m:Column>
                                    <m:Column id="technologyColumn"><m:Text id="technologyColumnHeader" text="Technology" /></m:Column>
                                    <m:Column id="upgradeComplexityColumn"><m:Text id="upgradeComplexityColumnHeader" text="Upgrade Complexity" /></m:Column>
                                    <m:Column id="maintenanceEffortColumn"><m:Text id="maintenanceEffortColumnHeader" text="Maintenance Effort" /></m:Column>
                                    <m:Column id="cloudReadinessColumn"><m:Text id="cloudReadinessColumnHeader" text="Cloud Readiness" /></m:Column>
                                    <m:Column id="technicalRiskColumn"><m:Text id="technicalRiskColumnHeader" text="Technical Risk" /></m:Column>
                                </m:columns>
                                <m:items>
                                    <m:ColumnListItem id="levelsSummaryTableItem">
                                        <m:cells>
                                            <m:Text id="levelCell" text="{guidance>level}" />
                                            <m:Text id="descriptionCell" text="{guidance>description}" />
                                            <m:Text id="technologyCell" text="{guidance>technology}" />
                                            <m:Text id="upgradeComplexityCell" text="{guidance>upgradeComplexity}" />
                                            <m:Text id="maintenanceEffortCell" text="{guidance>maintenanceEffort}" />
                                            <m:Text id="cloudReadinessCell" text="{guidance>cloudReadiness}" />
                                            <m:Text id="technicalRiskCell" text="{guidance>technicalRisk}" />
                                        </m:cells>
                                    </m:ColumnListItem>
                                </m:items>
                            </m:Table>
                        </blocks>
