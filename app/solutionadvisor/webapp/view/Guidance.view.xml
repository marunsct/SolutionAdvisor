<mvc:View
    controllerName="sd.solutionadvisor.controller.Guidance"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.uxap"
    xmlns:m="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    displayBlock="true"
>
    <ObjectPageLayout
        id="guidanceObjectPage"
        enableLazyLoading="false"
        showTitleInHeaderContent="false"
        alwaysShowContentHeader="false"
        upperCaseAnchorBar="false"
        flexEnabled="false"
    >
        <headerTitle>
            <ObjectPageHeader
                id="guidanceHeader"
                objectTitle="{guidance>/guidance/title}"
                objectSubtitle="Clean Core Educational Content"
            />
        </headerTitle>
        
        <headerContent>
            <m:VBox id="headerContentVBox">
                <m:FormattedText id="introductionText" htmlText="{guidance>/guidance/introduction}" class="sapUiSmallMarginBottom" />
                <m:FormattedText
                    id="apiExplanationText"
                    htmlText="{guidance>/guidance/apiExplanation}"
                    visible="{= ${guidance>/guidance/apiExplanation} !== null &amp;&amp; ${guidance>/guidance/apiExplanation} !== '' }"
                />
            </m:VBox>
        </headerContent>
        
        <sections>
            <!-- Section 1: Clean Core Levels - Detailed Breakdown -->
            <ObjectPageSection id="levelsSection" title="Clean Core Levels - Detailed Breakdown">
                <subSections>
                    <!-- Level A -->
                    <ObjectPageSubSection id="levelASubSection" title="{= ${guidance>/levelA/title} || '🟩 Level A - Cleanest (Gold Standard)' }">
                        <blocks>
                            <m:VBox id="levelAVBox" class="sapUiNoMargin">
                                <m:VBox id="levelAContentBox" class="sapUiTinyMarginBottom">
                                    <m:Label id="levelAWhatLabel" text="What it means:" design="Bold" class="sapUiTinyMarginBottom" />
                                    <m:FormattedText id="levelAWhatText" htmlText="{guidance>/levelA/whatItMeans}" class="sapUiTinyMarginBottom" />
                                </m:VBox>
                                
                                <m:VBox id="levelAAnalogyBox" class="sapUiTinyMarginBottom">
                                    <m:Label id="levelAAnalogyLabel" text="Beginner Analogy:" design="Bold" class="sapUiTinyMarginBottom" />
                                    <m:FormattedText id="levelAAnalogyText" htmlText="{guidance>/levelA/beginnerAnalogy}" class="sapUiTinyMarginBottom" />
                                </m:VBox>
                                
                                <m:VBox id="levelAToolsBox" class="sapUiTinyMarginBottom">
                                    <m:Label id="levelAToolsLabel" text="Tools You Use:" design="Bold" class="sapUiTinyMarginBottom" />
                                    <m:FormattedText id="levelAToolsText" htmlText="{guidance>/levelA/toolsUsed}" class="sapUiTinyMarginBottom" />
                                </m:VBox>
                                
                                <m:VBox id="levelAExampleBox" class="sapUiTinyMarginBottom">
                                    <m:Label id="levelAExampleLabel" text="Example:" design="Bold" class="sapUiTinyMarginBottom" />
                                    <m:FormattedText id="levelAExampleText" htmlText="{guidance>/levelA/exampleReport}" class="sapUiTinyMarginBottom" />
                                </m:VBox>
                                
                                <m:VBox id="levelAWhyBox" class="sapUiTinyMarginBottom">
                                    <m:Label id="levelAWhyLabel" text="Why it's best:" design="Bold" class="sapUiTinyMarginBottom" />
                                    <m:FormattedText id="levelAWhyText" htmlText="{guidance>/levelA/whyReasoning}" class="sapUiTinyMarginBottom" />
                                </m:VBox>
                                
                                <m:VBox id="levelADescBox" class="sapUiTinyMarginBottom">
                                    <m:Label id="levelADescLabel" text="Description:" design="Bold" class="sapUiTinyMarginBottom" />
                                    <m:FormattedText id="levelADescText" htmlText="{guidance>/levelA/description}" class="sapUiTinyMarginBottom" />
                                </m:VBox>
                                
                                <m:VBox id="levelATechBox" class="sapUiTinyMarginBottom">
                                    <m:Label id="levelATechLabel" text="Technology:" design="Bold" class="sapUiTinyMarginBottom" />
                                    <m:FormattedText id="levelATechText" htmlText="{guidance>/levelA/technology}" class="sapUiTinyMarginBottom" />
                                </m:VBox>
                                
                                <!-- Metrics -->
                                <m:VBox id="levelAMetricsContainer" class="sapUiTinyMarginTop">
                                    <m:Label id="levelAMetricsTitle" text="Key Metrics" design="Bold" class="sapUiTinyMarginBottom" />
                                    <m:HBox id="levelAMetricsBox" justifyContent="SpaceBetween" width="100%">
                                        <m:VBox id="levelAUpgradeBox" alignItems="Start" class="sapUiTinyMargin">
                                            <m:Label id="levelAUpgradeLabel" text="Upgrade Complexity" class="sapUiTinyMarginBottom" />
                                            <m:Text id="levelAUpgradeText" text="{guidance>/levelA/upgradeComplexity}" />
                                        </m:VBox>
                                        <m:VBox id="levelAMaintenanceBox" alignItems="Start" class="sapUiTinyMargin">
                                            <m:Label id="levelAMaintenanceLabel" text="Maintenance Effort" class="sapUiTinyMarginBottom" />
                                            <m:Text id="levelAMaintenanceText" text="{guidance>/levelA/maintenanceEffort}" />
                                        </m:VBox>
                                        <m:VBox id="levelACloudBox" alignItems="Start" class="sapUiTinyMargin">
                                            <m:Label id="levelACloudLabel" text="Cloud Readiness" class="sapUiTinyMarginBottom" />
                                            <m:Text id="levelACloudText" text="{guidance>/levelA/cloudReadiness}" />
                                        </m:VBox>
                                        <m:VBox id="levelARiskBox" alignItems="Start" class="sapUiTinyMargin">
                                            <m:Label id="levelARiskLabel" text="Technical Risk" class="sapUiTinyMarginBottom" />
                                            <m:Text id="levelARiskText" text="{guidance>/levelA/technicalRisk}" />
                                        </m:VBox>
                                    </m:HBox>
                                </m:VBox>
                            </m:VBox>
                        </blocks>
                    </ObjectPageSubSection>
                    
                    <!-- Level B -->
                    <ObjectPageSubSection id="levelBSubSection" title="{= ${guidance>/levelB/title} || '🟦 Level B - Classic but Acceptable' }">
                        <blocks>
                            <m:VBox id="levelBVBox" class="sapUiNoMargin">
                                <m:VBox id="levelBContentBox" class="sapUiSmallMarginBottom">
                                    <m:Label id="levelBWhatLabel" text="What it means:" design="Bold" class="sapUiTinyMarginBottom" />
                                    <m:FormattedText id="levelBWhatText" htmlText="{guidance>/levelB/whatItMeans}" class="sapUiSmallMarginBottom" />
                                </m:VBox>
                                
                                <m:VBox id="levelBAnalogyBox" class="sapUiSmallMarginBottom">
                                    <m:Label id="levelBAnalogyLabel" text="Beginner Analogy:" design="Bold" class="sapUiTinyMarginBottom" />
                                    <m:FormattedText id="levelBAnalogyText" htmlText="{guidance>/levelB/beginnerAnalogy}" class="sapUiSmallMarginBottom" />
                                </m:VBox>
                                
                                <m:VBox id="levelBToolsBox" class="sapUiSmallMarginBottom">
                                    <m:Label id="levelBToolsLabel" text="Tools You Use:" design="Bold" class="sapUiTinyMarginBottom" />
                                    <m:FormattedText id="levelBToolsText" htmlText="{guidance>/levelB/toolsUsed}" class="sapUiSmallMarginBottom" />
                                </m:VBox>
                                
                                <m:VBox id="levelBExampleBox" class="sapUiSmallMarginBottom">
                                    <m:Label id="levelBExampleLabel" text="Example:" design="Bold" class="sapUiTinyMarginBottom" />
                                    <m:FormattedText id="levelBExampleText" htmlText="{guidance>/levelB/exampleReport}" class="sapUiSmallMarginBottom" />
                                </m:VBox>
                                
                                <m:VBox id="levelBWhyBox" class="sapUiSmallMarginBottom">
                                    <m:Label id="levelBWhyLabel" text="Why it's acceptable:" design="Bold" class="sapUiTinyMarginBottom" />
                                    <m:FormattedText id="levelBWhyText" htmlText="{guidance>/levelB/whyReasoning}" class="sapUiSmallMarginBottom" />
                                </m:VBox>
                                
                                <m:VBox id="levelBDescBox" class="sapUiSmallMarginBottom">
                                    <m:Label id="levelBDescLabel" text="Description:" design="Bold" class="sapUiTinyMarginBottom" />
                                    <m:FormattedText id="levelBDescText" htmlText="{guidance>/levelB/description}" class="sapUiSmallMarginBottom" />
                                </m:VBox>
                                
                                <m:VBox id="levelBTechBox" class="sapUiSmallMarginBottom">
