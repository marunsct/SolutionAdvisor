                                    <m:FormattedText id="levelCToolsText" htmlText="{guidance>/levelC/toolsUsed}" class="sapUiSmallMarginBottom" />
                                </m:VBox>
                                
                                <m:VBox id="levelCExampleBox" class="sapUiSmallMarginBottom">
                                    <m:Label id="levelCExampleLabel" text="Example:" design="Bold" class="sapUiTinyMarginBottom" />
                                    <m:FormattedText id="levelCExampleText" htmlText="{guidance>/levelC/exampleReport}" class="sapUiSmallMarginBottom" />
                                </m:VBox>
                                
                                <m:VBox id="levelCWhyBox" class="sapUiSmallMarginBottom">
                                    <m:Label id="levelCWhyLabel" text="Why it's risky:" design="Bold" class="sapUiTinyMarginBottom" />
                                    <m:FormattedText id="levelCWhyText" htmlText="{guidance>/levelC/whyReasoning}" class="sapUiSmallMarginBottom" />
                                </m:VBox>
                                
                                <m:VBox id="levelCDescBox" class="sapUiSmallMarginBottom">
                                    <m:Label id="levelCDescLabel" text="Description:" design="Bold" class="sapUiTinyMarginBottom" />
                                    <m:FormattedText id="levelCDescText" htmlText="{guidance>/levelC/description}" class="sapUiSmallMarginBottom" />
                                </m:VBox>
                                
                                <m:VBox id="levelCTechBox" class="sapUiSmallMarginBottom">
                                    <m:Label id="levelCTechLabel" text="Technology:" design="Bold" class="sapUiTinyMarginBottom" />
                                    <m:FormattedText id="levelCTechText" htmlText="{guidance>/levelC/technology}" class="sapUiSmallMarginBottom" />
                                </m:VBox>
                                
                                <!-- Metrics -->
                                <m:VBox id="levelCMetricsContainer" class="sapUiMediumMarginTop">
                                    <m:Label id="levelCMetricsTitle" text="Key Metrics" design="Bold" class="sapUiTinyMarginBottom" />
                                    <m:HBox id="levelCMetricsBox" justifyContent="SpaceBetween" width="100%">
                                        <m:VBox id="levelCUpgradeBox" alignItems="Start" class="sapUiTinyMargin">
                                            <m:Label id="levelCUpgradeLabel" text="Upgrade Complexity" class="sapUiTinyMarginBottom" />
                                            <m:Text id="levelCUpgradeText" text="{guidance>/levelC/upgradeComplexity}" />
                                        </m:VBox>
                                        <m:VBox id="levelCMaintenanceBox" alignItems="Start" class="sapUiTinyMargin">
                                            <m:Label id="levelCMaintenanceLabel" text="Maintenance Effort" class="sapUiTinyMarginBottom" />
                                            <m:Text id="levelCMaintenanceText" text="{guidance>/levelC/maintenanceEffort}" />
                                        </m:VBox>
                                        <m:VBox id="levelCCloudBox" alignItems="Start" class="sapUiTinyMargin">
                                            <m:Label id="levelCCloudLabel" text="Cloud Readiness" class="sapUiTinyMarginBottom" />
                                            <m:Text id="levelCCloudText" text="{guidance>/levelC/cloudReadiness}" />
                                        </m:VBox>
                                        <m:VBox id="levelCRiskBox" alignItems="Start" class="sapUiTinyMargin">
                                            <m:Label id="levelCRiskLabel" text="Technical Risk" class="sapUiTinyMarginBottom" />
                                            <m:Text id="levelCRiskText" text="{guidance>/levelC/technicalRisk}" />
                                        </m:VBox>
                                    </m:HBox>
                                </m:VBox>
                            </m:VBox>
                        </blocks>
                    </ObjectPageSubSection>
                    
                    <!-- Level D -->
                    <ObjectPageSubSection id="levelDSubSection" title="{= ${guidance>/levelD/title} || '🟥 Level D - Do Not Do This (Modifications)' }">
                        <blocks>
                            <m:VBox id="levelDVBox" class="sapUiNoMargin">
                                <m:VBox id="levelDContentBox" class="sapUiSmallMarginBottom">
                                    <m:Label id="levelDWhatLabel" text="What it means:" design="Bold" class="sapUiTinyMarginBottom" />
                                    <m:FormattedText id="levelDWhatText" htmlText="{guidance>/levelD/whatItMeans}" class="sapUiSmallMarginBottom" />
                                </m:VBox>
                                
                                <m:VBox id="levelDAnalogyBox" class="sapUiSmallMarginBottom">
                                    <m:Label id="levelDAnalogyLabel" text="Beginner Analogy:" design="Bold" class="sapUiTinyMarginBottom" />
