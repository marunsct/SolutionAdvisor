                                    <m:FormattedText id="levelBTechText" htmlText="{guidance>/levelB/technology}" class="sapUiSmallMarginBottom" />
                                </m:VBox>
                                
                                <!-- Metrics -->
                                <m:VBox id="levelBMetricsContainer" class="sapUiMediumMarginTop">
                                    <m:Label id="levelBMetricsTitle" text="Key Metrics" design="Bold" class="sapUiTinyMarginBottom" />
                                    <m:HBox id="levelBMetricsBox" justifyContent="SpaceBetween" width="100%">
                                        <m:VBox id="levelBUpgradeBox" alignItems="Start" class="sapUiTinyMargin">
