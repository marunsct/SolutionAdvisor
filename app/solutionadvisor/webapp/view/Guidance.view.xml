                                    <m:Label id="levelDMetricsTitle" text="Key Metrics" design="Bold" class="sapUiTinyMarginBottom" />
                                    <m:HBox id="levelDMetricsBox" justifyContent="SpaceBetween" width="100%">
                                        <m:VBox id="levelDUpgradeBox" alignItems="Start" class="sapUiTinyMargin">
                                            <m:Label id="levelDUpgradeLabel" text="Upgrade Complexity" class="sapUiTinyMarginBottom" />
