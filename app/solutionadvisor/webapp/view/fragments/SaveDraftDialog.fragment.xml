<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="saveDraftDialog"
        title="Save Analysis Draft"
        contentWidth="500px">
        <content>
            <VBox class="sapUiSmallMargin">
                <MessageStrip
                    text="Save your current progress and resume this analysis later. The session will remain active for 24 hours."
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"/>
                
                <Label text="Draft Name (Optional):" class="sapUiTinyMarginTop"/>
                <Input
                    id="draftNameInput"
                    placeholder="Enter a name to identify this draft..."
                    width="100%"/>
                
                <VBox class="sapUiSmallMarginTop">
                    <Label text="Current Progress:" design="Bold"/>
                    <HBox class="sapUiTinyMarginTop">
                        <Label text="Questions Answered:"/>
                        <Text text="{draftModel>/currentStep} / {draftModel>/totalSteps}" class="sapUiTinyMarginBegin"/>
                    </HBox>
                    <HBox class="sapUiTinyMarginTop">
                        <Label text="Time Spent:"/>
                        <Text text="{draftModel>/timeSpent} minutes" class="sapUiTinyMarginBegin"/>
                    </HBox>
                </VBox>
            </VBox>
        </content>
        <beginButton>
            <Button
                text="Save Draft"
                type="Emphasized"
                press=".onConfirmSaveDraft"/>
        </beginButton>
        <endButton>
            <Button
                text="Cancel"
                press=".onCancelSaveDraft"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
