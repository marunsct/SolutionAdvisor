<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout">

    <Dialog 
        id="scoringDrillDownDialog" 
        title="Scoring Breakdown - Detailed Analysis"
        contentWidth="60rem"
        contentHeight="40rem"
        resizable="true"
        draggable="true">
        
        <content>
            <ScrollContainer id="scoringDrillDownScrollContainer" height="100%" class="sapUiSmallMargin">
                <VBox id="scoringDrillDownMainVBox" class="sapUiSmallMargin">
                    
                    <!-- Analysis Summary Header -->
                    <Panel id="analysisSummaryPanel" headerText="Analysis Summary" class="sapUiSmallMarginBottom">
                        <layout:Grid id="analysisSummaryGrid" defaultSpan="XL6 L6 M12 S12" class="sapUiSmallMargin">
                            <VBox id="scoringRicefwIdVBox" class="sapUiTinyMargin">
                                <Label id="scoringRicefwIdLabel" text="RICEFW ID" class="sapUiTinyMarginBottom"/>
                                <Text id="scoringRicefwIdText" text="{scoring>/ricefwId}" class="sapUiMediumText"/>
                            </VBox>
                            <VBox id="scoringObjectTypeVBox" class="sapUiTinyMargin">
                                <Label id="scoringObjectTypeLabel" text="Object Type" class="sapUiTinyMarginBottom"/>
                                <Text id="scoringObjectTypeText" text="{scoring>/objectType}" class="sapUiMediumText"/>
                            </VBox>
                            <VBox id="scoringRecommendedLevelVBox" class="sapUiTinyMargin">
                                <Label id="scoringRecommendedLevelLabel" text="Recommended Level" class="sapUiTinyMarginBottom"/>
                                <ObjectStatus id="scoringRecommendedLevelStatus" text="{scoring>/recommendedLevel}"
                                    state="{
                                        path: 'scoring>/recommendedLevel',
                                        formatter: '.formatLevelState'
                                    }"/>
                            </VBox>
                            <VBox id="scoringAnalysisDateVBox" class="sapUiTinyMargin">
                                <Label id="scoringAnalysisDateLabel" text="Analysis Date" class="sapUiTinyMarginBottom"/>
                                <Text id="scoringAnalysisDateText" text="{
                                    path: 'scoring>/analysisDate',
                                    type: 'sap.ui.model.odata.type.DateTimeOffset'
                                }" class="sapUiMediumText"/>
                            </VBox>
                        </layout:Grid>
                    </Panel>

                    <!-- Technical Debt Breakdown -->
                    <Panel id="techDebtPanel" headerText="Technical Debt Score Breakdown" 
                        expandable="true" 
                        expanded="true"
                        class="sapUiSmallMarginBottom">
                        <content>
                            <VBox id="techDebtMainVBox" class="sapUiSmallMargin">
                                <!-- Formula Explanation -->
                                <VBox id="techDebtFormulaVBox" class="sapUiSmallMarginBottom">
                                    <Label id="techDebtFormulaLabel" text="Calculation Formula:" class="sapUiTinyMarginBottom"/>
                                    <FormattedText id="techDebtFormula"
                                        htmlText="&lt;strong&gt;Technical Debt = Σ(Level Weight × Complexity Factor) ÷ Total Steps × 100&lt;/strong&gt;"
                                        class="sapUiMediumText"/>
                                    <Text id="techDebtWeightsText" text="Level Weights: A = 0.00, B = 1.00, C = 3.00, D = 5.00" class="sapUiTinyText sapUiTinyMarginTop"/>
                                </VBox>

                                <!-- Breakdown Table -->
                                <Table id="techDebtTable" items="{scoring>/technicalDebtBreakdown}" 
                                    mode="None"
                                    growing="true"
                                    growingThreshold="20">
                                    <columns>
                                        <Column id="techDebtStepColumn" width="8rem">
                                            <Text id="techDebtStepHeader" text="Step #"/>
                                        </Column>
                                        <Column id="techDebtDecisionColumn">
                                            <Text id="techDebtDecisionHeader" text="Decision Point"/>
                                        </Column>
                                        <Column id="techDebtLevelColumn" width="6rem">
                                            <Text id="techDebtLevelHeader" text="Level"/>
                                        </Column>
                                        <Column id="techDebtWeightColumn" width="6rem" hAlign="Center">
                                            <Text id="techDebtWeightHeader" text="Weight"/>
                                        </Column>
                                        <Column id="techDebtFactorColumn" width="6rem" hAlign="Center">
                                            <Text id="techDebtFactorHeader" text="Factor"/>
                                        </Column>
                                        <Column id="techDebtContributionColumn" width="8rem" hAlign="End">
                                            <Text id="techDebtContributionHeader" text="Contribution"/>
                                        </Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem id="techDebtItem">
                                            <cells>
                                                <Text id="techDebtStepOrderText" text="{scoring>stepOrder}"/>
                                                <Text id="techDebtDescriptionText" text="{scoring>stepDescription}" maxLines="2"/>
                                                <ObjectStatus id="techDebtLevelStatus" text="{scoring>level}"
                                                    state="{
                                                        path: 'scoring>level',
                                                        formatter: '.formatLevelState'
                                                    }"/>
                                                <Text id="techDebtWeightText" text="{scoring>weight}" class="sapUiMediumText"/>
                                                <Text id="techDebtFactorText" text="{scoring>factor}" class="sapUiMediumText"/>
                                                <ObjectNumber id="techDebtContributionNumber" number="{scoring>contribution}" 
                                                    unit="pts" 
                                                    state="{= ${scoring>contribution} > 3 ? 'Error' : ${scoring>contribution} > 1 ? 'Warning' : 'Success'}"/>
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>

                                <!-- Summary Row -->
                                <HBox id="techDebtSummaryHBox" justifyContent="End" alignItems="Center" class="sapUiSmallMarginTop">
                                    <Label id="techDebtSummaryLabel" text="Total Technical Debt Score:" class="sapUiMediumMarginEnd"/>
                                    <ObjectNumber id="techDebtSummaryNumber"
                                        number="{scoring>/finalTechnicalDebtScore}" 
                                        unit="%"
                                        state="{
                                            path: 'scoring>/finalTechnicalDebtScore',
                                            formatter: '.formatScoreState'
                                        }"
                                        emphasized="true"/>
                                </HBox>
                            </VBox>
                        </content>
                    </Panel>

                    <!-- Cloud Readiness Breakdown -->
                    <Panel id="cloudReadinessPanel" headerText="Cloud Readiness Score Breakdown" 
                        expandable="true" 
                        expanded="false"
                        class="sapUiSmallMarginBottom">
                        <content>
                            <VBox id="cloudReadinessMainVBox" class="sapUiSmallMargin">
                                <!-- Formula Explanation -->
                                <VBox id="cloudReadinessFormulaVBox" class="sapUiSmallMarginBottom">
                                    <Label id="cloudReadinessFormulaLabel" text="Calculation Formula:" class="sapUiTinyMarginBottom"/>
                                    <FormattedText id="cloudReadinessFormula"
                                        htmlText="&lt;strong&gt;Cloud Readiness = (Count Level A + 0.5 × Count Level B) ÷ Total × 100&lt;/strong&gt;"
                                        class="sapUiMediumText"/>
                                    <Text id="cloudReadinessHintText" text="Level A solutions are fully cloud-ready, Level B are partially ready" class="sapUiTinyText sapUiTinyMarginTop"/>
                                </VBox>

                                <!-- Cloud Readiness Factors -->
                                <layout:Grid id="cloudReadinessGrid" defaultSpan="XL4 L4 M6 S12" class="sapUiSmallMargin">
                                    <VBox id="cloudLevelAVBox" class="sapUiTinyMargin">
                                        <Label id="cloudLevelALabel" text="Level A Count" class="sapUiTinyMarginBottom"/>
                                        <ObjectNumber id="cloudLevelANumber" number="{scoring>/cloudReadiness/levelACount}" emphasized="true"/>
                                    </VBox>
                                    <VBox id="cloudLevelBVBox" class="sapUiTinyMargin">
                                        <Label id="cloudLevelBLabel" text="Level B Count" class="sapUiTinyMarginBottom"/>
                                        <ObjectNumber id="cloudLevelBNumber" number="{scoring>/cloudReadiness/levelBCount}" emphasized="true"/>
                                    </VBox>
                                    <VBox id="cloudLevelCDVBox" class="sapUiTinyMargin">
                                        <Label id="cloudLevelCDLabel" text="Level C+D Count" class="sapUiTinyMarginBottom"/>
                                        <ObjectNumber id="cloudLevelCDNumber" number="{scoring>/cloudReadiness/levelCDCount}" state="Error" emphasized="true"/>
                                    </VBox>
                                </layout:Grid>

                                <!-- Summary Row -->
                                <HBox id="cloudReadinessSummaryHBox" justifyContent="End" alignItems="Center" class="sapUiSmallMarginTop">
                                    <Label id="cloudReadinessSummaryLabel" text="Final Cloud Readiness Score:" class="sapUiMediumMarginEnd"/>
                                    <ObjectNumber id="cloudReadinessSummaryNumber"
                                        number="{scoring>/finalCloudReadinessScore}" 
                                        unit="%"
                                        state="{
                                            path: 'scoring>/finalCloudReadinessScore',
                                            formatter: '.formatCloudReadinessState'
                                        }"
                                        emphasized="true"/>
                                </HBox>
                            </VBox>
                        </content>
                    </Panel>

                    <!-- Upgrade Impact Breakdown -->
                    <Panel id="upgradeImpactPanel" headerText="Upgrade Impact Score Breakdown" 
                        expandable="true" 
                        expanded="false"
                        class="sapUiSmallMarginBottom">
                        <content>
                            <VBox id="upgradeImpactMainVBox" class="sapUiSmallMargin">
                                <!-- Formula Explanation -->
                                <VBox id="upgradeImpactFormulaVBox" class="sapUiSmallMarginBottom">
                                    <Label id="upgradeImpactFormulaLabel" text="Calculation Formula:" class="sapUiTinyMarginBottom"/>
                                    <FormattedText id="upgradeImpactFormula"
                                        htmlText="&lt;strong&gt;Upgrade Impact = Σ(Level Weight × Custom Code Lines) ÷ Total Estimated Lines × 100&lt;/strong&gt;"
                                        class="sapUiMediumText"/>
                                    <Text id="upgradeImpactHintText" text="Higher scores indicate more custom code that may need modification during upgrades" class="sapUiTinyText sapUiTinyMarginTop"/>
                                </VBox>

                                <!-- Impact Factors -->
                                <layout:Grid id="upgradeImpactGrid" defaultSpan="XL3 L3 M6 S12" class="sapUiSmallMargin">
                                    <VBox id="customCodeVBox" class="sapUiTinyMargin">
                                        <Label id="customCodeLabel" text="Estimated Custom Code Lines" class="sapUiTinyMarginBottom"/>
                                        <ObjectNumber id="customCodeNumber" number="{scoring>/upgradeImpact/customCodeLines}" unit="LOC" emphasized="true"/>
                                    </VBox>
                                    <VBox id="standardFuncVBox" class="sapUiTinyMargin">
                                        <Label id="standardFuncLabel" text="Standard Functionality %" class="sapUiTinyMarginBottom"/>
                                        <ObjectNumber id="standardFuncNumber" number="{scoring>/upgradeImpact/standardFunctionality}" unit="%" state="Success" emphasized="true"/>
                                    </VBox>
                                    <VBox id="complexityMultiplierVBox" class="sapUiTinyMargin">
                                        <Label id="complexityMultiplierLabel" text="Complexity Multiplier" class="sapUiTinyMarginBottom"/>
                                        <ObjectNumber id="complexityMultiplierNumber" number="{scoring>/upgradeImpact/complexityMultiplier}" emphasized="true"/>
                                    </VBox>
                                </layout:Grid>

                                <!-- Summary Row -->
                                <HBox id="upgradeImpactSummaryHBox" justifyContent="End" alignItems="Center" class="sapUiSmallMarginTop">
                                    <Label id="upgradeImpactSummaryLabel" text="Final Upgrade Impact Score:" class="sapUiMediumMarginEnd"/>
                                    <ObjectNumber id="upgradeImpactSummaryNumber"
                                        number="{scoring>/finalUpgradeImpactScore}" 
                                        unit="%"
                                        state="{
                                            path: 'scoring>/finalUpgradeImpactScore',
                                            formatter: '.formatScoreState'
                                        }"
                                        emphasized="true"/>
                                </HBox>
                            </VBox>
                        </content>
                    </Panel>

                    <!-- Composite Health Score -->
                    <Panel id="compositeHealthPanel" headerText="Composite Health Score Calculation" 
                        expandable="true" 
                        expanded="false"
                        class="sapUiSmallMarginBottom">
                        <content>
                            <VBox id="compositeHealthMainVBox" class="sapUiSmallMargin">
                                <!-- Formula Explanation -->
                                <VBox id="compositeHealthFormulaVBox" class="sapUiSmallMarginBottom">
                                    <Label id="compositeHealthFormulaLabel" text="Calculation Formula:" class="sapUiTinyMarginBottom"/>
                                    <FormattedText id="compositeHealthFormula"
                                        htmlText="&lt;strong&gt;Composite Health = (Cloud Readiness × 0.4) + ((100 - Technical Debt) × 0.3) + ((100 - Upgrade Impact) × 0.3)&lt;/strong&gt;"
                                        class="sapUiMediumText"/>
                                    <Text id="compositeHealthHintText" text="Weighted average emphasizing cloud readiness with debt and impact as negative factors" class="sapUiTinyText sapUiTinyMarginTop"/>
                                </VBox>

                                <!-- Health Interpretation -->
                                <VBox id="healthInterpretationVBox" class="sapUiSmallMarginTop">
                                    <Text id="healthInterpretationTitle" text="Health Score Interpretation:" class="sapUiMediumText sapUiTinyMarginBottom"/>
                                    <Text id="healthExcellentText" text="• 80-100%: Excellent - Ready for cloud migration with minimal risks" class="sapUiTinyText"/>
                                    <Text id="healthGoodText" text="• 60-79%: Good - Some optimization needed before migration" class="sapUiTinyText"/>
                                    <Text id="healthFairText" text="• 40-59%: Fair - Significant improvements required" class="sapUiTinyText"/>
                                    <Text id="healthPoorText" text="• 0-39%: Poor - Major refactoring needed before cloud adoption" class="sapUiTinyText"/>
                                </VBox>

                                <!-- Summary Row -->
                                <HBox id="compositeHealthSummaryHBox" justifyContent="End" alignItems="Center" class="sapUiSmallMarginTop">
                                    <Label id="compositeHealthSummaryLabel" text="Final Composite Health Score:" class="sapUiMediumMarginEnd"/>
                                    <ObjectNumber id="compositeHealthSummaryNumber"
                                        number="{scoring>/finalCompositeHealthScore}" 
                                        unit="%"
                                        state="{
                                            path: 'scoring>/finalCompositeHealthScore',
                                            formatter: '.formatHealthState'
                                        }"
                                        emphasized="true"/>
                                </HBox>
                            </VBox>
                        </content>
                    </Panel>

                    <!-- Recommendations -->
                    <Panel id="recommendationsPanel" headerText="Optimization Recommendations" 
                        class="sapUiSmallMarginBottom">
                        <content>
                            <VBox id="recommendationsMainVBox" class="sapUiSmallMargin">
                                <List id="recommendationsList" items="{scoring>/recommendations}" mode="None">
                                    <StandardListItem id="recommendationItem"
                                        title="{scoring>title}" 
                                        description="{scoring>description}"
                                        info="{scoring>priority}"
                                        infoState="{scoring>priorityState}"
                                        icon="{scoring>icon}"/>
                                </List>
                            </VBox>
                        </content>
                    </Panel>
                </VBox>
            </ScrollContainer>
        </content>
        
        <buttons>
            <Button id="exportBreakdownButton" text="Export Breakdown" press="onExportBreakdown" icon="sap-icon://download"/>
            <Button id="saveAnalysisButton" text="Save Analysis" press="onSaveAnalysis" type="Emphasized" icon="sap-icon://save"/>
            <Button id="closeDrillDownButton" text="Close" press="onCloseDrillDown"/>
        </buttons>
  </Dialog>
</core:FragmentDefinition>
