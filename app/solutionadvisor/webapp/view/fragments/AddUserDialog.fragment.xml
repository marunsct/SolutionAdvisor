<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog
        id="addUserDialog"
        title="Add User to Project"
        contentWidth="500px">
        <content>
            <VBox id="addUserMainVBox" class="sapUiSmallMargin">
                <Label id="userEmailLabel" text="User Email" required="true"/>
                <Input
                    id="userEmailInput"
                    value="{addUserModel>/userEmail}"
                    placeholder="user@company.com"
                    type="Email"/>
                
                <Label id="userNameLabel" text="User Name" required="true" class="sapUiTinyMarginTop"/>
                <Input
                    id="userNameInput"
                    value="{addUserModel>/userName}"
                    placeholder="John Doe"/>
                
                <Label id="userIdLabel" text="User ID" required="true" class="sapUiTinyMarginTop"/>
                <Input
                    id="userIdInput"
                    value="{addUserModel>/userId}"
                    placeholder="User ID from BTP"/>
                
                <Label id="userRoleLabel" text="Role" required="true" class="sapUiTinyMarginTop"/>
                <Select
                    id="userRoleSelect"
                    selectedKey="{addUserModel>/role}">
                    <items>
                        <core:Item id="solutionArchitectItem" key="SolutionArchitect" text="Solution Architect (Read/Write)"/>
                        <core:Item id="developerItem" key="Developer" text="Developer (Read Only)"/>
                    </items>
                </Select>
            </VBox>
        </content>
        <beginButton>
            <Button
                id="confirmAddUserButton"
                text="Add User"
                type="Emphasized"
                press=".onConfirmAddUser"/>
        </beginButton>
        <endButton>
            <Button id="cancelAddUserButton" text="Cancel" press=".onCancelAddUser"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
