<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f">
    <Dialog
        id="manageUsersDialog"
        title="Manage Project Users"
        contentWidth="700px"
        contentHeight="600px"
        draggable="true"
        resizable="true">
        <content>
            <VBox id="manageUsersMainVBox" class="sapUiSmallMargin">
                <Toolbar id="manageUsersToolbar">
                    <Title id="assignedUsersTitle" text="Assigned Users" level="H4"/>
                    <ToolbarSpacer id="manageUsersToolbarSpacer"/>
                    <Button
                        id="addUserButton"
                        text="Add User"
                        icon="sap-icon://add"
                        press=".onAddUserToProject"
                        type="Emphasized"/>
                </Toolbar>
                
                <Table
                    id="projectUsersTable"
                    items="{projectUsersModel>/users}"
                    growing="true"
                    growingThreshold="20"
                    noDataText="No users assigned to this project">
                    <columns>
                        <Column id="userNameColumn" width="35%">
                            <Text id="userNameHeader" text="User Name"/>
                        </Column>
                        <Column id="userEmailColumn" width="30%">
                            <Text id="userEmailHeader" text="Email"/>
                        </Column>
                        <Column id="userRoleColumn" width="20%">
                            <Text id="userRoleHeader" text="Role"/>
                        </Column>
                        <Column id="userActionsColumn" width="15%">
                            <Text id="userActionsHeader" text="Actions"/>
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem id="userListItem-{projectUsersModel>userId}">
                            <cells>
                                <Text id="userNameText-{projectUsersModel>userId}" text="{projectUsersModel>userName}"/>
                                <Text id="userEmailText-{projectUsersModel>userId}" text="{projectUsersModel>userEmail}"/>
                                <ObjectStatus
                                    id="userRoleStatus-{projectUsersModel>userId}"
                                    text="{projectUsersModel>role}"
                                    state="{= ${projectUsersModel>role} === 'SolutionArchitect' ? 'Success' : 'Information' }"/>
                                <Button
                                    id="removeUserButton-{projectUsersModel>userId}"
                                    icon="sap-icon://delete"
                                    type="Reject"
                                    press=".onRemoveUserFromProject"
                                    tooltip="Remove user"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
        <endButton>
            <Button id="closeManageUsersButton" text="Close" press=".onCloseManageUsersDialog"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
