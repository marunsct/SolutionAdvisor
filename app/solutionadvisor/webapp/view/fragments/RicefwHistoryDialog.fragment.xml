<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:vizData="sap.viz.ui5.data"
    xmlns:vizFeeds="sap.viz.ui5.controls.common.feeds"
>
    <Dialog
        id="ricefwHistory_Dialog"
        title="RICEFW Object History - {historyModel>/ricefwId}"
        contentWidth="900px"
        contentHeight="700px"
        resizable="true"
        draggable="true"
    >
        <content>
            <l:VerticalLayout
                id="ricefwHistory_MainLayout"
                width="100%"
            >
                <!-- Summary Header -->
                <f:SimpleForm
                    id="ricefwHistory_SummaryForm"
                    editable="false"
                    layout="ResponsiveGridLayout"
                    labelSpanXL="4"
                    labelSpanL="4"
                    labelSpanM="4"
                    labelSpanS="12"
                    emptySpanXL="0"
                    emptySpanL="0"
                    emptySpanM="0"
                    emptySpanS="0"
                    columnsXL="2"
                    columnsL="2"
                    columnsM="1"
                >
                    <f:content>
                        <Label
                            id="ricefwHistory_RicefwIdLabel"
                            text="RICEFW ID"
                        />
                        <Text
                            id="ricefwHistory_RicefwIdText"
                            text="{historyModel>/ricefwId}"
                        />

                        <Label
                            id="ricefwHistory_ObjectTypeLabel"
                            text="Object Type"
                        />
                        <Text
                            id="ricefwHistory_ObjectTypeText"
                            text="{historyModel>/objectType}"
                        />

                        <Label
                            id="ricefwHistory_TotalAnalysesLabel"
                            text="Total Analyses"
                        />
                        <Text
                            id="ricefwHistory_TotalAnalysesText"
                            text="{historyModel>/totalAnalyses}"
                        />

                        <Label
                            id="ricefwHistory_LatestDecisionLabel"
                            text="Latest Decision"
                        />
                        <Text
                            id="ricefwHistory_LatestDecisionText"
                            text="{historyModel>/latestDecision}"
                        />

                        <Label
                            id="ricefwHistory_FirstAnalysisLabel"
                            text="First Analysis"
                        />
                        <Text
                            id="ricefwHistory_FirstAnalysisText"
                            text="{ path: 'historyModel>/firstAnalysisDate', type: 'sd.solutionadvisor.types.FlexibleDateTime', formatOptions: { pattern: 'yyyy-MM-dd' } }"
                        />

                        <Label
                            id="ricefwHistory_LastAnalysisLabel"
                            text="Last Analysis"
                        />
                        <Text
                            id="ricefwHistory_LastAnalysisText"
                            text="{ path: 'historyModel>/lastAnalysisDate', type: 'sd.solutionadvisor.types.FlexibleDateTime', formatOptions: { pattern: 'yyyy-MM-dd' } }"
                        />
                    </f:content>
                </f:SimpleForm>

                <Toolbar id="ricefwHistory_Toolbar">
                    <Title
                        id="ricefwHistory_TimelineTitle"
                        text="Decision Timeline"
                        level="H4"
                    />
                    <ToolbarSpacer id="ricefwHistory_ToolbarSpacer" />
                    <Button
                        id="ricefwHistory_ExportBtn"
                        text="Export"
                        icon="sap-icon://excel-attachment"
                        press=".onExportHistory"
                    />
                </Toolbar>

                <!-- Trend Chart -->
                <Panel
                    id="ricefwHistory_TrendChartPanel"
                    headerText="Clean Core Level Trend"
                    expandable="true"
                    expanded="true"
                    class="sapUiResponsiveMargin"
                >
                    <content>
                        <VBox
                            id="ricefwHistory_TrendChartBox"
                            height="250px"
                            width="100%"
                        >
                            <viz:VizFrame
                                id="ricefwHistory_TrendChart"
                                vizType="line"
                                width="100%"
                                height="100%"
                                uiConfig="{applicationSet:'fiori'}"
                                vizProperties="{
                                    title: {
                                        visible: false
                                    },
                                    plotArea: {
                                        dataLabel: {
                                            visible: true
                                        }
                                    },
                                    legend: {
                                        visible: true
                                    }
                                }"
                            >
                                <viz:dataset>
                                    <vizData:FlattenedDataset
                                        id="ricefwHistory_Dataset"
                                        data="{historyModel>/trendData}"
                                    >
                                        <vizData:dimensions>
                                            <vizData:DimensionDefinition
                                                id="ricefwHistory_DateDimension"
                                                name="Analysis Date"
                                                value="{historyModel>analysisDate}"
                                            />
                                        </vizData:dimensions>
                                        <vizData:measures>
                                            <vizData:MeasureDefinition
                                                id="ricefwHistory_LevelMeasure"
                                                name="Level Score"
                                                value="{historyModel>levelScore}"
                                            />
                                            <vizData:MeasureDefinition
                                                id="ricefwHistory_TechDebtMeasure"
                                                name="Technical Debt"
                                                value="{historyModel>technicalDebtScore}"
                                            />
                                            <vizData:MeasureDefinition
                                                id="ricefwHistory_CloudReadyMeasure"
                                                name="Cloud Readiness"
                                                value="{historyModel>cloudReadinessScore}"
                                            />
                                        </vizData:measures>
                                    </vizData:FlattenedDataset>
                                </viz:dataset>
                                <viz:feeds>
                                    <vizFeeds:FeedItem
                                        id="ricefwHistory_ValueFeed"
                                        uid="valueAxis"
                                        type="Measure"
                                        values="Level Score,Technical Debt,Cloud Readiness"
                                    />
                                    <vizFeeds:FeedItem
                                        id="ricefwHistory_CategoryFeed"
                                        uid="categoryAxis"
                                        type="Dimension"
                                        values="Analysis Date"
                                    />
                                </viz:feeds>
                            </viz:VizFrame>
                        </VBox>
                    </content>
                </Panel>

                <!-- History Timeline List -->
                <Panel
                    id="ricefwHistory_TimelinePanel"
                    headerText="Detailed History"
                    expandable="false"
                    class="sapUiResponsiveMargin"
                >
                    <content>
                        <Table
                            id="ricefwHistory_Table"
                            items="{
                                path: 'historyModel>/analyses',
                                sorter: {
                                    path: 'analysisDate',
                                    descending: true
                                }
                            }"
                            growing="true"
                            growingThreshold="10"
                            mode="SingleSelectMaster"
                            selectionChange=".onHistoryItemSelect"
                        >
                            <columns>
                                <Column
                                    id="ricefwHistory_DateColumn"
                                    width="12em"
                                >
                                    <Text
                                        id="ricefwHistory_DateHeader"
                                        text="Analysis Date"
                                    />
                                </Column>
                                <Column
                                    id="ricefwHistory_LevelColumn"
                                    width="8em"
                                >
                                    <Text
                                        id="ricefwHistory_LevelHeader"
                                        text="Level"
                                    />
                                </Column>
                                <Column
                                    id="ricefwHistory_TechDebtColumn"
                                    width="10em"
                                >
                                    <Text
                                        id="ricefwHistory_TechDebtHeader"
                                        text="Tech Debt"
                                    />
                                </Column>
                                <Column
                                    id="ricefwHistory_CloudReadyColumn"
                                    width="10em"
                                >
                                    <Text
                                        id="ricefwHistory_CloudReadyHeader"
                                        text="Cloud Ready"
                                    />
                                </Column>
                                <Column
                                    id="ricefwHistory_UpgradeColumn"
                                    width="10em"
                                >
                                    <Text
                                        id="ricefwHistory_UpgradeHeader"
                                        text="Upgrade Impact"
                                    />
                                </Column>
                                <Column
                                    id="ricefwHistory_AnalystColumn"
                                    width="12em"
                                >
                                    <Text
                                        id="ricefwHistory_AnalystHeader"
                                        text="Analyst"
                                    />
                                </Column>
                                <Column
                                    id="ricefwHistory_ActionsColumn"
                                    width="8em"
                                >
                                    <Text
                                        id="ricefwHistory_ActionsHeader"
                                        text="Actions"
                                    />
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem
                                    id="ricefwHistory_ListItem"
                                    type="Active"
                                >
                                    <cells>
                                        <VBox id="ricefwHistory_DateCell">
                                            <Text
                                                id="ricefwHistory_DateText"
                                                text="{
                                                path: 'historyModel>analysisDate',
                                                formatter: '.formatter.formatDate'
                                            }"
                                            />
                                            <ObjectStatus
                                                id="ricefwHistory_LatestStatus"
                                                text="{= ${historyModel>isLatest} ? 'Latest' : '' }"
                                                state="Success"
                                                visible="{historyModel>isLatest}"
                                            />
                                        </VBox>
                                        <ObjectStatus
                                            id="ricefwHistory_LevelStatus"
                                            text="{historyModel>recommendedLevel}"
                                            state="{= ${historyModel>recommendedLevel} === 'Level A' ? 'Success' :
                                                     ${historyModel>recommendedLevel} === 'Level B' ? 'Information' :
                                                     ${historyModel>recommendedLevel} === 'Level C' ? 'Warning' :
                                                     'Error' }"
                                        />
                                        <VBox id="ricefwHistory_TechDebtCell">
                                            <Text
                                                id="ricefwHistory_TechDebtText"
                                                text="{historyModel>technicalDebtScore}"
                                            />
                                            <ProgressIndicator
                                                id="ricefwHistory_TechDebtProgress"
                                                percentValue="{historyModel>technicalDebtScore}"
                                                displayValue="{historyModel>technicalDebtScore}%"
                                                state="{= ${historyModel>technicalDebtScore} > 70 ? 'Error' :
                                                         ${historyModel>technicalDebtScore} > 40 ? 'Warning' :
                                                         'Success' }"
                                            />
                                        </VBox>
                                        <VBox id="ricefwHistory_CloudReadyCell">
                                            <Text
                                                id="ricefwHistory_CloudReadyText"
                                                text="{historyModel>cloudReadinessScore}"
                                            />
                                            <ProgressIndicator
                                                id="ricefwHistory_CloudReadyProgress"
                                                percentValue="{historyModel>cloudReadinessScore}"
                                                displayValue="{historyModel>cloudReadinessScore}%"
                                                state="{= ${historyModel>cloudReadinessScore} > 70 ? 'Success' :
                                                         ${historyModel>cloudReadinessScore} > 40 ? 'Warning' :
                                                         'Error' }"
                                            />
                                        </VBox>
                                        <VBox id="ricefwHistory_UpgradeCell">
                                            <Text
                                                id="ricefwHistory_UpgradeText"
                                                text="{historyModel>upgradeImpactScore}"
                                            />
                                            <ProgressIndicator
                                                id="ricefwHistory_UpgradeProgress"
                                                percentValue="{historyModel>upgradeImpactScore}"
                                                displayValue="{historyModel>upgradeImpactScore}%"
                                                state="{= ${historyModel>upgradeImpactScore} > 70 ? 'Error' :
                                                         ${historyModel>upgradeImpactScore} > 40 ? 'Warning' :
                                                         'Success' }"
                                            />
                                        </VBox>
                                        <VBox id="ricefwHistory_AnalystCell">
                                            <Text
                                                id="ricefwHistory_AnalystText"
                                                text="{historyModel>createdBy}"
                                            />
                                            <Text
                                                id="ricefwHistory_ProjectText"
                                                text="{historyModel>projectName}"
                                                class="sapUiSmallMarginTop"
                                            />
                                        </VBox>
                                        <HBox id="ricefwHistory_ActionsCell">
                                            <Button
                                                id="ricefwHistory_ViewDetailsBtn"
                                                icon="sap-icon://detail-view"
                                                type="Transparent"
                                                tooltip="View Details"
                                                press=".onViewHistoryDetails"
                                            />
                                            <Button
                                                id="ricefwHistory_CopyAnalysisBtn"
                                                icon="sap-icon://copy"
                                                type="Transparent"
                                                tooltip="Copy Analysis"
                                                press=".onCopyAnalysis"
                                            />
                                        </HBox>
                                    </cells>

                                    <customData>
                                        <core:CustomData
                                            key="analysisId"
                                            value="{historyModel>ID}"
                                        />
                                    </customData>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </content>
                </Panel>
            </l:VerticalLayout>
        </content>

        <beginButton>
            <Button
                id="ricefwHistory_CloseBtn"
                text="Close"
                press=".onCloseHistoryDialog"
            />
        </beginButton>
    </Dialog>
</core:FragmentDefinition>
