<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout"
    xmlns:form="sap.ui.layout.form">
    
    <Dialog
        id="createQuestionFlowDialog"
        title="Create Question Flow"
        contentWidth="600px"
        contentHeight="500px"
        resizable="true"
        draggable="true">
        
        <content>
            <form:SimpleForm
                id="createQuestionForm"
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="4"
                labelSpanL="4"
                labelSpanM="4"
                labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="0"
                emptySpanL="0"
                emptySpanM="0"
                emptySpanS="0"
                columnsXL="1"
                columnsL="1"
                columnsM="1"
                singleContainerFullSize="false"
                class="sapUiSmallMargin">
                
                <form:content>
                    
                    <!-- Question ID -->
                    <Label id="questionIdLabel" text="Question ID" required="true"/>
                    <Input
                        id="questionIdInput"
                        value="{createModel>/questionId}"
                        placeholder="e.g., Q-INT-001"
                        required="true"
                        valueStateText="Format: Q-XXX-NNN"/>
                    
                    <!-- Object Type -->
                    <Label id="questionObjectTypeLabel" text="Object Type" required="true"/>
                    <ComboBox
                        id="objectTypeComboCreate"
                        selectedKey="{createModel>/objectType}"
                        required="true">
                        <items>
                            <core:Item id="reportsItem" key="R" text="Reports"/>
                            <core:Item id="interfacesItem" key="I" text="Interfaces"/>
                            <core:Item id="conversionsItem" key="C" text="Conversions"/>
                            <core:Item id="enhancementsItem" key="E" text="Enhancements"/>
                            <core:Item id="formsItem" key="F" text="Forms"/>
                            <core:Item id="workflowsItem" key="W" text="Workflows"/>
                        </items>
                    </ComboBox>
                    
                    <!-- Question Text -->
                    <Label id="questionTextLabel" text="Question Text" required="true"/>
                    <TextArea
                        id="questionTextArea"
                        value="{createModel>/questionText}"
                        rows="3"
                        placeholder="Enter the question to ask users..."
                        required="true"/>
                    
                    <!-- Question Hint -->
                    <Label id="questionHintLabel" text="Question Hint"/>
                    <TextArea
                        id="questionHintArea"
                        value="{createModel>/questionHint}"
                        rows="2"
                        placeholder="Short hint shown near the question"/>
                    
                    <!-- Answer Options (JSON) -->
                    <Label id="answerOptionsLabel" text="Answer Options (JSON)"/>
                    <TextArea
                        id="answerOptionsTextArea"
                        value="{createModel>/answerOptions}"
                        rows="4"
                        placeholder='[&#123;"key":"LOW","text":"Low volume"&#125;, &#123;"key":"HIGH","text":"High volume"&#125;]'/>
                    
                    <!-- Navigation Rules (JSON) -->
                    <Label id="navigationRulesLabel" text="Navigation Rules (JSON)"/>
                    <TextArea
                        id="navigationRulesTextArea"
                        value="{createModel>/navigationRules}"
                        rows="4"
                        placeholder='&#123;"LOW": &#123; "nextQuestion": "Q-INT-002", "finalAnswer": null &#125; &#125;'/>
                    
                    <!-- Detailed Hint -->
                    <Label id="detailedHintLabel" text="Detailed Hint"/>
                    <TextArea
                        id="detailedHintTextArea"
                        value="{createModel>/detailedHint}"
                        rows="2"
                        placeholder="Provide additional context or guidance..."/>
                    
                    <!-- Active -->
                    <Label id="activeLabel" text="Active"/>
                    <Switch
                        id="activeSwitch"
                        state="{createModel>/isActive}"
                        customTextOn="Yes"
                        customTextOff="No"/>
                    
                </form:content>
            </form:SimpleForm>
            
            <!-- Help Text -->
            <MessageStrip
                id="createQuestionHelpMessage"
                text="Tip: Use Download Template to see correct JSON format for Answers and Navigation Logic."
                type="Information"
                showIcon="true"
                class="sapUiSmallMargin"/>
        </content>
        
        <beginButton>
            <Button
                id="createQuestionConfirmButton"
                text="Create"
                type="Emphasized"
                press="onCreateConfirm"/>
        </beginButton>
        
        <endButton>
            <Button
                id="createQuestionCancelButton"
                text="Cancel"
                press="onCreateCancel"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
