<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout"
    xmlns:form="sap.ui.layout.form">
    
    <Dialog
        id="createQuestionFlowDialog"
        title="Create Question Flow"
        contentWidth="600px"
        contentHeight="500px"
        resizable="true"
        draggable="true">
        
        <content>
            <form:SimpleForm
                id="createQuestionForm"
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="4"
                labelSpanL="4"
                labelSpanM="4"
                labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="0"
                emptySpanL="0"
                emptySpanM="0"
                emptySpanS="0"
                columnsXL="1"
                columnsL="1"
                columnsM="1"
                singleContainerFullSize="false"
                class="sapUiSmallMargin">
                
                <form:content>
                    
                    <!-- Question Key -->
                    <Label id="questionKeyLabel" text="Question Key" required="true"/>
                    <Input
                        id="questionKeyInput"
                        value="{createModel>/questionKey}"
                        placeholder="e.g., Q-INT-001"
                        required="true"
                        valueStateText="Format: Q-XXX-NNN"/>
                    
                    <!-- Object Type -->
                    <Label id="questionObjectTypeLabel" text="Object Type" required="true"/>
                    <Select
                        id="objectTypeSelect"
                        selectedKey="{createModel>/objectType}"
                        required="true">
                        <items>
                            <core:Item id="reportsItem" key="R" text="Reports"/>
                            <core:Item id="interfacesItem" key="I" text="Interfaces"/>
                            <core:Item id="conversionsItem" key="C" text="Conversions"/>
                            <core:Item id="enhancementsItem" key="E" text="Enhancements"/>
                            <core:Item id="formsItem" key="F" text="Forms"/>
                            <core:Item id="workflowsItem" key="W" text="Workflows"/>
                        </items>
                    </Select>
                    
                    <!-- Question Text -->
                    <Label id="questionTextLabel" text="Question Text" required="true"/>
                    <TextArea
                        id="questionTextArea"
                        value="{createModel>/questionText}"
                        rows="3"
                        placeholder="Enter the question to ask users..."
                        required="true"/>
                    
                    <!-- Question Category -->
                    <Label id="categoryLabel" text="Category"/>
                    <Input
                        id="categoryInput"
                        value="{createModel>/questionCategory}"
                        placeholder="e.g., Volume, Complexity, Integration"/>
                    
                    <!-- Answer Type -->
                    <Label id="answerTypeLabel" text="Answer Type" required="true"/>
                    <Select
                        id="answerTypeSelect"
                        selectedKey="{createModel>/answerType}"
                        required="true">
                        <items>
                            <core:Item id="singleChoiceItem" key="SingleChoice" text="Single Choice"/>
                            <core:Item id="multiChoiceItem" key="MultiChoice" text="Multiple Choice"/>
                            <core:Item id="textInputItem" key="Text" text="Text Input"/>
                            <core:Item id="numberInputItem" key="Number" text="Number Input"/>
                            <core:Item id="yesNoItem" key="YesNo" text="Yes/No"/>
                        </items>
                    </Select>
                    
                    <!-- Answers (JSON) -->
                    <Label id="answersLabel" text="Answers (JSON)"/>
                    <TextArea
                        id="answersTextArea"
                        value="{createModel>/answers}"
                        rows="4"
                        placeholder='[{"key": "LOW", "text": "Low volume"}, {"key": "HIGH", "text": "High volume"}]'/>
                    
                    <!-- Navigation Logic (JSON) -->
                    <Label id="navigationLogicLabel" text="Navigation Logic (JSON)"/>
                    <TextArea
                        id="navigationLogicTextArea"
                        value="{createModel>/navigationLogic}"
                        rows="4"
                        placeholder='{"LOW": {"nextQuestion": "Q-INT-002", "finalAnswer": null}}'/>
                    
                    <!-- Detailed Hint -->
                    <Label id="questionHintLabel" text="Detailed Hint"/>
                    <TextArea
                        id="hintTextArea"
                        value="{createModel>/detailedHint}"
                        rows="2"
                        placeholder="Provide additional context or guidance..."/>
                    
                    <!-- Active -->
                    <Label id="activeLabel" text="Active"/>
                    <Switch
                        id="activeSwitch"
                        state="{createModel>/isActive}"
                        customTextOn="Yes"
                        customTextOff="No"/>
                    
                </form:content>
            </form:SimpleForm>
            
            <!-- Help Text -->
            <MessageStrip
                id="createQuestionHelpMessage"
                text="Tip: Use Download Template to see correct JSON format for Answers and Navigation Logic."
                type="Information"
                showIcon="true"
                class="sapUiSmallMargin"/>
        </content>
        
        <beginButton>
            <Button
                id="createQuestionConfirmButton"
                text="Create"
                type="Emphasized"
                press="onCreateConfirm"/>
        </beginButton>
        
        <endButton>
            <Button
                id="createQuestionCancelButton"
                text="Cancel"
                press="onCreateCancel"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
