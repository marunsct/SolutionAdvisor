<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Panel
        id="examplesPanel"
        headerText="Real-World Implementation Examples"
        expandable="true"
        expanded="false"
        busy="{examplesModel>/loading}"
        expand=".onExamplesPanelToggle"
        class="sapUiResponsiveMargin"
    >
        <content>
            <!-- Placeholder message before data is loaded -->
            <MessageStrip
                id="examplesPlaceholder"
                visible="{= !${examplesModel>/loaded} &amp;&amp; !${examplesModel>/loading} }"
                text="Expand this panel to view real-world implementation examples relevant to your scenario"
                type="Information"
                showIcon="true"
                class="sapUiSmallMargin"
            />
            
            <VBox id="examplesMainVBox" visible="{= ${examplesModel>/loaded} }">
                <MessageStrip
                    id="examplesInfoMessage"
                    text="These examples are matched to your scenario and can guide your implementation approach"
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"
                />

                <HBox
                    id="examplesFiltersHBox"
                    class="sapUiSmallMarginBottom"
                    alignItems="Center"
                >
                    <Label
                        id="industryFilterLabel"
                        text="Filter by Industry:"
                        class="sapUiTinyMarginEnd"
                    />
                    <ComboBox
                        id="industryFilter"
                        width="200px"
                        selectedKey="{examplesModel>/selectedIndustry}"
                        selectionChange=".onIndustryFilterChange"
                    >
                        <items>
                            <core:Item
                                id="industryAllItem"
                                key=""
                                text="All Industries"
                            />
                            <core:Item
                                id="industryRetailItem"
                                key="Retail"
                                text="Retail"
                            />
                            <core:Item
                                id="industryManufacturingItem"
                                key="Manufacturing"
                                text="Manufacturing"
                            />
                            <core:Item
                                id="industryHealthcareItem"
                                key="Healthcare"
                                text="Healthcare"
                            />
                            <core:Item
                                id="industryFinanceItem"
                                key="Finance"
                                text="Finance"
                            />
                            <core:Item
                                id="industryUtilitiesItem"
                                key="Utilities"
                                text="Utilities"
                            />
                            <core:Item
                                id="industryLogisticsItem"
                                key="Logistics"
                                text="Logistics"
                            />
                        </items>
                    </ComboBox>
                    <ToolbarSpacer id="examplesFilterSpacer" />
                    <Label
                        id="levelFilterLabel"
                        text="Filter by Level:"
                        class="sapUiTinyMarginEnd"
                    />
                    <SegmentedButton
                        id="levelFilter"
                        selectedKey="{examplesModel>/selectedLevel}"
                        selectionChange=".onLevelFilterChange"
                    >
                        <items>
                            <SegmentedButtonItem
                                id="levelAllItem"
                                key=""
                                text="All"
                            />
                            <SegmentedButtonItem
                                id="levelAItem"
                                key="Level A"
                                text="Level A"
                            />
                            <SegmentedButtonItem
                                id="levelBItem"
                                key="Level B"
                                text="Level B"
                            />
                            <SegmentedButtonItem
                                id="levelCItem"
                                key="Level C"
                                text="Level C"
                            />
                            <SegmentedButtonItem
                                id="levelDItem"
                                key="Level D"
                                text="Level D"
                            />
                        </items>
                    </SegmentedButton>
                </HBox>

                <List
                    id="examplesList"
                    items="{examplesModel>/examples}"
                    noDataText="No examples found for the current context. Try adjusting filters or continue without examples."
                >
                    <CustomListItem
                        id="examplesListItem"
                        type="Navigation"
                        press=".onShowExampleDetails"
                    >
                        <VBox id="examplesItemVBox" class="sapUiSmallMargin">
                            <HBox
                                id="examplesHeaderHBox"
                                justifyContent="SpaceBetween"
                                alignItems="Center"
                            >
                                <Title
                                    id="examplesItemTitle"
                                    text="{examplesModel>title}"
                                    level="H5"
                                />
                                <HBox id="examplesMetaHBox">
                                    <ObjectStatus
                                        id="examplesItemLevelStatus"
                                        text="{examplesModel>cleanCoreLevel}"
                                        state="{= ${examplesModel>cleanCoreLevel} === 'Level A' ? 'Success' : ${examplesModel>cleanCoreLevel} === 'Level B' ? 'Information' : 'Warning' }"
                                    />
                                    <Label
                                        id="examplesItemIndustryLabel"
                                        text="{examplesModel>industry}"
                                        class="sapUiTinyMarginBegin"
                                    />
                                </HBox>
                            </HBox>
                            <Text
                                id="examplesItemScenarioText"
                                text="{examplesModel>scenario}"
                                class="sapUiTinyMarginTop"
                            />
                            <VBox id="examplesItemChallengeVBox" class="sapUiTinyMarginTop">
                                <Label
                                    id="examplesItemChallengeLabel"
                                    text="Challenge:"
                                    design="Bold"
                                />
                                <Text
                                    id="examplesItemChallengeText"
                                    text="{examplesModel>challengeDescription}"
                                    maxLines="2"
                                />
                            </VBox>
                            <VBox id="examplesItemSolutionVBox" class="sapUiTinyMarginTop">
                                <Label
                                    id="examplesItemSolutionLabel"
                                    text="Solution Approach:"
                                    design="Bold"
                                />
                                <Text
                                    id="examplesItemSolutionText"
                                    text="{examplesModel>solutionDescription}"
                                    maxLines="2"
                                />
                            </VBox>
                            <HBox id="examplesItemMetricsHBox" class="sapUiTinyMarginTop">
                                <Label
                                    id="examplesItemVolumeLabel"
                                    text="Volume: "
                                    design="Bold"
                                />
                                <Text
                                    id="examplesItemVolumeText"
                                    text="{examplesModel>volumeHandled}"
                                    class="sapUiTinyMarginEnd"
                                />
                                <Label
                                    id="examplesItemPerfLabel"
                                    text="Performance: "
                                    design="Bold"
                                />
                                <Text
                                    id="examplesItemPerfText"
                                    text="{examplesModel>performanceAchieved}"
                                />
                            </HBox>
                            <Link
                                id="examplesItemDetailsLink"
                                text="View full details"
                                press=".onShowExampleDetails"
                                class="sapUiTinyMarginTop"
                            />
                        </VBox>
                    </CustomListItem>
                </List>

                <!-- No Examples Message -->
                <MessageStrip
                    id="noExamplesMessage"
                    visible="{= !${examplesModel>/examples} || ${examplesModel>/examples}.length === 0 }"
                    text="No real-world examples found for this specific context. You can proceed with standard implementation guidelines."
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginTop"
                />

                <!-- Example Details Dialog (not shown by default) -->
                <Dialog
                    id="exampleDetailsDialog"
                    title="{examplesModel>/selectedExample/title}"
                    contentWidth="600px"
                    contentHeight="70%"
                    verticalScrolling="true"
                    draggable="true"
                    resizable="true"
                >
                    <content>
                        <VBox
                            id="exampleDetailsMainVBox"
                            class="sapUiSmallMargin"
                        >
                            <VBox
                                id="exampleDetailsScenarioVBox"
                                class="sapUiSmallMarginBottom"
                            >
                                <Label
                                    id="exampleDetailsScenarioLabel"
                                    text="Scenario:"
                                    design="Bold"
                                />
                                <Text
                                    id="exampleDetailsScenarioText"
                                    text="{examplesModel>/selectedExample/scenario}"
                                />
                            </VBox>
                            <VBox
                                id="exampleDetailsIndustryVBox"
                                class="sapUiSmallMarginBottom"
                            >
                                <Label
                                    id="exampleDetailsIndustryLabel"
                                    text="Industry:"
                                    design="Bold"
                                />
                                <Text
                                    id="exampleDetailsIndustryText"
                                    text="{examplesModel>/selectedExample/industry}"
                                />
                            </VBox>
                            <VBox
                                id="exampleDetailsLevelVBox"
                                class="sapUiSmallMarginBottom"
                            >
                                <Label
                                    id="exampleDetailsLevelLabel"
                                    text="Clean Core Level:"
                                    design="Bold"
                                />
                                <ObjectStatus
                                    id="exampleDetailsLevelStatus"
                                    text="{examplesModel>/selectedExample/cleanCoreLevel}"
                                    state="{= ${examplesModel>/selectedExample/cleanCoreLevel} === 'Level A' ? 'Success' : 'Information' }"
                                />
                            </VBox>
                            <VBox
                                id="exampleDetailsChallengeVBox"
                                class="sapUiSmallMarginBottom"
                            >
                                <Label
                                    id="exampleDetailsChallengeLabel"
                                    text="Challenge:"
                                    design="Bold"
                                />
                                <Text
                                    id="exampleDetailsChallengeText"
                                    text="{examplesModel>/selectedExample/challengeDescription}"
                                />
                            </VBox>
                            <VBox
                                id="exampleDetailsSolutionVBox"
                                class="sapUiSmallMarginBottom"
                            >
                                <Label
                                    id="exampleDetailsSolutionLabel"
                                    text="Solution:"
                                    design="Bold"
                                />
                                <Text
                                    id="exampleDetailsSolutionText"
                                    text="{examplesModel>/selectedExample/solutionDescription}"
                                />
                            </VBox>
                            <VBox
                                id="exampleDetailsTechnologiesVBox"
                                class="sapUiSmallMarginBottom"
                            >
                                <Label
                                    id="exampleDetailsTechnologiesLabel"
                                    text="Technologies Used:"
                                    design="Bold"
                                />
                                <Text
                                    id="exampleDetailsTechnologiesText"
                                    text="{examplesModel>/selectedExample/technologiesUsed}"
                                />
                            </VBox>
                            <VBox
                                id="exampleDetailsImplementationVBox"
                                class="sapUiSmallMarginBottom"
                            >
                                <Label
                                    id="exampleDetailsImplementationLabel"
                                    text="Implementation Details:"
                                    design="Bold"
                                />
                                <Text
                                    id="exampleDetailsImplementationText"
                                    text="{examplesModel>/selectedExample/implementation}"
                                />
                            </VBox>
                            <VBox
                                id="exampleDetailsVolumeVBox"
                                class="sapUiSmallMarginBottom"
                            >
                                <Label
                                    id="exampleDetailsVolumeLabel"
                                    text="Volume Handled:"
                                    design="Bold"
                                />
                                <Text
                                    id="exampleDetailsVolumeText"
                                    text="{examplesModel>/selectedExample/volumeHandled}"
                                />
                            </VBox>
                            <VBox
                                id="exampleDetailsPerformanceVBox"
                                class="sapUiSmallMarginBottom"
                            >
                                <Label
                                    id="exampleDetailsPerformanceLabel"
                                    text="Performance Achieved:"
                                    design="Bold"
                                />
                                <Text
                                    id="exampleDetailsPerformanceText"
                                    text="{examplesModel>/selectedExample/performanceAchieved}"
                                />
                            </VBox>
                            <VBox
                                id="exampleDetailsTimeVBox"
                                class="sapUiSmallMarginBottom"
                            >
                                <Label
                                    id="exampleDetailsTimeLabel"
                                    text="Implementation Time:"
                                    design="Bold"
                                />
                                <Text
                                    id="exampleDetailsTimeText"
                                    text="{examplesModel>/selectedExample/implementationTime}"
                                />
                            </VBox>
                            <VBox
                                id="exampleDetailsLessonsVBox"
                                class="sapUiSmallMarginBottom"
                            >
                                <Label
                                    id="exampleDetailsLessonsLabel"
                                    text="Lessons Learned:"
                                    design="Bold"
                                />
                                <Text
                                    id="exampleDetailsLessonsText"
                                    text="{examplesModel>/selectedExample/lessonsLearned}"
                                />
                            </VBox>
                        </VBox>
                    </content>
                    <beginButton>
                        <Button
                            id="closeExampleDetailsButton"
                            text="Close"
                            press=".onCloseExampleDialog"
                        />
                    </beginButton>
                </Dialog>
            </VBox>
        </content>
    </Panel>
</core:FragmentDefinition>
