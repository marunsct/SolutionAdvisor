<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:html="http://www.w3.org/1999/xhtml">
    
    <VBox
        id="radarChartContainer"
        width="100%"
        alignItems="Center"
        class="sapUiSmallMargin">
        
        <Title id="scoringRadarChartTitle" text="Scoring Radar Chart" level="H4" class="sapUiSmallMarginBottom"/>
        
        <!-- SVG Container for D3.js Radar Chart -->
        <core:HTML
            id="radarChartSVG"
            content="&lt;div id='radarChart' style='width: 400px; height: 400px;'&gt;&lt;/div&gt;"/>
        
        <!-- Legend -->
        <HBox id="scoringRadarLegendHBox" class="sapUiSmallMarginTop">
            <HBox id="techDebtLegendHBox" class="sapUiTinyMarginEnd">
                <core:Icon id="techDebtLegendIcon" src="sap-icon://circle-task-2" color="#5899DA" class="sapUiTinyMarginEnd"/>
                <Text id="techDebtLegendText" text="Technical Debt"/>
            </HBox>
            <HBox id="cloudReadinessLegendHBox" class="sapUiTinyMarginEnd">
                <core:Icon id="cloudReadinessLegendIcon" src="sap-icon://circle-task-2" color="#E8743B" class="sapUiTinyMarginEnd"/>
                <Text id="cloudReadinessLegendText" text="Cloud Readiness"/>
            </HBox>
            <HBox id="upgradeImpactLegendHBox" class="sapUiTinyMarginEnd">
                <core:Icon id="upgradeImpactLegendIcon" src="sap-icon://circle-task-2" color="#19A979" class="sapUiTinyMarginEnd"/>
                <Text id="upgradeImpactLegendText" text="Upgrade Impact"/>
            </HBox>
            <HBox id="compositeHealthLegendHBox">
                <core:Icon id="compositeHealthLegendIcon" src="sap-icon://circle-task-2" color="#ED4A7B" class="sapUiTinyMarginEnd"/>
                <Text id="compositeHealthLegendText" text="Composite Health"/>
            </HBox>
        </HBox>
        
        <Text 
            id="scoringRadarNote"
            text="Note: Larger area = Better (for CRS &amp; CHS), Smaller area = Better (for TDS &amp; UIS)" 
            class="sapUiTinyMarginTop sapUiSmallText"/>
    </VBox>
</core:FragmentDefinition>
