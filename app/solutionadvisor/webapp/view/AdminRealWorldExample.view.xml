<mvc:View
    controllerName="sd.solutionadvisor.controller.AdminRealWorldExample"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:unified="sap.ui.unified"
    displayBlock="true">
    
    <Page
        id="adminExamplePage"
        title="Real-World Example Maintenance"
        showNavButton="true"
        navButtonPress="onNavBack"
        class="sapUiResponsiveContentPadding">
        
        <headerContent>
            <Button
                id="createExampleButton"
                text="Create"
                icon="sap-icon://create"
                type="Emphasized"
                press="onCreate"
                tooltip="Create new example"/>
            <Button
                id="exportExampleButton"
                text="Export"
                icon="sap-icon://excel-attachment"
                press="onExport"
                tooltip="Export all examples to Excel"/>
            <unified:FileUploader
                id="exampleFileUploader"
                name="massUpload"
                buttonText="Mass Upload"
                icon="sap-icon://upload"
                uploadOnChange="false"
                change="onMassUpload"
                fileType="xlsx"
                mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                tooltip="Upload Excel file with examples"/>
            <SearchField
                id="searchExampleField"
                width="300px"
                search="onSearch"
                placeholder="Search examples..."/>
        </headerContent>
        
        <content>
            <VBox id="adminExampleContentVBox" class="sapUiSmallMargin">
                
                <!-- Filter Bar -->
                <Panel id="exampleFilterPanel" headerText="Filters" expandable="true" expanded="false" class="sapUiSmallMarginBottom">
                    <content>
                        <FlexBox id="exampleFilterFlexBox" wrap="Wrap" class="sapUiSmallMargin">
                            <ComboBox
                                id="objectTypeFilterExample"
                                placeholder="Filter by Object Type"
                                width="200px"
                                selectionChange="onFilterChange"
                                class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                <items>
                                    <core:Item id="exampleAllTypesItem" key="" text="All Types"/>
                                    <core:Item id="exampleReportsItem" key="R" text="Reports"/>
                                    <core:Item id="exampleInterfacesItem" key="I" text="Interfaces"/>
                                    <core:Item id="exampleConversionsItem" key="C" text="Conversions"/>
                                    <core:Item id="exampleEnhancementsItem" key="E" text="Enhancements"/>
                                    <core:Item id="exampleFormsItem" key="F" text="Forms"/>
                                    <core:Item id="exampleWorkflowsItem" key="W" text="Workflows"/>
                                </items>
                            </ComboBox>
                            <ComboBox
                                id="industryFilterExample"
                                placeholder="Filter by Industry"
                                width="200px"
                                selectionChange="onFilterChange"
                                class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                <items>
                                    <core:Item id="exampleAllIndustriesItem" key="" text="All Industries"/>
                                    <core:Item id="exampleManufacturingItem" key="Manufacturing" text="Manufacturing"/>
                                    <core:Item id="exampleRetailItem" key="Retail" text="Retail"/>
                                    <core:Item id="exampleFinanceItem" key="Finance" text="Finance"/>
                                    <core:Item id="exampleHealthcareItem" key="Healthcare" text="Healthcare"/>
                                    <core:Item id="examplePharmaItem" key="Pharma" text="Pharma"/>
                                </items>
                            </ComboBox>
                            <ComboBox
                                id="levelFilterExample"
                                placeholder="Filter by Clean Core Level"
                                width="200px"
                                selectionChange="onFilterChange"
                                class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                <items>
                                    <core:Item id="exampleAllLevelsItem" key="" text="All Levels"/>
                                    <core:Item id="exampleLevelAItem" key="A" text="Level A"/>
                                    <core:Item id="exampleLevelBItem" key="B" text="Level B"/>
                                    <core:Item id="exampleLevelCItem" key="C" text="Level C"/>
                                    <core:Item id="exampleLevelDItem" key="D" text="Level D"/>
                                </items>
                            </ComboBox>
                            <Button
                                id="clearExampleFiltersButton"
                                text="Clear Filters"
                                press="onClearFilters"/>
                        </FlexBox>
                    </content>
                </Panel>
                
                <!-- Record Count -->
                <FlexBox id="exampleHeaderFlexBox" justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom">
                    <Title id="exampleTitle" text="Real-World Examples" level="H3"/>
                    <Text id="exampleRecordCount" text="{viewModel>/recordCount} records"/>
                </FlexBox>
                
                <!-- Example Table -->
                <Table
                    id="exampleTable"
                    items="{
                        path: 'admin>/RealWorldExample',
                        parameters: {
                            $count: true
                        }
                    }"
                    mode="MultiSelect"
                    growing="true"
                    growingThreshold="20"
                    busy="{viewModel>/busy}"
                    noDataText="No examples found. Click Create to add new examples.">
                    
                    <columns>
                        <Column id="exampleTitleColumn" width="20%">
                            <Text id="exampleTitleHeader" text="Title"/>
                        </Column>
                        <Column id="exampleObjectTypeColumn" width="12%">
                            <Text id="exampleObjectTypeHeader" text="Object Type"/>
                        </Column>
                        <Column id="exampleIndustryColumn" width="12%">
                            <Text id="exampleIndustryHeader" text="Industry"/>
                        </Column>
                        <Column id="exampleLevelColumn" width="8%">
                            <Text id="exampleLevelHeader" text="Level"/>
                        </Column>
                        <Column id="exampleDescriptionColumn" width="25%">
                            <Text id="exampleDescriptionHeader" text="Description"/>
                        </Column>
                        <Column id="exampleTechnologiesColumn" width="10%">
                            <Text id="exampleTechnologiesHeader" text="Technologies"/>
                        </Column>
                        <Column id="exampleModifiedColumn" width="8%">
                            <Text id="exampleModifiedHeader" text="Modified"/>
                        </Column>
                        <Column id="exampleActionsColumn" width="5%" hAlign="End">
                            <Text id="exampleActionsHeader" text="Actions"/>
                        </Column>
                    </columns>
                    
                    <items>
                        <ColumnListItem id="exampleItem" type="Active" press="onItemPress">
                            <cells>
                                <Text id="exampleTitleText" text="{admin>title}"/>
                                <Text id="exampleObjectTypeText" text="{admin>objectType}"/>
                                <Text id="exampleIndustryText" text="{admin>industry}"/>
                                <ObjectStatus
                                    id="exampleLevelStatus"
                                    text="{admin>cleanCoreLevel}"
                                    state="{= ${admin>cleanCoreLevel} === 'A' ? 'Success' : ${admin>cleanCoreLevel} === 'B' ? 'Information' : ${admin>cleanCoreLevel} === 'C' ? 'Warning' : 'Error' }"/>
                                <Text id="exampleDescriptionText" text="{admin>solutionDescription}" maxLines="2"/>
                                <Text id="exampleTechnologiesText" text="{admin>technologiesUsed}" maxLines="1"/>
                                <Text id="exampleModifiedAtText" text="{path: 'admin>modifiedAt', formatter: '.formatTimestamp'}"/>
                                <HBox id="exampleActionsHBox">
                                    <Button
                                        id="editExampleButton"
                                        icon="sap-icon://edit"
                                        type="Transparent"
                                        press="onEdit"
                                        tooltip="Edit"/>
                                    <Button
                                        id="deleteExampleButton"
                                        icon="sap-icon://delete"
                                        type="Transparent"
                                        press="onDelete"
                                        tooltip="Delete"/>
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
                
            </VBox>
        </content>
    </Page>
</mvc:View>
