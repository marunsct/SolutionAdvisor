<mvc:View
    controllerName="sd.solutionadvisor.controller.AdminQuestionFlow"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:unified="sap.ui.unified"
    displayBlock="true"
>
    <Page
        id="adminQuestionFlowPage"
        title="Question Flow Maintenance"
        showNavButton="true"
        navButtonPress="onNavBack"
        class="sapUiResponsiveContentPadding"
    >
        <headerContent>
            <Button
                id="createQuestionButton"
                text="Create"
                icon="sap-icon://create"
                type="Emphasized"
                press="onCreate"
                tooltip="Create new question flow"
            />
            <Button
                id="downloadTemplateButton"
                text="Download Template"
                icon="sap-icon://download"
                press="onDownloadTemplate"
                tooltip="Download Excel template for mass upload"
            />
            <Button
                id="exportButton"
                text="Export"
                icon="sap-icon://excel-attachment"
                press="onExport"
                tooltip="Export all question flows to Excel"
            />
            <unified:FileUploader
                id="fileUploader"
                name="massUpload"
                buttonText="Mass Upload"
                icon="sap-icon://upload"
                uploadOnChange="false"
                change="onMassUpload"
                fileType="xlsx"
                mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                tooltip="Upload Excel file with question flows"
            />
            <SearchField
                id="adminQuestionFlowSearchField"
                width="300px"
                search="onSearch"
                placeholder="Search questions..."
            />
        </headerContent>

        <content>
            <VBox
                id="adminQuestionFlowContentVBox"
                class="sapUiSmallMargin"
            >
                <!-- Info Panel -->
                <MessageStrip
                    id="adminQuestionFlowInfoMessage"
                    text="Use Download Template to get the correct format. Upload Excel files with Mass Upload. Click Export to download existing data."
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"
                />

                <!-- Record Count -->
                <FlexBox
                    id="adminQuestionFlowHeaderFlexBox"
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                    class="sapUiSmallMarginBottom"
                >
                    <Title
                        id="adminQuestionFlowTitle"
                        text="Question Flows"
                        level="H3"
                    />
                    <Text
                        id="adminQuestionFlowRecordCount"
                        text="{viewModel>/recordCount} records"
                    />
                </FlexBox>

                <!-- Question Flow Table -->
                <Table
                    id="questionFlowTable"
                    items="{/QuestionFlow}"
                    mode="MultiSelect"
                    growing="true"
                    growingThreshold="20"
                    busy="{viewModel>/busy}"
                    noDataText="No question flows found. Click Create to add new questions."
                >
                    <columns>
                        <Column
                            id="questionKeyColumn"
                            width="12%"
                        >
                            <Text
                                id="questionKeyHeader"
                                text="Question Key"
                            />
                        </Column>
                        <Column
                            id="objectTypeColumn"
                            width="8%"
                        >
                            <Text
                                id="objectTypeHeader"
                                text="Object Type"
                            />
                        </Column>
                        <Column
                            id="questionTextColumn"
                            width="30%"
                        >
                            <Text
                                id="questionTextHeader"
                                text="Question Text"
                            />
                        </Column>
                        <Column
                            id="categoryColumn"
                            width="12%"
                        >
                            <Text
                                id="categoryHeader"
                                text="Category"
                            />
                        </Column>
                        <Column
                            id="answerTypeColumn"
                            width="10%"
                        >
                            <Text
                                id="answerTypeHeader"
                                text="Answer Type"
                            />
                        </Column>
                        <Column
                            id="activeColumn"
                            width="8%"
                        >
                            <Text
                                id="activeHeader"
                                text="Active"
                            />
                        </Column>
                        <Column
                            id="modifiedColumn"
                            width="10%"
                        >
                            <Text
                                id="modifiedHeader"
                                text="Modified"
                            />
                        </Column>
                        <Column
                            id="actionsColumn"
                            width="10%"
                            hAlign="End"
                        >
                            <Text
                                id="actionsHeader"
                                text="Actions"
                            />
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem
                            id="questionFlowItem"
                            type="Navigation"
                        >
                            <cells>
                                <ObjectIdentifier
                                    id="questionKeyIdentifier"
                                    title="{questionKey}"
                                    text="{objectType_objectType}"
                                />
                                <Text
                                    id="objectTypeText"
                                    text="{objectType_objectType}"
                                />
                                <VBox id="questionTextVBox">
                                    <Text
                                        id="questionTextValue"
                                        text="{questionText}"
                                        class="sapUiTinyMarginBottom"
                                    />
                                    <Text
                                        id="detailedHintText"
                                        text="{detailedHint}"
                                        class="sapUiSmallText"
                                    />
                                </VBox>
                                <Text
                                    id="categoryText"
                                    text="{questionCategory}"
                                />
                                <Text
                                    id="answerTypeText"
                                    text="{answerType}"
                                />
                                <Switch
                                    id="questionActiveSwitch"
                                    state="{isActive}"
                                    enabled="false"
                                    customTextOn="Yes"
                                    customTextOff="No"
                                />
                                <Text
                                    id="modifiedAtText"
                                    text="{modifiedAt}"
                                />
                                <HBox
                                    id="actionsHBox"
                                    justifyContent="End"
                                >
                                    <Button
                                        id="editQuestionButton"
                                        icon="sap-icon://edit"
                                        type="Transparent"
                                        press="onEdit"
                                        tooltip="Edit question flow"
                                    />
                                    <Button
                                        id="deleteQuestionButton"
                                        icon="sap-icon://delete"
                                        type="Transparent"
                                        press="onDelete"
                                        tooltip="Delete question flow"
                                    />
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>

        <footer>
            <OverflowToolbar id="adminQuestionFlowFooterToolbar">
                <ToolbarSpacer id="adminQuestionFlowFooterSpacer" />
                <Button
                    id="refreshQuestionFlowButton"
                    text="Refresh"
                    icon="sap-icon://refresh"
                    press="_loadData"
                />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
