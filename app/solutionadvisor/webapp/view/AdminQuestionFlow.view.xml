<mvc:View
    controllerName="sd.solutionadvisor.controller.AdminQuestionFlow"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:unified="sap.ui.unified"
    displayBlock="true"
>
    <Page
        id="adminQuestionFlowPage"
        title="Question Flow Maintenance"
        showNavButton="true"
        navButtonPress="onNavBack"
    >
        <headerContent>
            <Button
                id="createQuestionButton"
                text="Create"
                icon="sap-icon://create"
                type="Emphasized"
                press="onCreate"
            />
            <Button
                id="downloadTemplateButton"
                text="Download Template"
                icon="sap-icon://download"
                press="onDownloadTemplate"
            />
            <Button
                id="exportButton"
                text="Export"
                icon="sap-icon://excel-attachment"
                press="onExport"
            />
            <unified:FileUploader
                id="fileUploader"
                name="massUpload"
                buttonText="Mass Upload"
                icon="sap-icon://upload"
                uploadOnChange="false"
                change="onMassUpload"
                fileType="xlsx"
                mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
            />
        </headerContent>

        <content>
            <VBox id="qfContentVBox" class="sapUiSmallMargin">
                <!-- Info Panel -->
                <MessageStrip
                    id="qfInfoStrip"
                    text="Use Download Template to get the correct format. Upload Excel files with Mass Upload. Click Export to download existing data."
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"
                />

                <!-- Filter Bar -->
                <Panel
                    id="qfFilterPanel"
                    headerText="Filters"
                    expandable="true"
                    expanded="{viewModel>/filtersExpanded}"
                    class="sapUiSmallMarginBottom"
                >
                    <content>
                        <f:SimpleForm
                            id="qfFilterForm"
                            editable="true"
                            layout="ResponsiveGridLayout"
                            labelSpanXL="3"
                            labelSpanL="3"
                            labelSpanM="4"
                            labelSpanS="12"
                            emptySpanXL="0"
                            emptySpanL="0"
                            emptySpanM="0"
                            emptySpanS="0"
                            columnsXL="2"
                            columnsL="2"
                            columnsM="1"
                        >
                            <f:content>
                                <Label id="qfSearchLabel" text="Search" />
                                <SearchField
                                    id="qfSearchField"
                                    width="100%"
                                    search="onSearch"
                                    liveChange="onSearch"
                                    placeholder="Search by key, text, or category..."
                                />

                                <Label id="qfObjTypeLabel" text="Object Type" />
                                <ComboBox
                                    id="qfObjectTypeFilter"
                                    selectedKey="{viewModel>/filters/objectType}"
                                    change="onFilterChange"
                                    placeholder="All Object Types"
                                >
                                    <items>
                                        <core:Item id="qfObjAllItem" key="" text="All" />
                                        <core:Item id="qfObjRItem" key="Reports" text="Reports" />
                                        <core:Item id="qfObjIItem" key="Interfaces" text="Interfaces" />
                                        <core:Item id="qfObjCItem" key="Conversions" text="Conversions" />
                                        <core:Item id="qfObjEItem" key="Enhancements" text="Enhancements" />
                                        <core:Item id="qfObjFItem" key="Forms" text="Forms" />
                                        <core:Item id="qfObjWItem" key="Workflows" text="Workflows" />
                                    </items>
                                </ComboBox>

                                <Label id="qfActiveLabel" text="Active Status" />
                                <ComboBox
                                    id="qfActiveFilter"
                                    width="100%"
                                    selectedKey="{viewModel>/filters/isActive}"
                                    change="onFilterChange"
                                    placeholder="All"
                                >
                                    <items>
                                        <core:Item id="qfActiveAll" key="" text="All" />
                                        <core:Item id="qfActiveTrue" key="true" text="Active Only" />
                                        <core:Item id="qfActiveFalse" key="false" text="Inactive Only" />
                                    </items>
                                </ComboBox>
                            </f:content>
                        </f:SimpleForm>
                    </content>
                </Panel>
                
                <Toolbar id="qfFilterToolbar">
                    <ToolbarSpacer id="qfFilterToolbarSpacer" />
                    <Button
                        id="qfClearFiltersButton"
                        text="Clear Filters"
                        icon="sap-icon://clear-filter"
                        press="onClearFilters"
                    />
                    <Button
                        id="qfApplyFiltersButton"
                        text="Apply Filters"
                        icon="sap-icon://filter"
                        type="Emphasized"
                        press="onApplyFilters"
                    />
                </Toolbar>

                <!-- Record Count and Actions -->
                <Toolbar id="qfRecordCountToolbar">
                    <Title
                        id="qfRecordTitle"
                        text="Question Flows ({viewModel>/recordCount})"
                        level="H4"
                    />
                    <ToolbarSpacer id="qfRecordSpacer" />
                    <Text id="qfSelectedText" text="{viewModel>/selectedCount} selected" />
                    <Button
                        id="qfRefreshButton"
                        icon="sap-icon://refresh"
                        press="onRefresh"
                        tooltip="Refresh data"
                    />
                </Toolbar>

                <!-- Question Flow Table -->
                <Table
                    id="questionFlowTable"
                    items="{
                        path: 'admin>/QuestionFlow',
                        parameters: {
                            $count: true
                        },
                        sorter: {
                            path: 'questionId'
                        }
                    }"
                    mode="MultiSelect"
                    growing="true"
                    growingThreshold="20"
                    growingScrollToLoad="true"
                    sticky="ColumnHeaders,HeaderToolbar"
                    busy="{viewModel>/busy}"
                    noDataText="No question flows found. Click Create to add new questions."
                    selectionChange="onSelectionChange"
                >
                    <columns>
                        <Column
                            id="qfColQuestionId"
                            width="12em"
                            demandPopin="true"
                            minScreenWidth="Tablet"
                        >
                            <Text id="qfColQuestionIdHdr" text="Question ID" />
                        </Column>
                        <Column
                            id="qfColType"
                            width="6em"
                            demandPopin="true"
                            minScreenWidth="Desktop"
                        >
                            <Text id="qfColTypeHdr" text="Type" />
                        </Column>
                        <Column
                            id="qfColText"
                            width="auto"
                            demandPopin="false"
                        >
                            <Text id="qfColTextHdr" text="Question Text" />
                        </Column>
                        <Column
                            id="qfColActive"
                            width="6em"
                            demandPopin="true"
                            minScreenWidth="Tablet"
                            hAlign="Center"
                        >
                            <Text id="qfColActiveHdr" text="Active" />
                        </Column>
                        <Column
                            id="qfColModified"
                            width="12em"
                            demandPopin="true"
                            minScreenWidth="Desktop"
                        >
                            <Text id="qfColModifiedHdr" text="Modified" />
                        </Column>
                        <Column
                            id="qfColActions"
                            width="8em"
                            hAlign="End"
                            demandPopin="false"
                        >
                            <Text id="qfColActionsHdr" text="Actions" />
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem id="qfListItem" type="Navigation">
                            <cells>
                                <ObjectIdentifier id="qfObjId" title="{admin>questionId}" />
                                <ObjectStatus id="qfObjType" text="{admin>objectType}" state="Information" />
                                <VBox id="qfTextBox">
                                    <Text id="qfQuestionText" text="{admin>questionText}" class="sapUiTinyMarginBottom" />
                                    <Text id="qfHintText" text="{admin>detailedHint}" class="sapUiTinyText sapUiTextDimmed" maxLines="2" />
                                </VBox>
                                <HBox id="qfActiveBox" justifyContent="Center">
                                    <core:Icon id="qfActiveIcon" src="{= ${admin>isActive} ? 'sap-icon://accept' : 'sap-icon://decline' }" color="{= ${admin>isActive} ? 'green' : 'red' }" />
                                </HBox>
                                <Text id="qfModifiedText" text="{ path: 'admin>modifiedAt', formatter: '.formatTimestamp' }" />
                                <HBox id="qfActionsBox" justifyContent="End">
                                    <Button id="qfEditBtn" icon="sap-icon://edit" type="Transparent" press="onEdit" tooltip="Edit" />
                                    <Button id="qfDeleteBtn" icon="sap-icon://delete" type="Transparent" press="onDelete" tooltip="Delete" />
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
    </Page>
</mvc:View>
