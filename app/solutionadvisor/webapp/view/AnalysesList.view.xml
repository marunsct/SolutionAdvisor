<mvc:View
    controllerName="sd.solutionadvisor.controller.AnalysesList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
>
    <Page
        id="analysesListPage"
        title="{= ${viewModel>/isFiltered} ? 'Analyses for ' + ${viewModel>/projectName} : 'Clean Core Analyses' }"
        showHeader="true"
    >
        <content>
            <VBox
                id="analysesListVBox"
                class="sapUiSmallMargin"
            >
                <MessageStrip
                    id="projectFilterInfo"
                    visible="{viewModel>/isFiltered}"
                    text="Showing analyses for project: {viewModel>/projectName}"
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"
                />
                <HeaderContainer
                    id="analysesHeader"
                    orientation="Horizontal"
                    backgroundDesign="Transparent"
                >
                    <GenericTile
                        id="totalAnalysesTile"
                        class="sapUiTinyMarginBegin sapUiTinyMarginTop"
                        header="Total Analyses"
                        subheader="All Analyses"
                    >
                        <TileContent id="totalAnalysesTileContent">
                            <NumericContent
                                id="totalAnalysesNumeric"
                                value="{viewModel>/analysesCount}"
                                icon="sap-icon://activities"
                                withMargin="false"
                            />
                        </TileContent>
                    </GenericTile>
                    <GenericTile
                        id="levelATile"
                        class="sapUiTinyMarginBegin sapUiTinyMarginTop"
                        header="Level A"
                        subheader="Fully Clean Core"
                    >
                        <TileContent id="levelATileContent">
                            <NumericContent
                                id="levelANumeric"
                                value="{viewModel>/levelACount}"
                                icon="sap-icon://accept"
                                valueColor="Good"
                                withMargin="false"
                            />
                        </TileContent>
                    </GenericTile>
                    <GenericTile
                        id="levelBTile"
                        class="sapUiTinyMarginBegin sapUiTinyMarginTop"
                        header="Level B"
                        subheader="Enhanced Clean Core"
                    >
                        <TileContent id="levelBTileContent">
                            <NumericContent
                                id="levelBNumeric"
                                value="{viewModel>/levelBCount}"
                                icon="sap-icon://future"
                                valueColor="Neutral"
                                withMargin="false"
                            />
                        </TileContent>
                    </GenericTile>
                    <GenericTile
                        id="levelCTile"
                        class="sapUiTinyMarginBegin sapUiTinyMarginTop"
                        header="Level C"
                        subheader="Compliant Modifications"
                    >
                        <TileContent id="levelCTileContent">
                            <NumericContent
                                id="levelCNumeric"
                                value="{viewModel>/levelCCount}"
                                icon="sap-icon://customize"
                                valueColor="Critical"
                                withMargin="false"
                            />
                        </TileContent>
                    </GenericTile>
                    <GenericTile
                        id="levelDTile"
                        class="sapUiTinyMarginBegin sapUiTinyMarginTop"
                        header="Level D"
                        subheader="Non-Compliant/Legacy"
                    >
                        <TileContent id="levelDTileContent">
                            <NumericContent
                                id="levelDNumeric"
                                value="{viewModel>/levelDCount}"
                                icon="sap-icon://warning"
                                valueColor="Error"
                                withMargin="false"
                            />
                        </TileContent>
                    </GenericTile>
                </HeaderContainer>

                <Table
                    id="analysesTable"
                    items="{
                        path: '/Analyses',
                        sorter: {
                            path: 'analysisDate',
                            descending: true
                        }
                    }"
                    mode="SingleSelectLeft"
                    selectionChange="onSelectionChange"
                    growing="true"
                    growingThreshold="20"
                >
                    <headerToolbar>
                        <OverflowToolbar id="analysesTableToolbar">
                            <Title
                                id="analysesTableTitle"
                                text="Analyses"
                                level="H2"
                            />
                            <ToolbarSpacer id="analysesTableToolbarSpacer" />
                            <SearchField
                                id="analysesSearchField"
                                width="200px"
                                search="onSearch"
                                placeholder="Search analyses..."
                            />
                            <Button
                                id="deleteAnalysisButton"
                                text="Delete"
                                icon="sap-icon://delete"
                                type="Reject"
                                press="onDeleteAnalysis"
                                enabled="{viewModel>/hasSelection}"
                            />
                            <Button
                                id="newAnalysisButton"
                                text="New Analysis"
                                icon="sap-icon://add"
                                type="Emphasized"
                                press="onStartWizard"
                            />
                            <Button
                                id="backToProjectsButton"
                                text="Back to Projects"
                                icon="sap-icon://navigation-left-arrow"
                                press="onBackToProjects"
                            />
                        </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                        <Column
                            id="ricefwIdColumn"
                            width="10%"
                        >
                            <Button
                                id="ricefwIdHeader"
                                text="{= ${viewModel>/sortProperty} === 'ricefwId' ? 'RICEFW ID ' + (${viewModel>/sortDescending} ? '⬇' : '⬆') : 'RICEFW ID'}"
                                type="Transparent"
                                class="sortableColumnHeader"
                                press="onColumnHeaderPress"
                            />
                        </Column>
                        <Column
                            id="objectNameColumn"
                            width="20%"
                        >
                            <Button
                                id="objectNameHeader"
                                text="{= ${viewModel>/sortProperty} === 'objectName' ? 'Object Name ' + (${viewModel>/sortDescending} ? '⬇' : '⬆') : 'Object Name'}"
                                type="Transparent"
                                class="sortableColumnHeader"
                                press="onColumnHeaderPress"
                            />
                        </Column>
                        <Column
                            id="typeColumn"
                            width="10%"
                        >
                            <Button
                                id="typeHeader"
                                text="{= ${viewModel>/sortProperty} === 'objectType' ? 'Type ' + (${viewModel>/sortDescending} ? '⬇' : '⬆') : 'Type'}"
                                type="Transparent"
                                class="sortableColumnHeader"
                                press="onColumnHeaderPress"
                            />
                        </Column>
                        <Column
                            id="cleanCoreLevelColumn"
                            width="12%"
                        >
                            <Button
                                id="cleanCoreLevelHeader"
                                text="{= ${viewModel>/sortProperty} === 'finalRecommendation' ? 'Clean Core Level ' + (${viewModel>/sortDescending} ? '⬇' : '⬆') : 'Clean Core Level'}"
                                type="Transparent"
                                class="sortableColumnHeader"
                                press="onColumnHeaderPress"
                            />
                        </Column>
                        <Column
                            id="techDebtColumn"
                            width="12%"
                        >
                            <Button
                                id="techDebtHeader"
                                text="{= ${viewModel>/sortProperty} === 'technicalDebtScore' ? 'Technical Debt ' + (${viewModel>/sortDescending} ? '⬇' : '⬆') : 'Technical Debt'}"
                                type="Transparent"
                                class="sortableColumnHeader"
                                press="onColumnHeaderPress"
                            />
                        </Column>
                        <Column
                            id="cloudReadyColumn"
                            width="12%"
                        >
                            <Button
                                id="cloudReadyHeader"
                                text="{= ${viewModel>/sortProperty} === 'cloudReadinessScore' ? 'Cloud Readiness ' + (${viewModel>/sortDescending} ? '⬇' : '⬆') : 'Cloud Readiness'}"
                                type="Transparent"
                                class="sortableColumnHeader"
                                press="onColumnHeaderPress"
                            />
                        </Column>
                        <Column
                            id="analysesStatusColumn"
                            width="12%"
                        >
                            <Button
                                id="analysesStatusHeader"
                                text="{= ${viewModel>/sortProperty} === 'status' ? 'Status ' + (${viewModel>/sortDescending} ? '⬇' : '⬆') : 'Status'}"
                                type="Transparent"
                                class="sortableColumnHeader"
                                press="onColumnHeaderPress"
                            />
                        </Column>
                        <Column
                            id="dateColumn"
                            width="12%"
                        >
                            <Button
                                id="dateHeader"
                                text="{= ${viewModel>/sortProperty} === 'analysisDate' ? 'Date ' + (${viewModel>/sortDescending} ? '⬇' : '⬆') : 'Date'}"
                                type="Transparent"
                                class="sortableColumnHeader"
                                press="onColumnHeaderPress"
                            />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem
                            id="analysesTableItem"
                            type="Active"
                            press="onAnalysisSelect"
                        >
                            <cells>
                                <VBox
                                    id="ricefwIdCell"
                                >
                                    <Text
                                        id="ricefwIdCellText"
                                        text="{ricefwId}"
                                    />
                                    <Text
                                        id="draftStatusText"
                                        text="Draft"
                                        visible="false"
                                        class="sapUiSmallMarginTop sapUiLowerCase"
                                    />
                                    <Text
                                        id="ricefwComplexityText"
                                        text="Complexity: {complexity}"
                                        visible="{= ${complexity} ? true : false}"
                                        class="sapUiSmallMarginTop sapUiTinyText"
                                    />
                                </VBox>
                                <ObjectIdentifier
                                    id="objectNameCell"
                                    title="{objectName}"
                                    text="{objectDescription}"
                                />
                                <Text
                                    id="objectTypeCell"
                                    text="{objectType}"
                                />
                                <ObjectStatus
                                    id="finalRecommendationCell"
                                    text="{finalRecommendation}"
                                    state="{= ${finalRecommendation}.indexOf('Level A') &gt; -1 ? 'Success' : ${finalRecommendation}.indexOf('Level B') &gt; -1 ? 'Information' : ${finalRecommendation}.indexOf('Level C') &gt; -1 ? 'Warning' : 'Error'}"
                                />
                                <ProgressIndicator
                                    id="techDebtCell"
                                    percentValue="{technicalDebtScore}"
                                    displayValue="{technicalDebtScore}"
                                    state="{= ${technicalDebtScore} &lt; 30 ? 'Success' : ${technicalDebtScore} &lt; 60 ? 'Warning' : 'Error' }"
                                />
                                <ProgressIndicator
                                    id="cloudReadyCell"
                                    percentValue="{cloudReadinessScore}"
                                    displayValue="{cloudReadinessScore}"
                                    state="{= ${cloudReadinessScore} &gt; 70 ? 'Success' : ${cloudReadinessScore} &gt; 40 ? 'Warning' : 'Error' }"
                                />
                                <ObjectStatus
                                    id="analysesStatusCell"
                                    text="{status}"
                                    state="{= ${status} === 'Completed' ? 'Success' : ${status} === 'In Progress' ? 'Warning' : 'None' }"
                                />
                                <Text
                                    id="analysisDateCell"
                                    text="{path: 'analysisDate', type: 'sd.solutionadvisor.types.FlexibleDateTime', formatOptions: {pattern: 'yyyy-MM-dd'}}"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
    </Page>
</mvc:View>
