<mvc:View
    controllerName="sd.solutionadvisor.controller.AnalysesList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
>
    <Page
        id="analysesListPage"
        title="{= ${viewModel>/isFiltered} ? 'Analyses for ' + ${viewModel>/projectName} : 'Clean Core Analyses' }"
        showHeader="true"
    >
        <content>
            <VBox
                id="analysesListVBox"
                class="sapUiSmallMargin"
            >
                <MessageStrip
                    id="projectFilterInfo"
                    visible="{viewModel>/isFiltered}"
                    text="{= ${viewModel>/isFiltered} ? ${i18n>analysesProjectFilterInfo} + ${viewModel>/projectName} : '' }"
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"
                />
                <MessageStrip
                    id="analysesListHelpMessage"
                    text="{i18n>analysesListHelpMsg}"
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"
                />
                <HeaderContainer
                    id="analysesHeader"
                    orientation="Horizontal"
                    backgroundDesign="Transparent"
                >
                    <GenericTile
                        id="totalAnalysesTile"
                        class="sapUiTinyMarginBegin sapUiTinyMarginTop"
                        header="{i18n>analysesTotalHeader}"
                        subheader="{i18n>analysesAllSubheader}"
                    >
                        <TileContent id="totalAnalysesTileContent">
                            <NumericContent
                                id="totalAnalysesNumeric"
                                value="{viewModel>/analysesCount}"
                                icon="sap-icon://activities"
                                withMargin="false"
                            />
                        </TileContent>
                    </GenericTile>
                    <GenericTile
                        id="levelATile"
                        class="sapUiTinyMarginBegin sapUiTinyMarginTop"
                        header="{i18n>levelA}"
                        subheader="{i18n>analysesLevelASubheader}"
                    >
                        <TileContent id="levelATileContent">
                            <NumericContent
                                id="levelANumeric"
                                value="{viewModel>/levelACount}"
                                icon="sap-icon://accept"
                                valueColor="Good"
                                withMargin="false"
                            />
                        </TileContent>
                    </GenericTile>
                    <GenericTile
                        id="levelBTile"
                        class="sapUiTinyMarginBegin sapUiTinyMarginTop"
                        header="{i18n>levelB}"
                        subheader="{i18n>analysesLevelBSubheader}"
                    >
                        <TileContent id="levelBTileContent">
                            <NumericContent
                                id="levelBNumeric"
                                value="{viewModel>/levelBCount}"
                                icon="sap-icon://future"
                                valueColor="Neutral"
                                withMargin="false"
                            />
                        </TileContent>
                    </GenericTile>
                    <GenericTile
                        id="levelCTile"
                        class="sapUiTinyMarginBegin sapUiTinyMarginTop"
                        header="{i18n>levelC}"
                        subheader="{i18n>analysesLevelCSubheader}"
                    >
                        <TileContent id="levelCTileContent">
                            <NumericContent
                                id="levelCNumeric"
                                value="{viewModel>/levelCCount}"
                                icon="sap-icon://customize"
                                valueColor="Critical"
                                withMargin="false"
                            />
                        </TileContent>
                    </GenericTile>
                    <GenericTile
                        id="levelDTile"
                        class="sapUiTinyMarginBegin sapUiTinyMarginTop"
                        header="{i18n>levelD}"
                        subheader="{i18n>analysesLevelDSubheader}"
                    >
                        <TileContent id="levelDTileContent">
                            <NumericContent
                                id="levelDNumeric"
                                value="{viewModel>/levelDCount}"
                                icon="sap-icon://warning"
                                valueColor="Error"
                                withMargin="false"
                            />
                        </TileContent>
                    </GenericTile>
                </HeaderContainer>

                <Table
                    id="analysesTable"
                    items="{
                        path: '/Analyses',
                        sorter: {
                            path: 'analysisDate',
                            descending: true
                        }
                    }"
                    mode="SingleSelectLeft"
                    selectionChange="onSelectionChange"
                    growing="true"
                    growingThreshold="20"
                    growingScrollToLoad="true"
                    sticky="ColumnHeaders,HeaderToolbar"
                    ariaLabelledBy="analysesTableTitle"
                    noDataText="{i18n>analysesNoData}"
                >
                    <headerToolbar>
                        <OverflowToolbar id="analysesTableToolbar">
                            <Title
                                id="analysesTableTitle"
                                text="{i18n>analysesListTitle}"
                                level="H2"
                            />
                            <ToolbarSpacer id="analysesTableToolbarSpacer" />
                            <SearchField
                                id="analysesSearchField"
                                width="200px"
                                search="onSearch"
                                tooltip="Search by RICEFW ID, object name, or type"
                                placeholder="{i18n>analysesSearchPlaceholder}"
                            />
                            <Button
                                id="deleteAnalysisButton"
                                text="{i18n>btnDeleteAnalysis}"
                                icon="sap-icon://delete"
                                type="Reject"
                                press="onDeleteAnalysis"
                                tooltip="Delete the selected analysis"
                                enabled="{viewModel>/hasSelection}"
                            />
                            <Button
                                id="newAnalysisButton"
                                text="{i18n>btnNewAnalysis}"
                                icon="sap-icon://add"
                                type="Emphasized"
                                tooltip="Start a new clean core analysis"
                                press="onStartWizard"
                            />
                            <Button
                                id="backToProjectsButton"
                                text="{i18n>btnBackToProjects}"
                                icon="sap-icon://navigation-left-arrow"
                                tooltip="Return to the project list"
                                press="onBackToProjects"
                            />
                        </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                        <Column
                            id="ricefwIdColumn"
                            width="10%"
                        >
                            <Button
                                id="ricefwIdHeader"
                                text="{= ${viewModel>/sortProperty} === 'ricefwId' ? ${i18n>colRicefwId} + ' ' + (${viewModel>/sortDescending} ? '\u2B07' : '\u2B06') : ${i18n>colRicefwId}}"
                                type="Transparent"
                                class="sortableColumnHeader"
                                tooltip="Sort by RICEFW ID"
                                press="onColumnHeaderPress"
                            />
                        </Column>
                        <Column
                            id="objectNameColumn"
                            width="20%"
                        >
                            <Button
                                id="objectNameHeader"
                                text="{= ${viewModel>/sortProperty} === 'objectName' ? ${i18n>objectName} + ' ' + (${viewModel>/sortDescending} ? '\u2B07' : '\u2B06') : ${i18n>objectName}}"
                                type="Transparent"
                                class="sortableColumnHeader"
                                tooltip="Sort by Object Name"
                                press="onColumnHeaderPress"
                            />
                        </Column>
                        <Column
                            id="typeColumn"
                            width="10%"
                            demandPopin="true"
                            minScreenWidth="Tablet"
                        >
                            <Button
                                id="typeHeader"
                                text="{= ${viewModel>/sortProperty} === 'objectType' ? ${i18n>colTypeCol} + ' ' + (${viewModel>/sortDescending} ? '\u2B07' : '\u2B06') : ${i18n>colTypeCol}}"
                                type="Transparent"
                                class="sortableColumnHeader"
                                tooltip="Sort by Object Type"
                                press="onColumnHeaderPress"
                            />
                        </Column>
                        <Column
                            id="cleanCoreLevelColumn"
                            width="12%"
                        >
                            <Button
                                id="cleanCoreLevelHeader"
                                text="{= ${viewModel>/sortProperty} === 'finalRecommendation' ? ${i18n>colLevel} + ' ' + (${viewModel>/sortDescending} ? '\u2B07' : '\u2B06') : ${i18n>colLevel}}"
                                type="Transparent"
                                class="sortableColumnHeader"
                                tooltip="Sort by Clean Core Level"
                                press="onColumnHeaderPress"
                            />
                        </Column>
                        <Column
                            id="techDebtColumn"
                            width="12%"
                            demandPopin="true"
                            minScreenWidth="Desktop"
                        >
                            <Button
                                id="techDebtHeader"
                                text="{= ${viewModel>/sortProperty} === 'technicalDebtScore' ? ${i18n>colTechnicalDebt} + ' ' + (${viewModel>/sortDescending} ? '\u2B07' : '\u2B06') : ${i18n>colTechnicalDebt}}"
                                type="Transparent"
                                class="sortableColumnHeader"
                                press="onColumnHeaderPress"
                            />
                        </Column>
                        <Column
                            id="cloudReadyColumn"
                            width="12%"
                            demandPopin="true"
                            minScreenWidth="Desktop"
                        >
                            <Button
                                id="cloudReadyHeader"
                                text="{= ${viewModel>/sortProperty} === 'cloudReadinessScore' ? ${i18n>colCloudReadiness} + ' ' + (${viewModel>/sortDescending} ? '\u2B07' : '\u2B06') : ${i18n>colCloudReadiness}}"
                                type="Transparent"
                                class="sortableColumnHeader"
                                press="onColumnHeaderPress"
                            />
                        </Column>
                        <Column
                            id="analysesStatusColumn"
                            width="12%"
                        >
                            <Button
                                id="analysesStatusHeader"
                                text="{= ${viewModel>/sortProperty} === 'status' ? ${i18n>colStatus} + ' ' + (${viewModel>/sortDescending} ? '\u2B07' : '\u2B06') : ${i18n>colStatus}}"
                                type="Transparent"
                                class="sortableColumnHeader"
                                press="onColumnHeaderPress"
                            />
                        </Column>
                        <Column
                            id="dateColumn"
                            width="12%"
                            demandPopin="true"
                            minScreenWidth="Tablet"
                        >
                            <Button
                                id="dateHeader"
                                text="{= ${viewModel>/sortProperty} === 'analysisDate' ? ${i18n>colDate} + ' ' + (${viewModel>/sortDescending} ? '\u2B07' : '\u2B06') : ${i18n>colDate}}"
                                type="Transparent"
                                class="sortableColumnHeader"
                                press="onColumnHeaderPress"
                            />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem
                            id="analysesTableItem"
                            type="Active"
                            press="onAnalysisSelect"
                        >
                            <cells>
                                <VBox
                                    id="ricefwIdCell"
                                >
                                    <Text
                                        id="ricefwIdCellText"
                                        text="{ricefwId}"
                                    />
                                    <Text
                                        id="draftStatusText"
                                        text="Draft"
                                        visible="false"
                                        class="sapUiSmallMarginTop sapUiLowerCase"
                                    />
                                    <Text
                                        id="ricefwComplexityText"
                                        text="Complexity: {complexity}"
                                        visible="{= ${complexity} ? true : false}"
                                        class="sapUiSmallMarginTop sapUiTinyText"
                                    />
                                </VBox>
                                <ObjectIdentifier
                                    id="objectNameCell"
                                    title="{objectName}"
                                    text="{objectDescription}"
                                />
                                <Text
                                    id="objectTypeCell"
                                    text="{objectType}"
                                />
                                <ObjectStatus
                                    id="finalRecommendationCell"
                                    text="{finalRecommendation}"
                                    state="{= !${finalRecommendation} ? 'None' : ${finalRecommendation}.indexOf('Level A') &gt; -1 ? 'Success' : ${finalRecommendation}.indexOf('Level B') &gt; -1 ? 'Information' : ${finalRecommendation}.indexOf('Level C') &gt; -1 ? 'Warning' : 'Error'}"
                                />
                                <ProgressIndicator
                                    id="techDebtCell"
                                    percentValue="{technicalDebtScore}"
                                    displayValue="{technicalDebtScore}"
                                    state="{= ${technicalDebtScore} &lt; 30 ? 'Success' : ${technicalDebtScore} &lt; 60 ? 'Warning' : 'Error' }"
                                />
                                <ProgressIndicator
                                    id="cloudReadyCell"
                                    percentValue="{cloudReadinessScore}"
                                    displayValue="{cloudReadinessScore}"
                                    state="{= ${cloudReadinessScore} &gt; 70 ? 'Success' : ${cloudReadinessScore} &gt; 40 ? 'Warning' : 'Error' }"
                                />
                                <ObjectStatus
                                    id="analysesStatusCell"
                                    text="{status}"
                                    state="{= ${status} === 'Completed' ? 'Success' : ${status} === 'In Progress' ? 'Warning' : 'None' }"
                                />
                                <Text
                                    id="analysisDateCell"
                                    text="{path: 'analysisDate', type: 'sd.solutionadvisor.types.FlexibleDateTime', formatOptions: {pattern: 'yyyy-MM-dd'}}"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
    </Page>
</mvc:View>
