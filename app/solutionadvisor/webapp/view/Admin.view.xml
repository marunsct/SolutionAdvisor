<mvc:View
    controllerName="sd.solutionadvisor.controller.Admin"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout"
    displayBlock="true"
>
    <Page
        id="adminLandingPage"
        title="Administration Panel"
        showNavButton="true"
        navButtonPress="onNavBack"
        class="sapUiResponsiveContentPadding"
        busy="{adminModel>/busy}"
        busyIndicatorDelay="0"
    >
        <headerContent>
            <Button
                id="adminRefreshButton"
                icon="sap-icon://refresh"
                tooltip="Refresh table counts and recent changes"
                press="onRefresh"
            />
        </headerContent>

        <content>
            <VBox
                id="adminContentVBox"
                class="sapUiSmallMargin"
            >
                <!-- Page Header -->
                <FlexBox
                    id="adminHeaderFlexBox"
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                    class="sapUiSmallMarginBottom"
                >
                    <VBox id="adminHeaderTextVBox">
                        <Title
                            id="adminMainTitle"
                            text="Table Maintenance"
                            level="H2"
                        />
                        <Text
                            id="adminSubTitle"
                            text="Manage reference data and configuration tables"
                            class="sapUiTinyMarginTop"
                        />
                    </VBox>
                </FlexBox>

                <!-- Info Message -->
                <MessageStrip
                    id="adminInfoMessage"
                    text="This area is restricted to administrators. All changes are logged and audited."
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"
                />
                <MessageStrip
                    id="adminHelpMessage"
                    text="Choose a maintenance tile to open its dedicated editor. Use Recent Changes to verify recent administrative activity."
                    type="Success"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"
                />

                <!-- Admin Tiles -->
                <layout:Grid
                    id="adminTilesGrid"
                    defaultSpan="XL4 L4 M6 S12"
                    hSpacing="1"
                    vSpacing="1"
                    class="sapUiSmallMarginTop"
                    content="{adminModel>/tiles}"
                >
                    <!-- Tiles are generated from model -->
                    <GenericTile
                        id="adminTile"
                        class="sapUiTinyMargin"
                        header="{adminModel>title}"
                        subheader="{adminModel>subtitle}"
                        tooltip="{= ${adminModel>title} + ' - open maintenance screen' }"
                        press="onTilePress"
                        frameType="TwoByOne"
                    >
                        <tileContent>
                            <TileContent
                                id="adminTileContent"
                                footer="{= ${adminModel>recordCount} + ' records' }"
                            >
                                <content>
                                    <ImageContent
                                        id="adminTileImage"
                                        src="{adminModel>icon}"
                                    />
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>
                </layout:Grid>

                <!-- Recent Changes Section -->
                <Panel
                    id="recentChangesPanel"
                    headerText="Recent Changes"
                    expandable="true"
                    expanded="false"
                    class="sapUiSmallMarginTop"
                    expand="onRecentChangesPanelExpand"
                >
                    <content>
                        <Table
                            id="recentChangesTable"
                            noDataText="No recent changes recorded. Audit logging will begin tracking changes once the database is deployed."
                            mode="None"
                            growing="true"
                            growingThreshold="10"
                            growingScrollToLoad="true"
                            items="{
                                path: 'admin>/AuditLog',
                                sorter: {
                                    path: 'timestamp',
                                    descending: true
                                }
                            }"
                            busy="{adminModel>/recentChangesBusy}"
                        >
                            <columns>
                                <Column
                                    id="recentChangesDateColumn"
                                    width="20%"
                                >
                                    <Text
                                        id="recentChangesDateHeader"
                                        text="Date/Time"
                                    />
                                </Column>
                                <Column
                                    id="recentChangesTableColumn"
                                    width="20%"
                                >
                                    <Text
                                        id="recentChangesTableHeader"
                                        text="Table"
                                    />
                                </Column>
                                <Column
                                    id="recentChangesActionColumn"
                                    width="15%"
                                >
                                    <Text
                                        id="recentChangesActionHeader"
                                        text="Action"
                                    />
                                </Column>
                                <Column
                                    id="recentChangesRecordColumn"
                                    width="25%"
                                >
                                    <Text
                                        id="recentChangesRecordHeader"
                                        text="Record ID"
                                    />
                                </Column>
                                <Column
                                    id="recentChangesUserColumn"
                                    width="20%"
                                >
                                    <Text
                                        id="recentChangesUserHeader"
                                        text="User"
                                    />
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem id="recentChangesItemTemplate">
                                    <cells>
                                        <Text
                                            id="recentChangesDateCell"
                                            text="{ path: 'admin>timestamp', formatter: '.formatTimestamp' }"
                                        />
                                        <Text
                                            id="recentChangesTableCell"
                                            text="{admin>entityType}"
                                        />
                                        <ObjectStatus
                                            id="recentChangesActionStatus"
                                            text="{admin>action}"
                                            state="{= ${admin>action} === 'CREATE' ? 'Success' : ${admin>action} === 'DELETE' ? 'Error' : 'Information' }"
                                        />
                                        <Text
                                            id="recentChangesRecordCell"
                                            text="{= ${admin>entityKey} || ${admin>entityId} }"
                                        />
                                        <Text
                                            id="recentChangesUserCell"
                                            text="{= ${admin>userEmail} || ${admin>userId} }"
                                        />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </content>
                </Panel>
            </VBox>
        </content>
    </Page>
</mvc:View>
