{
  "name": "solutionadvisor",
  "version": "0.0.1",
  "description": "SAP Solution Advisor",
  "keywords": [
    "ui5",
    "openui5",
    "sapui5"
  ],
  "main": "webapp/index.html",
  "dependencies": {
    "d3": "^7.9.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.3"
  },
  "devDependencies": {
    "@sap/eslint-plugin-ui5-jsdocs": "2.0.8",
    "@sap/ux-ui5-tooling": "1",
    "@sapui5/ts-types": "~1.141.2",
    "@ui5/cli": "^4.0.30",
    "eslint": "9.38.0",
    "ui5-task-zipper": "^3.4.4"
  },
  "scripts": {
    "build-local": "ui5 build preload --clean-dest",
    "build:cf": "ui5 build preload --clean-dest --config ui5-deploy.yaml --include-task=generateCachebusterInfo",
    "build1": "npx ui5 build --clean-dest --dest dist",
    "deploy-config": "npx -p @sap/ux-ui5-tooling fiori add deploy-config cf",
    "build": "npm run clean && npx ui5 build --clean-dest --dest dist && npm run zip",
    "clean": "npx rimraf solutionadvisor.zip dist",
    "zip": "cd dist && npx bestzip ../../resources/solutionadvisor.zip ."
  }
}